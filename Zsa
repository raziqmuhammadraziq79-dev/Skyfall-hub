local BHConn
local function StartBH()
    if BHConn then pcall(function() BHConn:Disconnect() end) end
    local debounce = false
    BHConn = RunService.Heartbeat:Connect(function()
        if not Cfg.BunnyHop or debounce then return end
        local c = LP.Character; if not c then return end
        local hum = GetHum(c); if not hum then return end
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Running
        or state == Enum.HumanoidStateType.RunningNoPhysics then
            debounce = true
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            task.wait(0.1)
            debounce = false
        end
    end)
end
StartBH()
LP.CharacterAdded:Connect(function() task.wait(1); StartBH() end)

