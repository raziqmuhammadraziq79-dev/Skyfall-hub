local function DestroyESP(p)
    local e = ESPMap[p]; if not e then return end
    for _,v in pairs(e.C) do Kill(v) end
    Kill(e.Name); Kill(e.Label); Kill(e.Dist)
    Kill(e.HBG);  Kill(e.HBar);  Kill(e.Tracer); Kill(e.Arrow)
    ESPMap[p] = nil
end

local function DrawCorner(C,tl,tr,bl,br,col)
    local cw=(tr.X-tl.X)*0.22; local ch=(bl.Y-tl.Y)*0.22
    C[1].From=tl; C[1].To=tl+Vector2.new(cw,0);  C[1].Color=col; C[1].Visible=true
    C[2].From=tl; C[2].To=tl+Vector2.new(0,ch);  C[2].Color=col; C[2].Visible=true
    C[3].From=tr; C[3].To=tr-Vector2.new(cw,0);  C[3].Color=col; C[3].Visible=true
    C[4].From=tr; C[4].To=tr+Vector2.new(0,ch);  C[4].Color=col; C[4].Visible=true
    C[5].From=bl; C[5].To=bl+Vector2.new(cw,0);  C[5].Color=col; C[5].Visible=true
    C[6].From=bl; C[6].To=bl-Vector2.new(0,ch);  C[6].Color=col; C[6].Visible=true
    C[7].From=br; C[7].To=br-Vector2.new(cw,0);  C[7].Color=col; C[7].Visible=true
    C[8].From=br; C[8].To=br-Vector2.new(0,ch);  C[8].Color=col; C[8].Visible=true
end

