    for _,v in pairs(e.C) do v.Visible=false end
    e.Name.Visible=false; e.Label.Visible=false; e.Dist.Visible=false
    e.HBG.Visible=false;  e.HBar.Visible=false
    e.Tracer.Visible=false; e.Arrow.Visible=false
