local AllD = {}
local function D(t, props)
    local d = Drawing.new(t)
    for k,v in pairs(props or {}) do d[k]=v end
    table.insert(AllD, d)
    return d
end
local function Kill(d)
    if not d then return end
    d.Visible = false
    pcall(function() d:Remove() end)
end

