-- AIM ENGINE — 9 FEATURES
-- ════════════════════════════════════════════════════════
local AimTarget   = nil
local LastShot    = 0
local LastFlick   = 0
local SnapPending = false

-- [9] Auto Closest Bone
local function GetBestBone(char)
    if not Cfg.AutoBone then
        return char:FindFirstChild(Cfg.SnapPart) or GetHead(char) or GetRoot(char)
    end
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local best, bestD = nil, math.huge
    for _, boneName in ipairs(Cfg.BoneList) do
        local bone = char:FindFirstChild(boneName)
        if bone then
            local sv, on = W2V(bone.Position)
            if on then
                local d = (sv-center).Magnitude
                if d < bestD then bestD=d; best=bone end
            end
        end
    end
    return best or GetHead(char) or GetRoot(char)
end

-- [5] Prediction
local function PredictPos(char, part)
    if not Cfg.PredictAim then return part.Position end
    local vel  = GetVel(char)
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    local tof  = dist / 1000  -- time of flight estimate
    return part.Position + vel * tof * Cfg.PredictFactor
end

-- Target finder — [7] FOV Priority
local function FindTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestScore = math.huge
    local bestP     = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        -- ── STRICT ENEMY ONLY ──
        if GetRel(p) ~= "enemy" then continue end

        local c   = GetChar(p)
        local hum = GetHum(c)
        if not c or not hum or hum.Health <= 0 then continue end

        local part = GetBestBone(c)
        if not part then continue end

        local sv, on = W2V(part.Position)
        if not on then continue end

        local fovDist = (sv - center).Magnitude
        if fovDist > Cfg.AimFOV then continue end

        -- Score: FOV priority = fovDist, else world distance
        local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
        local score = Cfg.FOVPriority and fovDist or worldDist

        if score < bestScore then
            bestScore = score
            bestP     = p
        end
    end
    return bestP
end

-- [4] Auto Shoot Mobile
local function MobileShoot()
    if not Cfg.AutoShoot or not AimTarget then return end
    local now = tick()
    if now - LastShot < Cfg.ShootDelay then return end
    LastShot = now

    local c = GetChar(AimTarget)
    if not GetHum(c) or GetHum(c).Health <= 0 then return end

    -- VirtualUser Button1Down — paling reliable di Delta mobile
    pcall(function()
        local vp = Camera.ViewportSize
        VirtualUser:Button1Down(Vector2.new(vp.X/2, vp.Y/2), CFrame.new())
        task.delay(0.05, function()
            pcall(function()
                VirtualUser:Button1Up(Vector2.new(vp.X/2, vp.Y/2), CFrame.new())
            end)
        end)
    end)

    -- Fallback: tool activate
    pcall(function()
        local char = LP.Character; if not char then return end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then tool:Activate() end
        end
    end)
end

-- Silent Aim Hook
pcall(function()
    local mt  = getrawmetatable(game)
    local old = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, key)
        if key == "Hit" and self == LP:GetMouse() then
            if Cfg.SilentAim and AimTarget then
                local c    = GetChar(AimTarget)
                local part = c and GetBestBone(c)
                if part then
                    local pos = PredictPos(c, part)
                    return CFrame.new(pos)
                end
            end
        end
        return old(self, key)
    end)
    setreadonly(mt, true)
end)

