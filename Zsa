-- TEAM ENGINE — ROOT LEVEL FIX
-- Pake string comparison nama tim, bukan object reference
-- Ini fix SEMUA kasus termasuk game yang teamnya custom
-- ════════════════════════════════════════════════════════
local function GetTeamName(player)
    -- Priority 1: Team object
    if player.Team then
        return tostring(player.Team.Name)
    end
    -- Priority 2: TeamColor sebagai string key
    if player.TeamColor then
        return tostring(player.TeamColor)
    end
    -- Priority 3: cek via leaderstats atau attribute team
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local t = ls:FindFirstChild("Team") or ls:FindFirstChild("team")
        if t then return tostring(t.Value) end
    end
    -- No team info = treat as enemy
    return "NONE_" .. player.UserId
end

local function IsEnemyOf(player)
    if player == LP then return false end
    local myTeam = GetTeamName(LP)
    local theirTeam = GetTeamName(player)
    -- Kalau dua duanya NONE = enemy (FFA)
    if myTeam:sub(1,5) == "NONE_" and theirTeam:sub(1,5) == "NONE_" then
        return true
    end
    return myTeam ~= theirTeam
end

local function IsTeammateOf(player)
    if player == LP then return false end
    local myTeam = GetTeamName(LP)
    local theirTeam = GetTeamName(player)
    if myTeam:sub(1,5) == "NONE_" then return false end
    return myTeam == theirTeam
end

local function IsFriendOf(player)
    local ok, res = pcall(function()
        return LP:IsFriendsWith(player.UserId)
    end)
    return ok and res or false
end

-- Relation: returns "enemy" | "team" | "friend"
local RelCache = {}
local function GetRel(player)
    if RelCache[player] then return RelCache[player] end
    local r
    if IsTeammateOf(player) then
        r = "team"
    elseif IsFriendOf(player) then
        r = "friend"
    else
        r = "enemy"
    end
    RelCache[player] = r
    return r
end

-- Refresh cache tiap 2 detik
task.spawn(function()
    while true do
        task.wait(2)
        RelCache = {}
    end
end)

Players.PlayerRemoving:Connect(function(p)
    RelCache[p] = nil
end)

