-- MAIN LOOP
-- ════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    -- Crosshair
    CrossH.From=Vector2.new(center.X-12,center.Y); CrossH.To=Vector2.new(center.X+12,center.Y); CrossH.Visible=Cfg.ShowCrosshair
    CrossV.From=Vector2.new(center.X,center.Y-12); CrossV.To=Vector2.new(center.X,center.Y+12); CrossV.Visible=Cfg.ShowCrosshair
    FOVC.Position=center; FOVC.Radius=Cfg.AimFOV; FOVC.Visible=Cfg.ShowFOV

    -- ── AIM ENGINE ──
    AimTarget = FindTarget()

    if AimTarget then
        local c    = GetChar(AimTarget)
        local part = c and GetBestBone(c)

        if part then
            local aimPos = PredictPos(c, part)  -- [5] Prediction
            local targetCF = CFrame.new(Camera.CFrame.Position, aimPos)

            -- [1] Smooth Aim Assist
            if Cfg.AimAssist then
                Camera.CFrame = Camera.CFrame:Lerp(targetCF, Cfg.AssistSmooth)
            end

            -- [2] Snap Aim (hard lock)
            if Cfg.SnapAim then
                if Cfg.HeadSnapDelay then
                    -- [8] Head Snap Delay (anti-cheat evade)
                    if not SnapPending then
                        SnapPending = true
                        task.delay(Cfg.HeadSnapMs, function()
                            Camera.CFrame = targetCF
                            SnapPending = false
                        end)
                    end
                else
                    Camera.CFrame = targetCF
                end
            end

            -- [6] Auto Flick
            if Cfg.AutoFlick then
                local now = tick()
                if now - LastFlick > Cfg.FlickCooldown then
                    local sv, on = W2V(part.Position)
                    if on then
                        local dist = (sv - center).Magnitude
                        if dist < Cfg.AimFOV * 0.5 then  -- dalam setengah FOV = flick
                            LastFlick = now
                            -- Instant flick ke target lalu smooth balik
                            local flickCF = CFrame.new(Camera.CFrame.Position, aimPos)
                            Camera.CFrame = Camera.CFrame:Lerp(flickCF, Cfg.FlickSmooth)
                        end
                    end
                end
            end

            MobileShoot()
        end
    end

    -- ── ESP LOOP ──
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        local e = ESPMap[player]; if not e then continue end

        -- ── RELASI KETAT ──
        local rel = GetRel(player)  -- "enemy" | "team" | "friend"

        -- ── FILTER KETAT SEBELUM APAPUN ──
        local doESP = Cfg.ESP and (
            (rel=="enemy"  and Cfg.ESP_Enemy)  or
            (rel=="team"   and Cfg.ESP_Team)   or
            (rel=="friend" and Cfg.ESP_Friend)
        )
        local doTrace = Cfg.Tracer and (
            (rel=="enemy"  and Cfg.Tracer_Enemy)  or
            (rel=="team"   and Cfg.Tracer_Team)   or
            (rel=="friend" and Cfg.Tracer_Friend)
        )

        -- Kalau dua duanya false — hide semuanya, skip
        if not doESP and not doTrace then
            HideAll(player); continue
        end

        local c    = GetChar(player)
        local hum  = GetHum(c)
        local root = GetRoot(c)

        if not c or not hum or hum.Health<=0 or not root then
            HideAll(player); continue
        end

        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > Cfg.MaxDist then HideAll(player); continue end

        local rootSV, onScreen = W2V(root.Position)

        -- Colors
        local col    = rel=="enemy" and Cfg.Col_E  or rel=="team" and Cfg.Col_T  or Cfg.Col_F
        local trcCol = rel=="enemy" and Cfg.Col_TrE or rel=="team" and Cfg.Col_TrT or Cfg.Col_TrF
        local lblCol = rel=="enemy" and Cfg.Col_LbE or rel=="team" and Cfg.Col_LbT or Cfg.Col_LbF
        local lblTxt = rel=="enemy" and "▲ MUSUH" or rel=="team" and "● TEMAN" or "◆ FRIEND"

        -- Off-screen arrow
        if not onScreen and doESP and Cfg.ShowArrow then
            local dir  = (rootSV - center)
            if dir.Magnitude > 0 then
                dir = dir.Unit
                local edge = center + dir * (math.min(center.X, center.Y) * 0.82)
                e.Arrow.PointA = edge + dir * 10
                e.Arrow.PointB = edge + Vector2.new(-dir.Y, dir.X) * 8
                e.Arrow.PointC = edge - Vector2.new(-dir.Y, dir.X) * 8
                e.Arrow.Color  = col
                e.Arrow.Visible= true
            end
        else
            e.Arrow.Visible = false
        end

        if not onScreen then
            for _,v in pairs(e.C) do v.Visible=false end
            e.Name.Visible=false; e.Label.Visible=false; e.Dist.Visible=false
            e.HBG.Visible=false;  e.HBar.Visible=false;  e.Tracer.Visible=false
            continue
        end

        -- Box
        if doESP and Cfg.ShowBox then
            local tl, br = BBox2D(c)
            if tl and br then
                local tr2 = Vector2.new(br.X,tl.Y)
                local bl2 = Vector2.new(tl.X,br.Y)
                DrawCorner(e.C, tl, tr2, bl2, br, col)

                -- Health bar
                if Cfg.ShowHealth then
                    local pct = math.clamp(hum.Health/hum.MaxHealth,0,1)
                    local bH  = br.Y-tl.Y
                    local bx  = tl.X-7
                    e.HBG.From=Vector2.new(bx,tl.Y); e.HBG.To=Vector2.new(bx,br.Y); e.HBG.Visible=true
                    e.HBar.Color=LerpC(Cfg.Col_HLo,Cfg.Col_HHi,pct)
                    e.HBar.From=Vector2.new(bx,br.Y); e.HBar.To=Vector2.new(bx,br.Y-bH*pct); e.HBar.Visible=true
                else
                    e.HBG.Visible=false; e.HBar.Visible=false
                end

                local mx = (tl.X+br.X)/2

                -- Label MUSUH/TEMAN
                if Cfg.ShowLabel then
                    e.Label.Text=lblTxt; e.Label.Position=Vector2.new(mx,tl.Y-27)
                    e.Label.Color=lblCol; e.Label.Visible=true
                else e.Label.Visible=false end

                -- Name
                if Cfg.ShowName then
                    e.Name.Text=player.DisplayName; e.Name.Position=Vector2.new(mx,tl.Y-15)
                    e.Name.Color=Cfg.Col_Nam; e.Name.Visible=true
                else e.Name.Visible=false end

                -- Distance
                if Cfg.ShowDist then
                    e.Dist.Text=string.format("[%dm]",math.floor(dist))
                    e.Dist.Position=Vector2.new(mx,br.Y+3); e.Dist.Color=Cfg.Col_Dst; e.Dist.Visible=true
                else e.Dist.Visible=false end
            end
        else
