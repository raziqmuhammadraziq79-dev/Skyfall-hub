-- // UTILS

local function getTeam(plr)
    return plr.Team
end

local function isEnemy(plr)
    if Config.Aimbot.TeamCheck then
        return plr.Team ~= LocalPlayer.Team
    end
    return true
end

local function getCharacter(plr)
    return plr.Character
end

local function getPart(plr, part)
    local char = getCharacter(plr)
    if char then
        return char:FindFirstChild(part)
    end
end

local function getRoot(plr)
    local char = getCharacter(plr)
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
end

local function isAlive(plr)
    local char = getCharacter(plr)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function worldToViewport(pos)
    local vp, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(vp.X, vp.Y), onScreen, vp.Z
end

local function getCenter()
    return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end

local function inFOV(screenPos)
    local center = getCenter()
    return (screenPos - center).Magnitude <= Config.Aimbot.FOV
end

-- // FIND CLOSEST ENEMY
local function findTarget()
    local closest = nil
    local closestDist = math.huge
    local center = getCenter()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isEnemy(plr) and isAlive(plr) then
            local part = getPart(plr, Config.Aimbot.Part)
            if part then
                local screenPos, onScreen = worldToViewport(part.Position)
                if onScreen then
                    local dist = (screenPos - center).Magnitude
                    if dist < closestDist and inFOV(screenPos) then
                        closestDist = dist
                        closest = plr
                    end
                end
            end
        end
    end

    return closest
end

-- // SILENT AIM
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if Config.Aimbot.Enabled and Config.Aimbot.Silent then
        if method == "FireServer" or method == "InvokeServer" then
            local target = findTarget()
            if target then
                local part = getPart(target, Config.Aimbot.Part)
                if part then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Instance" and v:IsA("BasePart") then
                            args[i] = part
                        end
                        if typeof(v) == "Vector3" then
                            args[i] = part.Position
                        end
                    end
                end
            end
        end
    end

    return oldNamecall(self, table.unpack(args))
end)

-- // AIMBOT LOOP (FOV + SMOOTH)
RunService.RenderStepped:Connect(function()
    if not Config.Aimbot.Enabled then return end

    local target = findTarget()
    if not target then return end

    local part = getPart(target, Config.Aimbot.Part)
    if not part then return end

    if Config.Aimbot.Silent then return end -- silent handles its own

    local targetPos = Camera:WorldToScreenPoint(part.Position)
    local screenTarget = Vector2.new(targetPos.X, targetPos.Y)
    local center = getCenter()

    if not inFOV(screenTarget) then return end

    local currentPos = center
    local smoothed = currentPos:Lerp(screenTarget, Config.Aimbot.Smooth)

    -- mousemoverel for delta
    local delta = smoothed - center
    mousemoverel(delta.X, delta.Y)
end)

-- // TP TO PLAYER
local function tpToPlayer(username)
    local target = Players:FindFirstChild(username)
    if not target then
        warn("[ONYX] Player not found: " .. username)
        return
    end
    local root = getRoot(target)
    local localRoot = getRoot(LocalPlayer)
    if root and localRoot then
        localRoot.CFrame = root.CFrame + Vector3.new(0, 3, 0)
    end
end

