-- ═══════════════════════════════════════
-- MAIN RENDER LOOP
-- ═══════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    -- Crosshair
    if Cfg.ShowCrosshair then
        CrossH.From    = Vector2.new(center.X-10, center.Y)
        CrossH.To      = Vector2.new(center.X+10, center.Y)
        CrossH.Visible = true
        CrossV.From    = Vector2.new(center.X, center.Y-10)
        CrossV.To      = Vector2.new(center.X, center.Y+10)
        CrossV.Visible = true
    else
        CrossH.Visible = false
        CrossV.Visible = false
    end

    -- FOV Circle
    if Cfg.ShowFOVCircle then
        FOVCircle.Position = center
        FOVCircle.Radius   = Cfg.AimFOV
        FOVCircle.Visible  = true
    else
        FOVCircle.Visible = false
    end

    -- ── AIMBOT TARGET UPDATE ──
    if Cfg.Aimbot then
        AimTarget = GetTarget()
        if AimTarget then
            local c    = GetChar(AimTarget)
            local part = c and (c:FindFirstChild(Cfg.AimPart) or GetRoot(c))
            if part then
                local targetCF = CFrame.new(Camera.CFrame.Position, part.Position)
                if Cfg.AimAssist then
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, Cfg.AssistStrength)
                elseif Cfg.AutoLock then
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, Cfg.AimSmooth)
                end
                TryAutoShoot()
            end
        end
    end

    -- ── ESP LOOP ──
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        local e = ESPMap[player]
        if not e then continue end

        local enemy  = IsEnemy(player)
        local team   = IsTeammate(player)
        local friend = IsFriend(player)

        -- ── STRICT VISIBILITY CHECK ──
        local shouldESP = (Cfg.ESP_Enemy  and enemy)
                       or (Cfg.ESP_Team   and team)
                       or (Cfg.ESP_Friend and friend)

        local shouldTrace = (Cfg.Tracer_Enemy  and enemy)
                         or (Cfg.Tracer_Team   and team)
                         or (Cfg.Tracer_Friend and friend)

        if not Cfg.ESP then shouldESP = false end
        if not Cfg.Tracer then shouldTrace = false end

        local c    = GetChar(player)
        local hum  = GetHum(c)
        local root = GetRoot(c)

        if not c or not hum or hum.Health <= 0 or not root then
            HideESP(player)
            continue
        end

        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > Cfg.MaxDist then
            HideESP(player)
            continue
        end

        local rootSV, onScreen = W2V(root.Position)

        -- color
        local col = enemy and Cfg.Col_Enemy or (team and Cfg.Col_Team or Cfg.Col_Friend)
        local trCol = enemy and Cfg.Col_TracerE or (team and Cfg.Col_TracerT or Cfg.Col_TracerF)

        -- ── OFF-SCREEN ARROW ──
        if not onScreen and shouldESP then
            local dir = (rootSV - center).Unit
            local edge = center + dir * math.min(center.X, center.Y) * 0.85
            e.Arrow.PointA = edge + dir * 10
            e.Arrow.PointB = edge + Vector2.new(-dir.Y, dir.X) * 7
            e.Arrow.PointC = edge - Vector2.new(-dir.Y, dir.X) * 7
            e.Arrow.Color  = col
            e.Arrow.Visible = true
        else
            e.Arrow.Visible = false
        end

        if not onScreen then
            -- hide box/name but keep arrow
            for _, v in pairs(e.C) do v.Visible = false end
            e.Name.Visible = false; e.Dist.Visible = false
            e.HBG.Visible  = false; e.HBar.Visible  = false
            e.Tracer.Visible = false
            continue
        end

        -- ── BOX ──
        if shouldESP and Cfg.ShowBox then
            local tl, br = BoundingBox2D(c)
            if tl and br then
                local tr = Vector2.new(br.X, tl.Y)
                local bl = Vector2.new(tl.X, br.Y)
                DrawCorner(e.C, tl, tr, bl, br, col)

                -- health bar (left side)
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local barH = br.Y - tl.Y
                local bx   = tl.X - 7
                e.HBG.From = Vector2.new(bx, tl.Y); e.HBG.To = Vector2.new(bx, br.Y); e.HBG.Visible = Cfg.ShowHealth
                local hcol = LerpColor(Cfg.Col_Health_Lo, Cfg.Col_Health_Hi, pct)
                e.HBar.From  = Vector2.new(bx, br.Y)
                e.HBar.To    = Vector2.new(bx, br.Y - barH * pct)
                e.HBar.Color = hcol
                e.HBar.Visible = Cfg.ShowHealth

                -- name
                if Cfg.ShowName then
                    e.Name.Text     = player.DisplayName
                    e.Name.Position = Vector2.new((tl.X+br.X)/2, tl.Y - 17)
                    e.Name.Color    = Cfg.Col_Name
                    e.Name.Visible  = true
                else e.Name.Visible = false end

                -- distance
                if Cfg.ShowDist then
                    e.Dist.Text     = string.format("[%dm]", math.floor(dist))
                    e.Dist.Position = Vector2.new((tl.X+br.X)/2, br.Y + 3)
                    e.Dist.Color    = Cfg.Col_Dist
                    e.Dist.Visible  = true
                else e.Dist.Visible = false end
            end
        else
            for _, v in pairs(e.C) do v.Visible = false end
            e.Name.Visible = false; e.Dist.Visible = false
            e.HBG.Visible  = false; e.HBar.Visible  = false
        end

        -- ── TRACER ──
        if shouldTrace then
            local originY = Cfg.TracerOrigin == "Bottom" and vp.Y
                         or Cfg.TracerOrigin == "Top"    and 0
                         or vp.Y / 2
            e.Tracer.From    = Vector2.new(center.X, originY)
            e.Tracer.To      = rootSV
            e.Tracer.Color   = trCol
            e.Tracer.Visible = true
        else
            e.Tracer.Visible = false
        end
    end
end)

