-- AUTO SHOOT
-- ═══════════════════════════════════════
local function TryAutoShoot()
    if not Cfg.AutoShoot or not AimTarget then return end
    local now = tick()
    if now - LastShot < Cfg.AutoShootDelay then return end
    LastShot = now

    local c   = GetChar(AimTarget)
    local hum = GetHum(c)
    if not c or not hum or hum.Health <= 0 then return end

    -- fire via mouse1 simulation (works on most delta executors)
    pcall(function()
        local mouse = LP:GetMouse()
        mouse1press()
        task.delay(0.05, mouse1release)
    end)
end

