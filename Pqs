local ESPMap = {}

local function MakeESP(player)
    ESPMap[player] = {
        -- corner box: 8 lines (4 corners × 2 lines each)
        C = {},
        Name   = D("Text",  {Size=13, Font=2, Center=true, Outline=true, ZIndex=6, Visible=false}),
        Dist   = D("Text",  {Size=11, Font=2, Center=true, Outline=true, ZIndex=6, Visible=false}),
        HBG    = D("Line",  {Thickness=5, Color=Color3.new(0,0,0), ZIndex=5, Visible=false}),
        HBar   = D("Line",  {Thickness=5, ZIndex=6, Visible=false}),
        Tracer = D("Line",  {Thickness=1.3, ZIndex=5, Visible=false}),
        Arrow  = D("Triangle", {Filled=true, ZIndex=6, Visible=false}), -- off-screen indicator
    }
    for i = 1, 8 do
        ESPMap[player].C[i] = D("Line", {Thickness=1.8, ZIndex=6, Visible=false})
    end
end

local function DestroyESP(player)
    local e = ESPMap[player]
    if not e then return end
    for _, v in pairs(e.C) do Kill(v) end
    Kill(e.Name); Kill(e.Dist); Kill(e.HBG); Kill(e.HBar); Kill(e.Tracer); Kill(e.Arrow)
    ESPMap[player] = nil
end

local function HideESP(player)
    local e = ESPMap[player]
    if not e then return end
    for _, v in pairs(e.C) do v.Visible = false end
    e.Name.Visible   = false
    e.Dist.Visible   = false
    e.HBG.Visible    = false
    e.HBar.Visible   = false
    e.Tracer.Visible = false
    e.Arrow.Visible  = false
end

-- ═══════════════════════════════════════
-- CORNER BOX DRAW
-- ═══════════════════════════════════════
local function DrawCorner(C, tl, tr, bl, br, col)
    local cw = (tr.X - tl.X) * 0.22
    local ch = (bl.Y - tl.Y) * 0.22
    -- top-left
    C[1].From=tl;           C[1].To=tl+Vector2.new(cw,0);  C[1].Color=col; C[1].Visible=true
    C[2].From=tl;           C[2].To=tl+Vector2.new(0,ch);  C[2].Color=col; C[2].Visible=true
    -- top-right
    C[3].From=tr;           C[3].To=tr-Vector2.new(cw,0);  C[3].Color=col; C[3].Visible=true
    C[4].From=tr;           C[4].To=tr+Vector2.new(0,ch);  C[4].Color=col; C[4].Visible=true
    -- bot-left
    C[5].From=bl;           C[5].To=bl+Vector2.new(cw,0);  C[5].Color=col; C[5].Visible=true
    C[6].From=bl;           C[6].To=bl-Vector2.new(0,ch);  C[6].Color=col; C[6].Visible=true
    -- bot-right
    C[7].From=br;           C[7].To=br-Vector2.new(cw,0);  C[7].Color=col; C[7].Visible=true
    C[8].From=br;           C[8].To=br-Vector2.new(0,ch);  C[8].Color=col; C[8].Visible=true
end

-- ═══════════════════════════════════════
-- AIMBOT CORE
-- ═══════════════════════════════════════
local AimTarget = nil
local LastShot  = 0

local function GetTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestD  = Cfg.AimFOV
    local bestP  = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and IsEnemy(p) then
            local c = GetChar(p)
            local h = GetHum(c)
            if c and h and h.Health > 0 then
                local part = c:FindFirstChild(Cfg.AimPart) or GetRoot(c)
                if part then
                    local sv, on = W2V(part.Position)
                    if on then
                        local d = (sv - center).Magnitude
                        if d < bestD then
                            bestD = d
                            bestP = p
                        end
                    end
                end
            end
        end
    end
    return bestP
end

