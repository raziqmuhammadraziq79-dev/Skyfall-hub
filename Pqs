-- ═══════════════════════════════════════
-- UTILS
-- ═══════════════════════════════════════
local function W2V(pos)
    local v, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on, v.Z
end

local function IsEnemy(p)
    if p == LP then return false end
    if LP.Team and p.Team then
        return p.Team ~= LP.Team
    end
    return true
end

local function IsTeammate(p)
    if p == LP then return false end
    if LP.Team and p.Team then
        return p.Team == LP.Team
    end
    return false
end

local function IsFriend(p)
    local ok, res = pcall(function() return LP:IsFriendsWith(p.UserId) end)
    return ok and res or false
end

local function GetChar(p)   return p.Character end
local function GetRoot(c)   return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHead(c)   return c and c:FindFirstChild("Head") end
local function GetHum(c)    return c and c:FindFirstChildOfClass("Humanoid") end

local function LerpColor(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

local function BoundingBox2D(char)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyOn = false
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            local s = p.Size * 0.5
            local cf = p.CFrame
            local offsets = {
                Vector3.new( s.X,  s.Y,  s.Z), Vector3.new(-s.X,  s.Y,  s.Z),
                Vector3.new( s.X, -s.Y,  s.Z), Vector3.new(-s.X, -s.Y,  s.Z),
                Vector3.new( s.X,  s.Y, -s.Z), Vector3.new(-s.X,  s.Y, -s.Z),
                Vector3.new( s.X, -s.Y, -s.Z), Vector3.new(-s.X, -s.Y, -s.Z),
            }
            for _, o in ipairs(offsets) do
                local sv, on = W2V(cf:PointToWorldSpace(o))
                if on then
                    anyOn = true
                    minX = math.min(minX, sv.X)
                    minY = math.min(minY, sv.Y)
                    maxX = math.max(maxX, sv.X)
                    maxY = math.max(maxY, sv.Y)
                end
            end
        end
    end
    if not anyOn then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX, maxY)
end

