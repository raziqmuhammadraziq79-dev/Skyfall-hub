-- DRAWING FACTORY
-- ═══════════════════════════════════════
local Pool = {}

local function D(type, props)
    local d = Drawing.new(type)
    for k,v in pairs(props or {}) do d[k]=v end
    table.insert(Pool, d)
    return d
end

local function Kill(d)
    if not d then return end
    d.Visible = false
    pcall(function() d:Remove() end)
end

