-- ========================================================
-- STEP 4: LIVE VALUE WATCHER (real-time ammo pin)
-- ========================================================
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end

    -- Pin all IntValue / NumberValue named ammo in character
    for _, v in ipairs(char:GetDescendants()) do
        local name = v.Name:lower()
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            if name:find("ammo") or name:find("clip") or name:find("mag") or name:find("bullet") or name:find("reserve") then
                v.Value = 9999
            end
            if name:find("reload") or name:find("cooldown") or name:find("delay") then
                v.Value = 0
            end
        end
    end

    -- Pin backpack tools
    for _, tool in ipairs(LP.Backpack:GetChildren()) do
        for _, v in ipairs(tool:GetDescendants()) do
            local name = v.Name:lower()
            if (v:IsA("NumberValue") or v:IsA("IntValue")) then
                if name:find("ammo") or name:find("clip") or name:find("mag") or name:find("bullet") then
                    v.Value = 9999
                end
                if name:find("reload") or name:find("cooldown") then
                    v.Value = 0
                end
            end
        end
    end
end)

-- ========================================================
-- STEP 5: EXECUTE ALL PATHS
-- ========================================================
local paths = {
    "Shared.WeaponSystem.WeaponData",
    "WeaponData",
    "WeaponSystem",
    "Shared.WeaponData",
    "Modules.WeaponData",
    "Data.WeaponData",
}

local vehiclePaths = {
    "Shared.VehicleSystem.VehicleData",
    "VehicleData",
    "VehicleSystem",
    "Shared.VehicleData",
}

local totalWeapons = 0
local totalVehicles = 0

-- Weapon scan
for _, path in ipairs(paths) do
    local ok, folder = pcall(function()
        local parts = path:split(".")
        local current = RS
        for _, p in ipairs(parts) do
            current = current:WaitForChild(p, 2)
        end
        return current
    end)
    if ok and folder then
        totalWeapons = totalWeapons + OverrideWeaponModules(folder)
        break
    end
end

-- Vehicle scan
for _, path in ipairs(vehiclePaths) do
    local ok, folder = pcall(function()
        local parts = path:split(".")
        local current = RS
        for _, p in ipairs(parts) do
            current = current:WaitForChild(p, 2)
        end
        return current
    end)
    if ok and folder then
        totalVehicles = totalVehicles + OverrideVehicleData(folder)
        break
    end
end

-- Brute force full RS scan if paths fail
if totalWeapons == 0 then
    warn("Path tidak ketemu, brute force scan...")
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local ok, data = pcall(require, obj)
            if ok and type(data) == "table" then
                if data.MagSize ~= nil or data.Ammo ~= nil or data.RateOfFire ~= nil then
                    if data.MagSize ~= nil then data.MagSize = math.huge end
                    if data.Ammo ~= nil then data.Ammo = math.huge end
                    if data.MaxAmmo ~= nil then data.MaxAmmo = math.huge end
                    if data.ReloadTime ~= nil then data.ReloadTime = 0 end
                    if data.RateOfFire ~= nil then data.RateOfFire = 6000 end
                    if data.Damage ~= nil then data.Damage = 9999 end
                    if data.Spread ~= nil then data.Spread = 0 end
                    if data.KickForce ~= nil then data.KickForce = 0 end
                    totalWeapons = totalWeapons + 1
                end
            end
        end
    end
end

print("✅ Weapons overridden: " .. tostring(totalWeapons))
print("✅ Vehicles overridden: " .. tostring(totalVehicles))
