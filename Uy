local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LP = Players.LocalPlayer

-- ========================================================
-- STEP 1: PATH SCANNER — find real WeaponData location
-- ========================================================
local function ScanForFolder(root, targetName)
    for _, v in ipairs(root:GetDescendants()) do
        if v.Name == targetName and (v:IsA("Folder") or v:IsA("ModuleScript")) then
            return v
        end
    end
    return nil
end

-- ========================================================
-- STEP 2: WEAPON MODULE OVERRIDE
-- ========================================================
local function OverrideWeaponModules(folder)
    local count = 0
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local ok, data = pcall(require, obj)
            if ok and type(data) == "table" then

                -- Core damage + ammo
                if data.Damage ~= nil then data.Damage = 9999 end
                if data.MagSize ~= nil then data.MagSize = math.huge end
                if data.Ammo ~= nil then data.Ammo = math.huge end
                if data.MaxAmmo ~= nil then data.MaxAmmo = math.huge end
                if data.StoredAmmo ~= nil then data.StoredAmmo = math.huge end
                if data.ReserveAmmo ~= nil then data.ReserveAmmo = math.huge end
                if data.CurrentAmmo ~= nil then data.CurrentAmmo = math.huge end
                if data.TotalAmmo ~= nil then data.TotalAmmo = math.huge end
                if data.ClipAmmo ~= nil then data.ClipAmmo = math.huge end
                if data.BulletCount ~= nil then data.BulletCount = math.huge end

                -- Fire rate + reload
                if data.RateOfFire ~= nil then data.RateOfFire = 6000 end
                if data.FireRate ~= nil then data.FireRate = 0.001 end
                if data.ReloadTime ~= nil then data.ReloadTime = 0 end
                if data.ReloadDuration ~= nil then data.ReloadDuration = 0 end
                if data.DelayBetweenShots ~= nil then data.DelayBetweenShots = 0 end
                if data.CooldownTime ~= nil then data.CooldownTime = 0 end
                if data.ShootDelay ~= nil then data.ShootDelay = 0 end

                -- No recoil / no spread
                if data.Spread ~= nil then data.Spread = 0 end
                if data.MaxSpread ~= nil then data.MaxSpread = 0 end
                if data.MinSpread ~= nil then data.MinSpread = 0 end
                if data.BloomPerShot ~= nil then data.BloomPerShot = 0 end
                if data.MaxBloom ~= nil then data.MaxBloom = 0 end
                if data.KickForce ~= nil then data.KickForce = 0 end
                if data.ClimbPerShot ~= nil then data.ClimbPerShot = 0 end
                if data.MaxClimb ~= nil then data.MaxClimb = 0 end
                if data.ShakeMagnitude ~= nil then data.ShakeMagnitude = 0 end
                if data.ShakeRoughness ~= nil then data.ShakeRoughness = 0 end
                if data.Recoil ~= nil then data.Recoil = 0 end
                if data.RecoilX ~= nil then data.RecoilX = 0 end
                if data.RecoilY ~= nil then data.RecoilY = 0 end

                -- Range + bullet speed
                if data.Range ~= nil then data.Range = math.huge end
                if data.BulletSpeed ~= nil then data.BulletSpeed = 9999 end
                if data.Velocity ~= nil then data.Velocity = 9999 end
                if data.MaxDistance ~= nil then data.MaxDistance = math.huge end

                count = count + 1
            end
        end
    end
    return count
end

-- ========================================================
-- STEP 3: VEHICLE / HELICOPTER AMMO OVERRIDE
-- ========================================================
local function OverrideVehicleData(folder)
    local count = 0
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local ok, data = pcall(require, obj)
            if ok and type(data) == "table" then
                if data.Ammo ~= nil then data.Ammo = math.huge end
                if data.MaxAmmo ~= nil then data.MaxAmmo = math.huge end
                if data.MagSize ~= nil then data.MagSize = math.huge end
                if data.RocketAmmo ~= nil then data.RocketAmmo = math.huge end
                if data.MissileAmmo ~= nil then data.MissileAmmo = math.huge end
                if data.GunAmmo ~= nil then data.GunAmmo = math.huge end
                if data.CannonAmmo ~= nil then data.CannonAmmo = math.huge end
                if data.FireRate ~= nil then data.FireRate = 0.001 end
                if data.ReloadTime ~= nil then data.ReloadTime = 0 end
                if data.Damage ~= nil then data.Damage = 9999 end
