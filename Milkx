-- WEAPON MODS
-- ============================================
local function ApplyWeaponMods()
    local c = GetChar(LocalPlayer)
    if not c then return end
    for _, t in ipairs(c:GetChildren()) do
        if not t:IsA("Tool") then continue end
        -- Reload
        if C.Reload.On then
            for _, s in ipairs({"ReloadTime", "Rechargetime", "ReloadSpeed", "ReloadTimeSec"}) do
                S(function()
                    local v = t:FindFirstChild(s)
                    if v and v:IsA("NumberValue") then v.Value = v.Value * C.Reload.Mult end
                end)
            end
        end
        -- Recoil
        if C.Recoil.On then
            for _, s in ipairs({"Recoil", "MaxRecoil", "RecoilControl", "CameraRecoil"}) do
                S(function()
                    local v = t:FindFirstChild(s)
                    if v and v:IsA("NumberValue") then v.Value = 0 end
                end)
            end
        end
        -- Spread
        if C.Spread.On then
            for _, s in ipairs({"Spread", "MaxSpread", "MinSpread", "Accuracy", "BulletSpread"}) do
                S(function()
                    local v = t:FindFirstChild(s)
                    if v and v:IsA("NumberValue") then v.Value = 0 end
                end)
            end
        end
        -- Rapid
        if C.Rapid.On then
            for _, s in ipairs({"FireRate", "RateOfFire", "AutoFireRate", "ShootDelay"}) do
                S(function()
                    local v = t:FindFirstChild(s)
                    if v and v:IsA("NumberValue") then v.Value = C.Rapid.Delay end
                end)
            end
        end
    end
end

