local function UpdateESP()
    for Plr, d in pairs(ESPD) do
        if not Plr.Parent then
            S(function()
                for _, v in pairs(d) do
                    if type(v) == "userdata" then v:Remove() end
                end
            end)
            ESPD[Plr] = nil
            continue
        end

        local c = GetChar(Plr)
        if not c or IsDead(Plr) or not C.ESP.On then
            for _, v in pairs(d) do
                if type(v) == "userdata" and v.Visible then
                    v.Visible = false
                end
            end
            continue
        end

        local hd = GetHead(c)
        local rt = GetRoot(c)
        local hu = GetHum(c)
        if not hd or not rt or not hu then continue end

        local hp, hs = W2S(hd.Position)
        local rp, rs = W2S(rt.Position)
        if not hs and not rs then
            for _, v in pairs(d) do
                if type(v) == "userdata" then v.Visible = false end
            end
            continue
        end

        local dist = Dist3D(rt.Position)
        if dist > C.ESP.MaxDist then
            for _, v in pairs(d) do
                if type(v) == "userdata" then v.Visible = false end
            end
            continue
        end

        local sc = math.clamp(1 / (dist * 0.001), 0.2, 3)
        local bh = 300 * sc
        local bw = 180 * sc
        local cl = bh * 0.22
        local cx = rp.X
        local ty = hp.Y - bh * 0.35
        local by = rp.Y + bh * 0.15
        local lx = cx - bw / 2
        local rx = cx + bw / 2
        local TL = Vector2.new(lx, ty)
        local TR = Vector2.new(rx, ty)
        local BL = Vector2.new(lx, by)
        local BR = Vector2.new(rx, by)

        -- Corner Box
        if C.ESP.Box then
            d[1].Visible = true
            d[1].From = TL
            d[1].To = TL + Vector2.new(cl, 0)
            d[2].Visible = true
            d[2].From = TL
            d[2].To = TL + Vector2.new(0, cl)
            d[3].Visible = true
            d[3].From = TR
            d[3].To = TR - Vector2.new(cl, 0)
            d[4].Visible = true
            d[4].From = TR
            d[4].To = TR + Vector2.new(0, cl)
            d[5].Visible = true
            d[5].From = BL
            d[5].To = BL + Vector2.new(cl, 0)
            d[6].Visible = true
            d[6].From = BL
            d[6].To = BL - Vector2.new(0, cl)
            d[7].Visible = true
            d[7].From = BR
            d[7].To = BR - Vector2.new(cl, 0)
            d[8].Visible = true
            d[8].From = BR
            d[8].To = BR - Vector2.new(0, cl)
        else
            for i = 1, 8 do
                if d[i] then d[i].Visible = false end
            end
        end

        -- Head Dot
        if C.ESP.HeadDot and d.HDot then
            d.HDot.Visible = hs
            if hs then
                d.HDot.Position = hp
                d.HDot.Radius = math.clamp(30 / (dist * 0.01), 3, 7)
            end
        end

        -- Name
        if C.ESP.Name and d.Name then
            d.Name.Visible = true
            d.Name.Text = Plr.Name
            d.Name.Position = Vector2.new(cx, ty - 18)
        end

        -- Distance
        if C.ESP.Dist and d.Dist then
            d.Dist.Visible = true
            d.Dist.Text = math.floor(dist) .. "m"
            d.Dist.Position = Vector2.new(cx, by + 12)
        end

        -- Health Bar
        if C.ESP.HP and d.HBg and d.HBar then
            local hpct = math.clamp(hu.Health / hu.MaxHealth, 0, 1)
            local bx = lx - 10
            local bw2 = 3
            local bht = by - ty
            d.HBg.Visible = true
            d.HBg.Position = Vector2.new(bx, ty)
            d.HBg.Size = Vector2.new(bw2, bht)
            local fh = bht * hpct
            d.HBar.Visible = true
            d.HBar.Position = Vector2.new(bx, by - fh)
            d.HBar.Size = Vector2.new(bw2, fh)
            d.HBar.Color = hpct > 0.7 and Color3.fromRGB(0, 255, 60) or (hpct > 0.4 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 30, 30))
        end

        -- Weapon
        if C.ESP.Wpn and d.Wpn then
            d.Wpn.Visible = true
            d.Wpn.Text = GetTool(c)
            d.Wpn.Position = Vector2.new(cx, by + 26)
        end
    end
end

-- ============================================
-- TRACER
-- ============================================
local function UpdateTracers()
    if not C.Tracer.On or not C.ESP.On then
        for _, l in pairs(Tracers) do
            if l and l.Visible then l.Visible = false end
        end
        return
    end
    local vs = Camera.ViewportSize
    local o = Vector2.new(vs.X / 2, vs.Y)
    for _, Plr in ipairs(Players:GetPlayers()) do
        if not IsEnemy(Plr) then
            if Tracers[Plr] then Tracers[Plr].Visible = false end
            continue
        end
        local c = GetChar(Plr)
        local rt = GetRoot(c)
        if not rt then
            if Tracers[Plr] then Tracers[Plr].Visible = false end
            continue
        end
        local sp, on = W2S(rt.Position)
        if not on then
            if Tracers[Plr] then Tracers[Plr].Visible = false end
            continue
        end
        if not Tracers[Plr] then
            Tracers[Plr] = Drawing.new("Line")
            Tracers[Plr].Thickness = 1.5
            Tracers[Plr].Transparency = 0.4
        end
        Tracers[Plr].Visible = true
        Tracers[Plr].From = o
        Tracers[Plr].To = sp
        Tracers[Plr].Color = C.Tracer.Rainbow and Color3.fromHSV((tick() * 2) % 1, 1, 1) or C.Tracer.Color
    end
end

-- ============================================
-- AIMBOT (NEAREST TO CURSOR FOV)
-- ============================================
local function FindAimTarget()
    local mp = MousePos()
    local best = nil
    local bestD = C.Aimbot.FOV
    for _, Plr in ipairs(Players:GetPlayers()) do
        if not IsEnemy(Plr) then continue end
        local c = GetChar(Plr)
        if not c then continue end
        local ap = c:FindFirstChild(C.Aimbot.Part)
        if not ap then continue end
        if Dist3D(ap.Position) > C.Aimbot.MaxDist then continue end
        local sp, on = W2S(ap.Position)
        if not on then continue end
        local d2 = (sp - mp).Magnitude
        if d2 < bestD then
            bestD = d2
            best = {Plr = Plr, Part = ap, Pos = ap.Position, Vel = ap.Velocity}
        end
    end
    return best
end

local function UpdateAimbot()
    if not C.Aimbot.On then
        IsAiming = false
        return
    end
    if not UserInputService:IsKeyDown(C.Aimbot.Key) then
        IsAiming = false
        return
    end
    local t = FindAimTarget()
    if not t then
        IsAiming = false
        return
    end
    IsAiming = true

    local tp = t.Pos
    if C.Aimbot.Predict and t.Vel.Magnitude > 3 then
        tp = tp + t.Vel * (Dist3D(t.Pos) / 3000) * 0.13
    end

    local cp = Camera.CFrame.Position
    local dd = (tp - cp).Unit
    local cd = Camera.CFrame.LookVector
    Camera.CFrame = CFrame.new(cp, cp + cd:Lerp(dd, C.Aimbot.Smooth))

    -- AUTO SHOOT (FIXED: use direct fire method)
    if C.Aimbot.AutoShoot then
        local now = tick()
        if now - LastShot >= C.Aimbot.ShootDelay then
            FireMouse()
            LastShot = now
        end
    end
end

-- ============================================
-- TRIGGERBOT (FIXED: REAL MOUSE CLICK)
-- ============================================
local function UpdateTrigger()
    if not C.Trigger.On then return end
    if IsAiming and C.Aimbot.AutoShoot then return end

    local mp = MousePos()
    for _, Plr in ipairs(Players:GetPlayers()) do
        if not IsEnemy(Plr) then continue end
        local c = GetChar(Plr)
        local hd = GetHead(c)
        if not hd then continue end
        local sp, on = W2S(hd.Position)
        if not on then continue end
        if (sp - mp).Magnitude <= C.Trigger.FOV then
            local now = tick()
            if now - LastShot >= C.Trigger.Delay then
                FireMouse()
                LastShot = now
                return
            end
        end
    end
end

-- ============================================
-- AIM ASSIST (MAGNETIC — FIXED)
-- ============================================
local function UpdateAssist()
    if not C.Assist.On or IsAiming then return end

    local mp = MousePos()
    local best = nil
    local bestD = C.Assist.FOV

    for _, Plr in ipairs(Players:GetPlayers()) do
        if not IsEnemy(Plr) then continue end
        local c = GetChar(Plr)
        local hd = GetHead(c)
        if not hd then continue end
        local sp, on = W2S(hd.Position)
        if not on then continue end
        local d2 = (sp - mp).Magnitude
        if d2 < bestD then
            bestD = d2
            best = sp
        end
    end

    if best then
        local delta = best - mp
        local moveX = delta.X * C.Assist.Str * C.Assist.Sm
        local moveY = delta.Y * C.Assist.Str * C.Assist.Sm
        S(function()
            mousemoverel(moveX, moveY)
        end)
    end
end

-- ============================================
-- BUNNY HOP
-- ============================================
local function EnableBHop()
    if BHopConn then return end
    BHopConn = UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if not C.BHOP.On or inp.KeyCode ~= Enum.KeyCode.Space then return end
        local c = GetChar(LocalPlayer)
        if not c then return end
        local h = GetHum(c)
        if not h or h.FloorMaterial == Enum.Material.Air then return end
        h:ChangeState(Enum.HumanoidStateType.Jumping)
        if C.BHOP.Strafe and h.MoveDirection.Magnitude > 0 then
            local r = GetRoot(c)
            if r then r.Velocity = r.Velocity + h.MoveDirection * C.BHOP.Spd * 0.5 end
        end
    end)
end
local function DisableBHop()
    if BHopConn then BHopConn:Disconnect() BHopConn = nil end
end

