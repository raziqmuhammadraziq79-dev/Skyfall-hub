local function FireMouse()
    -- Method 1: VirtualInputManager (most reliable for Arsenal)
    if VirtualInputManager then
        S(function()
            VirtualInputManager:SendMouseButtonEvent(
                Camera.ViewportSize.X / 2,
                Camera.ViewportSize.Y / 2,
                0, true, game, 1
            )
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(
                Camera.ViewportSize.X / 2,
                Camera.ViewportSize.Y / 2,
                0, false, game, 1
            )
        end)
        return
    end

    -- Method 2: VirtualUser
    if VirtualUser then
        S(function()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2))
            task.wait(0.01)
            VirtualUser:Button1Up(Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2))
        end)
        return
    end

    -- Method 3: Mouse object
    if Mouse then
        S(function()
            Mouse:Button1Down()
            task.wait(0.01)
            Mouse:Button1Up()
