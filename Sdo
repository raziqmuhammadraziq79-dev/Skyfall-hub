                end
                if string.find(n, "cooldown") or string.find(n, "reload") then
                    if v.Value > 0 then v.Value = ZERO end
                end
            end
        end
    end

    -- Vehicle di workspace
    for _, obj in ipairs(Workspace:GetChildren()) do
