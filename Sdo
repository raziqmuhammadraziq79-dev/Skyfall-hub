local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local INF = math.huge
local ZERO = 0

-- ========================================================
-- UTILITY
-- ========================================================

local function safeRequire(mod)
    local ok, data = pcall(require, mod)
    if ok and type(data) == "table" then return data end
    return nil
end

local function lockValue(val, target)
    val.Value = target
    val.Changed:Connect(function()
        if val.Value ~= target then
            val.Value = target
        end
    end)
end

-- ========================================================
-- SECTION 1: GOD MODE PLAYER
-- ========================================================

local function applyGod(char)
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    hum.MaxHealth = INF
    hum.Health = INF
    hum.WalkSpeed = 32
    hum.JumpPower = 80
    hum.HealthChanged:Connect(function(hp)
        if hp < 50 then hum.Health = INF end
    end)
end

applyGod(character)
player.CharacterAdded:Connect(function(c)
    character = c
    task.wait(0.1)
    applyGod(c)
end)

-- ========================================================
-- SECTION 2: FORCE INFINITE AMMO + FIX SHOOTING
-- ========================================================

local function fixWeaponValues(parent)
    for _, v in ipairs(parent:GetDescendants()) do
        -- NumberValue / IntValue
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = v.Name:lower()

            -- Ammo keys → lock ke INF
            if  string.find(n, "ammo")    or string.find(n, "bullet") or
                string.find(n, "mag")     or string.find(n, "clip")   or
                string.find(n, "round")   or string.find(n, "reserve")or
                string.find(n, "shell")   or string.find(n, "charge") then
                lockValue(v, INF)
            end

            -- Cooldown / delay keys → lock ke 0
            if  string.find(n, "cooldown") or string.find(n, "reload") or
                string.find(n, "delay")    or string.find(n, "wait")   or
                string.find(n, "timer")    or string.find(n, "spawn")  or
                string.find(n, "respawn")  or string.find(n, "rate")   then
                lockValue(v, ZERO)
            end

        -- BoolValue firing lock
        elseif v:IsA("BoolValue") then
            local n = v.Name:lower()
            if string.find(n, "reload") or string.find(n, "empty") or
               string.find(n, "outof")  or string.find(n, "jammed") then
                lockValue(v, false)
            end

        -- ModuleScript weapon data
        elseif v:IsA("ModuleScript") then
            local data = safeRequire(v)
            if data then
                -- Damage
                for _, k in ipairs({"Damage","BodyDamage","HeadDamage",
                    "HeadshotMultiplier","ExplosionDamage","SplashDamage"}) do
                    data[k] = 99999
                end
                -- Ammo
                for _, k in ipairs({"MagSize","MaxAmmo","Ammo","ReserveAmmo",
                    "ClipSize","MaxClip","StoredAmmo","TotalAmmo"}) do
                    data[k] = INF
                end
                -- Zero timers
                for _, k in ipairs({"ReloadTime","FireRate","RateOfFire",
                    "Cooldown","FireDelay","SpawnCooldown","WeaponCooldown",
                    "DrawTime","EquipTime","SwapTime"}) do
                    data[k] = ZERO
                end
                -- Perfect accuracy
                for _, k in ipairs({"Spread","MaxSpread","Bloom","BloomPerShot",
                    "RecoilX","RecoilY","KickForce","ClimbPerShot",
                    "ShakeMagnitude","MaxClimb"}) do
                    data[k] = ZERO
                end
                -- Range + speed
                data.Range = INF
                data.BulletSpeed = INF
                data.MuzzleVelocity = INF
                data.BulletDrop = ZERO
            end
        end
    end
end

-- Fix semua tool di character + backpack
local function fixAllWeapons()
    local backpack = player:FindFirstChild("Backpack")
    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then fixWeaponValues(tool) end
    end
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then fixWeaponValues(tool) end
        end
    end
end

fixAllWeapons()

-- Auto fix waktu equip tool baru
character.ChildAdded:Connect(function(c)
    if c:IsA("Tool") then task.wait(0.05); fixWeaponValues(c) end
end)

local bp = player:WaitForChild("Backpack")
bp.ChildAdded:Connect(function(c)
    if c:IsA("Tool") then task.wait(0.05); fixWeaponValues(c) end
end)

-- ========================================================
-- SECTION 3: SKIP VEHICLE COOLDOWN
-- Target: tombol "Skip Cooldown (7:47)" di screenshot
-- Scan semua NumberValue bernama cooldown di playerdata
-- ========================================================

local function nukeAllCooldowns(root)
    if not root then return end
    for _, v in ipairs(root:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = v.Name:lower()
            if  string.find(n, "cooldown") or string.find(n, "spawn")  or
                string.find(n, "respawn")  or string.find(n, "timer")  or
                string.find(n, "wait")     or string.find(n, "delay")  or
                string.find(n, "reload")   or string.find(n, "restock") then
                lockValue(v, ZERO)
            end
        end
    end
end

-- Scan player data
nukeAllCooldowns(player)
nukeAllCooldowns(ReplicatedStorage)
nukeAllCooldowns(Workspace)

-- ========================================================
-- SECTION 4: VEHICLE INFINITE AMMO + HEALTH
-- ========================================================

local function fixVehicle(model)
    if not model or not model:IsA("Model") then return end

    -- Humanoid vehicle HP
    local hum = model:FindFirstChild("Humanoid")
    if hum then
        hum.MaxHealth = INF
        hum.Health = INF
        hum.HealthChanged:Connect(function(hp)
            if hp < 100 then hum.Health = INF end
        end)
    end

    -- Semua value di dalam vehicle
    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            local n = v.Name:lower()
            if  string.find(n, "ammo")   or string.find(n, "fuel")  or
                string.find(n, "health") or string.find(n, "armor") or
                string.find(n, "rocket") or string.find(n, "missile")or
                string.find(n, "gun")    or string.find(n, "turret") then
                lockValue(v, INF)
            end
            if  string.find(n, "cooldown") or string.find(n, "reload") or
                string.find(n, "delay")    or string.find(n, "timer") then
                lockValue(v, ZERO)
            end
        end

        -- Module data di vehicle
        if v:IsA("ModuleScript") then
            local data = safeRequire(v)
            if data then
                data.Health = INF
                data.MaxHealth = INF
                data.Armor = INF
                data.VehicleAmmo = INF
                data.MaxVehicleAmmo = INF
                data.RocketAmmo = INF
                data.MissileAmmo = INF
                data.GunAmmo = INF
                data.FuelCapacity = INF
                data.Fuel = INF
                data.FuelConsumption = ZERO
                data.SpawnCooldown = ZERO
                data.RespawnTime = ZERO
                data.WeaponCooldown = ZERO
                data.GunCooldown = ZERO
                data.RocketCooldown = ZERO
                data.MissileCooldown = ZERO
                data.GunDamage = 99999
                data.RocketDamage = 99999
                data.MissileDamage = 99999
            end
        end
    end
end

-- Fix semua vehicle yang ada sekarang
for _, obj in ipairs(Workspace:GetChildren()) do
    fixVehicle(obj)
end

-- Auto fix vehicle baru yang spawn
Workspace.ChildAdded:Connect(function(obj)
    task.wait(0.1)
    fixVehicle(obj)
end)

