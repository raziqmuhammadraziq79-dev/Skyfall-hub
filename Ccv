local function RemoveESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            if type(obj) == "table" then
                for _, line in pairs(obj) do RemoveDrawing(line) end
            else
                RemoveDrawing(obj)
            end
        end
        ESPObjects[player] = nil
    end
end

-- // CORNER BOX DRAW
local function DrawCornerBox(box, topLeft, topRight, botLeft, botRight, color, alpha)
    local cw = (topRight.X - topLeft.X) * 0.25
    local ch = (botLeft.Y - topLeft.Y) * 0.25

    box.TL.From = topLeft; box.TL.To = topLeft + Vector2.new(cw, 0); box.TL.Color = color; box.TL.Transparency = alpha
    box.TR.From = topRight; box.TR.To = topRight - Vector2.new(cw, 0); box.TR.Color = color; box.TR.Transparency = alpha
    box.BL.From = botLeft; box.BL.To = botLeft + Vector2.new(cw, 0); box.BL.Color = color; box.BL.Transparency = alpha
    box.BR.From = botRight; box.BR.To = botRight - Vector2.new(cw, 0); box.BR.Color = color; box.BR.Transparency = alpha

    box.Top.From = topLeft; box.Top.To = topLeft + Vector2.new(0, ch); box.Top.Color = color; box.Top.Transparency = alpha
    box.Bot.From = botLeft; box.Bot.To = botLeft - Vector2.new(0, ch); box.Bot.Color = color; box.Bot.Transparency = alpha
    box.Left.From = topRight; box.Left.To = topRight + Vector2.new(0, ch); box.Left.Color = color; box.Left.Transparency = alpha
    box.Right.From = botRight; box.Right.To = botRight - Vector2.new(0, ch); box.Right.Color = color; box.Right.Transparency = alpha

    for _, line in pairs(box) do line.Visible = true end
end

-- // AIMBOT TARGET
local AimbotTarget = nil

local function GetClosestTarget()
    local bestDist = math.huge
    local bestPlayer = nil
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsEnemy(player) then
            local char = GetCharacter(player)
            local hum = GetHumanoid(char)
            if char and hum and hum.Health > 0 then
                local part = char:FindFirstChild(Config.AimPart) or GetRoot(char)
                if part then
                    local screen, onScreen = WorldToViewport(part.Position)
                    if onScreen then
                        local dist = (screen - center).Magnitude
                        if dist < Config.AimFOV and dist < bestDist then
                            bestDist = dist
                            bestPlayer = player
                        end
                    end
                end
            end
        end
    end
    return bestPlayer
end

-- // SILENT AIM HOOK
if Config.SilentAim then
    local mt = getrawmetatable(game)
    local old = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, key)
        if key == "Hit" and self == LocalPlayer:GetMouse() then
            local target = GetClosestTarget()
            if target and Config.Aimbot_Enabled then
                local char = GetCharacter(target)
                local part = char and (char:FindFirstChild(Config.AimPart) or GetRoot(char))
                if part then
                    local fakeCF = CFrame.new(part.Position)
                    return fakeCF
                end
            end
        end
        return old(self, key)
    end)
    setreadonly(mt, true)
end

-- // BUNNY HOP + AUTO SLIDE
if Config.BunnyHop or Config.AutoSlide then
    RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = GetHumanoid(char)
        local root = GetRoot(char)
        if not hum or not root then return end

        -- BunnyHop
        if Config.BunnyHop then
            if hum.FloorMaterial ~= Enum.Material.Air then
                hum.Jump = true
            end
        end

        -- AutoSlide
        if Config.AutoSlide then
            local speed = root.Velocity.Magnitude
            if speed > 20 and hum.MoveDirection.Magnitude > 0 then
                if hum.FloorMaterial ~= Enum.Material.Air then
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end
            end
        end
    end)
end

-- // MAIN LOOP
RunService.RenderStepped:Connect(function()
    if not Config.ESP_Enabled and not Config.Tracer_Enabled and not Config.Aimbot_Enabled then return end

    -- Aimbot AutoLock
    if Config.Aimbot_Enabled and Config.AutoLock then
        AimbotTarget = GetClosestTarget()
        if AimbotTarget then
            local char = GetCharacter(AimbotTarget)
            local part = char and (char:FindFirstChild(Config.AimPart) or GetRoot(char))
            if part then
                local screen, onScreen = WorldToViewport(part.Position)
                if onScreen then
                    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local delta = screen - center

                    -- AimAssist (smooth camera nudge)
                    if Config.AimAssist then
                        local cf = Camera.CFrame
                        local targetCF = CFrame.new(cf.Position, part.Position)
                        Camera.CFrame = cf:Lerp(targetCF, Config.AimAssist_Strength)
                    end

                    -- Hard AutoLock Aimbot
                    if not Config.AimAssist then
                        local cf = Camera.CFrame
                        local targetCF = CFrame.new(cf.Position, part.Position)
                        Camera.CFrame = cf:Lerp(targetCF, Config.AimSmoothing)
                    end
                end
            end
        end
    end

    -- ESP Loop
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local esp = ESPObjects[player]
        if not esp then continue end

        local char = GetCharacter(player)
        local hum = GetHumanoid(char)
        local root = GetRoot(char)

        local isEnemy = IsEnemy(player)
        local isTeam = IsTeam(player)
        local isFriend = IsFriend(player)

        local showESP = (Config.ESP_Enemies and isEnemy) or
                        (Config.ESP_Team and isTeam) or
                        (Config.ESP_Friends and isFriend)

        local showTrace = (Config.Tracer_Enemies and isEnemy) or
                          (Config.Tracer_Team and isTeam) or
                          (Config.Tracer_Friends and isFriend)

        if not char or not hum or hum.Health <= 0 or not root then
            for _, obj in pairs(esp) do
                if type(obj) == "table" then for _, l in pairs(obj) do l.Visible = false end
                else obj.Visible = false end
            end
            continue
        end

        local rootPos, onScreen, depth = WorldToViewport(root.Position)
        local dist = (root.Position - Camera.CFrame.Position).Magnitude

        if not onScreen or dist > Config.MaxDistance or not showESP then
            for _, obj in pairs(esp) do
                if type(obj) == "table" then for _, l in pairs(obj) do l.Visible = false end
                else obj.Visible = false end
            end
            continue
        end

        local color = isEnemy and Config.Color_Enemy or (isTeam and Config.Color_Team or Config.Color_Friend)
        local tracerColor = isEnemy and Config.Color_Tracer_Enemy or (isTeam and Config.Color_Tracer_Team or Config.Color_Tracer_Friend)

        -- Box ESP
        if Config.ShowBox then
            local minB, maxB = GetBoundingBox(char)
            local corners = {
                Vector3.new(minB.X, minB.Y, minB.Z),
                Vector3.new(maxB.X, minB.Y, minB.Z),
                Vector3.new(minB.X, maxB.Y, minB.Z),
                Vector3.new(maxB.X, maxB.Y, minB.Z),
                Vector3.new(minB.X, minB.Y, maxB.Z),
                Vector3.new(maxB.X, minB.Y, maxB.Z),
                Vector3.new(minB.X, maxB.Y, maxB.Z),
                Vector3.new(maxB.X, maxB.Y, maxB.Z),
            }
            local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
            local allOnScreen = true
            for _, c in pairs(corners) do
                local sv, os = WorldToViewport(c)
                if not os then allOnScreen = false end
                minX = math.min(minX, sv.X)
                minY = math.min(minY, sv.Y)
                maxX = math.max(maxX, sv.X)
                maxY = math.max(maxY, sv.Y)
            end

            local tl = Vector2.new(minX, minY)
            local tr = Vector2.new(maxX, minY)
            local bl = Vector2.new(minX, maxY)
            local br = Vector2.new(maxX, maxY)

            DrawCornerBox(esp.Box, tl, tr, bl, br, color, 1)

            -- Health Bar
            if Config.ShowHealthBar then
                local healthPct = hum.Health / hum.MaxHealth
                local barH = maxY - minY
                local barX = minX - 6
                esp.HealthBarBG.From = Vector2.new(barX, minY)
                esp.HealthBarBG.To = Vector2.new(barX, maxY)
                esp.HealthBarBG.Visible = true

                local hColor = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 0)
                esp.HealthBar.From = Vector2.new(barX, maxY)
                esp.HealthBar.To = Vector2.new(barX, maxY - barH * healthPct)
                esp.HealthBar.Color = hColor
                esp.HealthBar.Visible = true
            else
                esp.HealthBar.Visible = false
                esp.HealthBarBG.Visible = false
            end

            -- Name
            if Config.ShowName then
                esp.Name.Text = player.DisplayName
                esp.Name.Position = Vector2.new((minX + maxX) / 2, minY - 16)
                esp.Name.Color = Config.Color_Name
                esp.Name.Visible = true
            else
                esp.Name.Visible = false
            end

            -- Distance
            if Config.ShowDistance then
                esp.Distance.Text = string.format("[%dm]", math.floor(dist))
                esp.Distance.Position = Vector2.new((minX + maxX) / 2, maxY + 2)
                esp.Distance.Color = Config.Color_Distance
                esp.Distance.Visible = true
            else
                esp.Distance.Visible = false
            end
        end

        -- Tracer
        if Config.Tracer_Enabled and showTrace then
            local vp = Camera.ViewportSize
            local originPos
            if Config.TracerOrigin == "Bottom" then
                originPos = Vector2.new(vp.X / 2, vp.Y)
            elseif Config.TracerOrigin == "Top" then
                originPos = Vector2.new(vp.X / 2, 0)
            else
                originPos = Vector2.new(vp.X / 2, vp.Y / 2)
            end
            esp.Tracer.From = originPos
            esp.Tracer.To = rootPos
            esp.Tracer.Color = tracerColor
            esp.Tracer.Thickness = 1.2
            esp.Tracer.Visible = true
        else
            esp.Tracer.Visible = false
        end
    end
end)

