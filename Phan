-- ================= ESP RENDERING ENGINE =================
function CreateESP(Player)
    if Player == LocalPlayer then return end
    
    local Diamond = Drawing.new("Square")
    Diamond.Thickness = 2
    Diamond.Filled = false
    
    local Tracer = Drawing.new("Line")
    Tracer.Thickness = Config.TracerThickness
    
    local HealthBar = Drawing.new("Square")
    HealthBar.Thickness = 2
    HealthBar.Filled = true
    
    ESPCache[Player] = {
        Diamond = Diamond,
        Tracer = Tracer,
        HealthBar = HealthBar,
        LastRoot = nil
    }
end

function UpdateVisuals()
    if not Config.Enabled then return end
    
    for Player, Data in pairs(ESPCache) do
        if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            local Root = Player.Character.HumanoidRootPart
            local Head = Player.Character:FindFirstChild("Head")
            local Humanoid = Player.Character:FindFirstChild("Humanoid")
            
            if Root and Head and Humanoid then
                local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                
                if OnScreen then
                    local Dist = (Camera.CFrame.Position - Root.Position).Magnitude
                    local Size = math.clamp(500 / Dist, 10, 100)
                    
                    -- Dynamic Diamond Position
                    local HalfSize = Size / 2
                    Data.Diamond.Size = Vector2.new(Size, Size)
                    Data.Diamond.Position = Vector2.new(Pos.X - HalfSize, Pos.Y - HalfSize)
                    
                    -- Team Check
                    local IsEnemy = true
                    if LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team then
                        IsEnemy = false
                    end
                    
                    local Color = IsEnemy and Config.ColorEnemy or Config.ColorTeam
                    Data.Diamond.Color = Color
                    Data.Tracer.Color = Color
                    
                    -- Tracer Logic (From bottom center screen to target)
                    Data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    Data.Tracer.To = Vector2.new(Pos.X, Pos.Y + HalfSize)
                    Data.Tracer.Visible = IsEnemy
                    
                    -- Health Bar Logic
                    if Config.ShowHealth and IsEnemy then
                        local HPPercent = Humanoid.Health / Humanoid.MaxHealth
                        Data.HealthBar.Size = Vector2.new(4, Size * HPPercent)
                        Data.HealthBar.Position = Vector2.new(Pos.X + HalfSize + 5, Pos.Y + HalfSize - (Size * HPPercent))
                        Data.HealthBar.Color = Color3.fromRGB(255, 255, 255) -- White bar
                        Data.HealthBar.Visible = true
                    else
                        Data.HealthBar.Visible = false
                    end
                    
                    Data.Diamond.Visible = true
                else
                    Data.Diamond.Visible = false
                    Data.Tracer.Visible = false
                    Data.HealthBar.Visible = false
                end
            end
        else
            Data.Diamond.Visible = false
            Data.Tracer.Visible = false
            Data.HealthBar.Visible = false
        end
    end
end

-- ================= AIMBOT ENGINE (SILENT LOCK) =================
function GetBestTarget()
    local ClosestDist = math.huge
    local Target = nil
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            local Head = Player.Character:FindFirstChild("Head")
            
            if Root and Head then
                local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                local ScreenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local Dist = (Vector2.new(Pos.X, Pos.Y) - ScreenCenter).Magnitude
                
                local IsEnemy = true
                if LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team then
                    IsEnemy = false
                end
                
                if Dist < Config.FOV and IsEnemy and OnScreen then
                    if Dist < ClosestDist then
                        ClosestDist = Dist
                        Target = {Head = Head, Root = Root, Player = Player}
                    end
                end
            end
        end
    end
    return Target
end

-- ================= MAIN LOOP =================
RunService.RenderStepped:Connect(function()
    if not IsActive then return end
    
    Camera = workspace.CurrentCamera
    UpdateVisuals()
    
    if Config.Enabled then
        local TargetData = GetBestTarget()
        if TargetData then
            CurrentTarget = TargetData.Player
            StatusLabel.Text = "LOCKED: " .. CurrentTarget.Name
            
            -- Silent Aim Logic (Modifying ViewAngle slightly for precision)
            local TargetPos = TargetData.Head.Position
            local CurrentCFrame = Camera.CFrame
            local LookAtCFrame = CFrame.new(CurrentCFrame.Position, TargetPos)
            
            -- Smooth Damping for Natural Movement
            Camera.CFrame = CurrentCFrame:Lerp(LookAtCFrame, Config.Smoothness)
        else
            CurrentTarget = nil
            StatusLabel.Text = "Scanning area..."
        end
    end
end)

-- ================= INITIALIZATION =================
Players.PlayerAdded:Connect(function(Player)
    Player.CharacterAdded:Connect(function()
        task.wait(0.5)
        CreateESP(Player)
    end)
    if Player.Character then CreateESP(Player) end
end)

Players.PlayerRemoving:Connect(function(Player)
    if ESPCache[Player] then
        for _, Obj in pairs(ESPCache[Player]) do
            if Obj.Remove then Obj:Remove() end
        end
        ESPCache[Player] = nil
    end
end)

for _, Player in pairs(Players:GetPlayers()) do
    if Player.Character then CreateESP(Player) end
end

print("[Hanami] Phantom V2 Initialized. System Clean.")
