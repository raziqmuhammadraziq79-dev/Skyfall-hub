-- ================= ESP RENDERING ENGINE (FIXED) =================
function CreateESP(Player)
    if Player == LocalPlayer then return end
    
    local Box = Drawing.new("Square")
    Box.Thickness = Settings.Thickness
    Box.Filled = false
    
    local Tracer = Drawing.new("Line")
    Tracer.Thickness = 1.5
    
    ESP_Cache[Player] = { Box = Box, Tracer = Tracer }
end

function UpdateESP()
    if not Settings.Enabled then
        for _, Data in pairs(ESP_Cache) do
            Data.Box.Visible = false
            Data.Tracer.Visible = false
        end
        return
    end

    for Player, Data in pairs(ESP_Cache) do
        if Player.Character then
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            if Root then
                local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                
                if OnScreen then
                    local Dist = (Camera.CFrame.Position - Root.Position).Magnitude
                    local Size = math.clamp(600 / Dist, 10, 150) -- Clamp untuk stabilitas
                    
                    -- Fix Berantakan: Posisi dihitung dari tengah
                    Data.Box.Size = Vector2.new(Size, Size * 1.5)
                    Data.Box.Position = Vector2.new(Pos.X - Size/2, Pos.Y - (Size*1.5)/2)
                    
                    local IsEnemy = not (LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team)
                    local Color = IsEnemy and Settings.ColorEnemy or Settings.ColorTeam
                    
                    Data.Box.Color = Color
                    Data.Tracer.Color = Color
                    
                    Data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    Data.Tracer.To = Vector2.new(Pos.X, Pos.Y + (Size*1.5)/2)
                    
                    Data.Box.Visible = true
                    Data.Tracer.Visible = IsEnemy
                else
                    Data.Box.Visible = false
                    Data.Tracer.Visible = false
                end
            end
        end
    end
end

-- ================= SILENT AIMBOT ENGINE (FIXED) =================
function GetNearestTarget()
    local Closest = nil
    local MinDist = math.huge
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local Head = Player.Character:FindFirstChild("Head")
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            
            if Head and Root then
                local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local Dist2D = (Vector2.new(Pos.X, Pos.Y) - Center).Magnitude
                
                local IsEnemy = not (LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team)
                
                if Dist2D < Settings.FOV_Radius and IsEnemy and OnScreen then
                    local Dist3D = (Camera.CFrame.Position - Root.Position).Magnitude
                    if Dist3D < MinDist then
                        MinDist = Dist3D
                        Closest = Head
                    end
                end
            end
        end
    end
    return Closest
end

function ApplySilentAim()
    if not Settings.AimbotEnabled or not IsActive then return end
    
    local TargetHead = GetNearestTarget()
    if TargetHead then
        CurrentTarget = TargetHead.Parent.Parent.Name
        InfoLabel.Text = "LOCKED: " .. CurrentTarget
        
        -- Teknik Silent: Mengubah CFrame kamera sedikit demi sedikit
        -- Ini memungkinkan user masih bisa menggeser layar, tapi aim tetap nempel
        local TargetPos = TargetHead.Position
        local CurrentCF = Camera.CFrame
        local LookCF = CFrame.new(CurrentCF.Position, TargetPos)
        
        Camera.CFrame = CurrentCF:Lerp(LookCF, Settings.Smoothness)
    else
        CurrentTarget = nil
        InfoLabel.Text = "Scanning..."
    end
end

-- ================= INITIALIZATION =================
Players.PlayerAdded:Connect(function(P)
    P.CharacterAdded:Connect(function() task.wait(0.5); CreateESP(P) end)
    if P.Character then CreateESP(P) end
end)

Players.PlayerRemoving:Connect(function(P)
    if ESP_Cache[P] then
        for _, Obj in pairs(ESP_Cache[P]) do if Obj.Remove then Obj:Remove() end end
        ESP_Cache[P] = nil
    end
end)

for _, P in pairs(Players:GetPlayers()) do if P.Character then CreateESP(P) end end

-- ================= MAIN LOOP =================
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    UpdateESP()
    ApplySilentAim()
end)

