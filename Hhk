local function S(f, ...) local o,r = pcall(f, ...) return o and r or nil end
local function Get(Plr) return Plr and Plr.Character end
local function Root(C) return C and C:FindFirstChild("HumanoidRootPart") end
local function Head(C) return C and C:FindFirstChild("Head") end
local function Hum(C) return C and C:FindFirstChildOfClass("Humanoid") end
local function Dead(Plr) local c=Get(Plr) if not c then return true end local h=Hum(c) return not h or h.Health<=0 end
