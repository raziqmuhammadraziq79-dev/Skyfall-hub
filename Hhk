local function D3(P) return Camera and (Camera.CFrame.Position-P).Magnitude or 9999 end
local function W2S(P) local v,o=Camera:WorldToViewportPoint(P) return Vector2.new(v.X,v.Y),o end
local function MP() return UserInputService:GetMouseLocation() end

