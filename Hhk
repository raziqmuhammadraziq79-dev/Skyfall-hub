    Tog(cm,"Speed Hack",C.Speed.On,function(v)C.Speed.On=v end)
    sm.Size = UDim2.new(1,-14,0,32*3+36)

    -- Weapon Section (4 toggles)
    local sw, cw = Sec("🔫 WEAPON MODS")
    Tog(cw,"Fast Reload",C.Reload.On,function(v)C.Reload.On=v end)
    Tog(cw,"No Recoil",C.Recoil.On,function(v)C.Recoil.On=v end)
    Tog(cw,"No Spread",C.Spread.On,function(v)C.Spread.On=v end)
    Tog(cw,"Rapid Fire",C.Rapid.On,function(v)C.Rapid.On=v end)
    sw.Size = UDim2.new(1,-14,0,32*4+36)

    -- Utilities Section (2 toggles)
    local su, cu = Sec("⚙️ UTILITIES")
    Tog(cu,"Anti AFK",C.AntiAFK.On,function(v)C.AntiAFK.On=v end)
    Tog(cu,"Third Person",C.ThirdP.On,function(v)C.ThirdP.On=v SetThirdPerson(v) end)
    su.Size = UDim2.new(1,-14,0,32*2+36)

    -- Canvas size
    sf.CanvasSize = UDim2.new(0,0,0,32*9+36+32*8+36+32*3+36+32*4+36+32*2+36+7*5+30)

    -- Floating toggle button
    local fbtn = Instance.new("TextButton",g)
    fbtn.Size=UDim2.new(0,50,0,50); fbtn.Position=UDim2.new(0,14,0,14)
    fbtn.BackgroundColor3=Color3.fromRGB(255,50,50); fbtn.Text="🔴"; fbtn.TextColor3=Color3.fromRGB(255,255,255)
    fbtn.Font=Enum.Font.GothamBold; fbtn.TextSize=22; fbtn.ZIndex=10; fbtn.AutoButtonColor=false
    Instance.new("UICorner",fbtn).CornerRadius=UDim.new(1,0)
    fbtn.MouseButton1Click:Connect(function() m.Visible=not m.Visible end)
    minb.MouseButton1Click:Connect(function() m.Visible=false end)
    clb.MouseButton1Click:Connect(function() m.Visible=false end)

    -- FOV Circle
    FOVC = Drawing.new("Circle"); FOVC.Visible=false; FOVC.Thickness=1.5; FOVC.Filled=false; FOVC.Transparency=0.5; FOVC.Color=Color3.fromRGB(255,255,255)
    task.spawn(function() while task.wait(0.03) do if FOVC and C.Aimbot.FOVVis and C.Aimbot.On then FOVC.Visible=true FOVC.Position=MP() FOVC.Radius=C.Aimbot.FOV else if FOVC then FOVC.Visible=false end end end end)
