local function MakeESP(Plr)
    if not Enemy(Plr) or ESPD[Plr] then return end
    if not Plr.Character then Plr.CharacterAdded:Wait() end
    local d = {}
    for i=1,8 do local l=Drawing.new("Line") l.Visible=false l.Thickness=1.5 l.Transparency=0.4 l.Color=C.ESP.EColor table.insert(d,l) end
    d.HDot = Drawing.new("Circle"); d.HDot.Visible=false; d.HDot.Filled=true; d.HDot.Transparency=0.5; d.HDot.Color=C.ESP.EColor; d.HDot.Radius=5
    d.Name = Drawing.new("Text"); d.Name.Visible=false; d.Name.Size=13; d.Name.Center=true; d.Name.Outline=true; d.Name.OutlineColor=Color3.fromRGB(0,0,0); d.Name.Color=C.ESP.TColor
    d.Dist = Drawing.new("Text"); d.Dist.Visible=false; d.Dist.Size=11; d.Dist.Center=true; d.Dist.Outline=true; d.Dist.OutlineColor=Color3.fromRGB(0,0,0); d.Dist.Color=Color3.fromRGB(200,200,200)
    d.HBg = Drawing.new("Square"); d.HBg.Visible=false; d.HBg.Filled=true; d.HBg.Transparency=0.6; d.HBg.Color=Color3.fromRGB(20,20,20)
    d.HBar = Drawing.new("Square"); d.HBar.Visible=false; d.HBar.Filled=true; d.HBar.Transparency=0.2; d.HBar.Color=Color3.fromRGB(0,255,60)
    d.Wpn = Drawing.new("Text"); d.Wpn.Visible=false; d.Wpn.Size=10; d.Wpn.Center=true; d.Wpn.Outline=true; d.Wpn.OutlineColor=Color3.fromRGB(0,0,0); d.Wpn.Color=Color3.fromRGB(255,200,30)
    ESPD[Plr] = d
end

local function UpdateESP()
    for Plr, d in pairs(ESPD) do
        if not Plr.Parent then S(function() for _,v in pairs(d) do v:Remove() end end) ESPD[Plr]=nil continue end
        local c = Get(Plr)
        if not c or Dead(Plr) or not C.ESP.On then for _,v in pairs(d) do if v.Visible then v.Visible=false end end continue end
        local hd = Head(c); local rt = Root(c); local hu = Hum(c)
        if not hd or not rt or not hu then continue end
        local hp,hs=W2S(hd.Position); local rp,rs=W2S(rt.Position)
        if not hs and not rs then for _,v in pairs(d) do v.Visible=false end continue end
        local dist = D3(rt.Position)
        if dist > C.ESP.MaxDist then for _,v in pairs(d) do v.Visible=false end continue end
        local sc = math.clamp(1/(dist*0.001),0.2,3)
        local bh = 300*sc; local bw = 180*sc; local cl = bh*0.22
        local cx = rp.X; local ty = hp.Y-bh*0.35; local by = rp.Y+bh*0.15
        local lx = cx-bw/2; local rx = cx+bw/2
        local TL=Vector2.new(lx,ty); local TR=Vector2.new(rx,ty); local BL=Vector2.new(lx,by); local BR=Vector2.new(rx,by)
        -- Corner box 8 segmen
        if C.ESP.Box then
            d[1].Visible=true; d[1].From=TL; d[1].To=TL+Vector2.new(cl,0)
            d[2].Visible=true; d[2].From=TL; d[2].To=TL+Vector2.new(0,cl)
            d[3].Visible=true; d[3].From=TR; d[3].To=TR-Vector2.new(cl,0)
            d[4].Visible=true; d[4].From=TR; d[4].To=TR+Vector2.new(0,cl)
            d[5].Visible=true; d[5].From=BL; d[5].To=BL+Vector2.new(cl,0)
            d[6].Visible=true; d[6].From=BL; d[6].To=BL-Vector2.new(0,cl)
            d[7].Visible=true; d[7].From=BR; d[7].To=BR-Vector2.new(cl,0)
            d[8].Visible=true; d[8].From=BR; d[8].To=BR-Vector2.new(0,cl)
        else for i=1,8 do d[i].Visible=false end end
        -- Head dot
        if C.ESP.HeadDot and d.HDot then d.HDot.Visible=hs; d.HDot.Position=hp; d.HDot.Radius=math.clamp(30/(dist*0.01),3,7) else if d.HDot then d.HDot.Visible=false end end
        -- Name
        if C.ESP.Name and d.Name then d.Name.Visible=true; d.Name.Text=Plr.Name; d.Name.Position=Vector2.new(cx,ty-18) else if d.Name then d.Name.Visible=false end end
        -- Distance
        if C.ESP.Dist and d.Dist then d.Dist.Visible=true; d.Dist.Text=math.floor(dist).."m"; d.Dist.Position=Vector2.new(cx,by+12) else if d.Dist then d.Dist.Visible=false end end
        -- Health bar
        if C.ESP.HP and d.HBg and d.HBar then
            local hpct = math.clamp(hu.Health/hu.MaxHealth,0,1); local bx=lx-10; local bw2=3; local bht=by-ty
            d.HBg.Visible=true; d.HBg.Position=Vector2.new(bx,ty); d.HBg.Size=Vector2.new(bw2,bht)
            local fh=bht*hpct; d.HBar.Visible=true; d.HBar.Position=Vector2.new(bx,by-fh); d.HBar.Size=Vector2.new(bw2,fh)
            d.HBar.Color = hpct>0.7 and Color3.fromRGB(0,255,60) or (hpct>0.4 and Color3.fromRGB(255,200,0) or Color3.fromRGB(255,30,30))
        else if d.HBg then d.HBg.Visible=false end if d.HBar then d.HBar.Visible=false end end
        -- Weapon
        if C.ESP.Wpn and d.Wpn then local t=nil for _,o in ipairs(c:GetChildren()) do if o:IsA("Tool") then t=o break end end d.Wpn.Visible=true d.Wpn.Text=t and t.Name or "HANDS" d.Wpn.Position=Vector2.new(cx,by+26) else if d.Wpn then d.Wpn.Visible=false end end
    end
end

