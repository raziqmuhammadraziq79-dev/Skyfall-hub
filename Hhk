-- TRACER
-- ============================================
local function UpdateTracers()
    if not C.Tracer.On or not C.ESP.On then for _,l in pairs(Tracers) do l.Visible=false end return end
    local vs = Camera.ViewportSize; local o = Vector2.new(vs.X/2, vs.Y)
    for _, Plr in ipairs(Players:GetPlayers()) do
        if not Enemy(Plr) then if Tracers[Plr] then Tracers[Plr].Visible=false end continue end
        local c=Get(Plr); local rt=Root(c); if not rt then if Tracers[Plr] then Tracers[Plr].Visible=false end continue end
        local sp, on=W2S(rt.Position)
        if not on then if Tracers[Plr] then Tracers[Plr].Visible=false end continue end
        if not Tracers[Plr] then Tracers[Plr]=Drawing.new("Line") Tracers[Plr].Thickness=1.5 Tracers[Plr].Transparency=0.4 end
        Tracers[Plr].Visible=true; Tracers[Plr].From=o; Tracers[Plr].To=sp
        if C.Tracer.Rainbow then Tracers[Plr].Color=Color3.fromHSV((tick()*2)%1,1,1) else Tracers[Plr].Color=C.Tracer.Color end
    end
end

-- ============================================
-- AIMBOT (NEAREST TO CURSOR, REAL LOCK)
-- ============================================
local function FindAimTarget()
    local mp = MP(); local best = nil; local bestD = C.Aimbot.FOV
    for _, Plr in ipairs(Players:GetPlayers()) do
        if not Enemy(Plr) then continue end
        local c=Get(Plr); if not c then continue end
        local ap = c:FindFirstChild(C.Aimbot.Part); if not ap then continue end
        if D3(ap.Position) > C.Aimbot.MaxDist then continue end
        local sp, on = W2S(ap.Position); if not on then continue end
        local d2 = (sp-mp).Magnitude; if d2 < bestD then bestD=d2 best={Plr=Plr,Part=ap,Pos=ap.Position,Vel=ap.Velocity} end
    end
    return best
end

local function UpdateAimbot()
    if not C.Aimbot.On then IsAim=false; return end
    local held = UserInputService:IsKeyDown(C.Aimbot.Key)
    if not held then IsAim=false; return end
    local t = FindAimTarget()
    if not t then IsAim=false; return end
    IsAim=true
    local tp = t.Pos
    if C.Aimbot.Predict and t.Vel.Magnitude>5 then tp=tp+t.Vel*(D3(t.Pos)/2500)*0.14 end
    local cp = Camera.CFrame.Position; local dd = (tp-cp).Unit; local cd = Camera.CFrame.LookVector
    Camera.CFrame = CFrame.new(cp, cp + cd:Lerp(dd, C.Aimbot.Smooth))
    if C.Aimbot.AutoShoot then
        local n=tick(); if n-LastShoot >= C.Aimbot.ShootDelay then
            S(function() VirtualUser:Button1Down() end) task.wait(0.02) S(function() VirtualUser:Button1Up() end) LastShoot=n
        end
    end
end

-- ============================================
-- TRIGGERBOT
-- ============================================
local function UpdateTrigger()
    if not C.Trigger.On then return end
    if IsAim and C.Aimbot.AutoShoot then return end
    local mp = MP()
    for _, Plr in ipairs(Players:GetPlayers()) do
        if not Enemy(Plr) then continue end
        local c=Get(Plr); local hd=Head(c); if not hd then continue end
        local sp, on=W2S(hd.Position); if not on then continue end
        if (sp-mp).Magnitude <= 35 then
            local n=tick(); if n-LastShoot >= C.Trigger.Delay then
                S(function() VirtualUser:Button1Down() end) task.wait(0.02) S(function() VirtualUser:Button1Up() end) LastShoot=n
                return
            end
        end
    end
end

-- ============================================
-- AIM ASSIST (MAGNET)
-- ============================================
local function UpdateAssist()
    if not C.Assist.On or IsAim then return end
    local mp = MP(); local best=nil; local bestD=C.Assist.FOV
    for _, Plr in ipairs(Players:GetPlayers()) do
        if not Enemy(Plr) then continue end
        local c=Get(Plr); local hd=Head(c); if not hd then continue end
        local sp,on=W2S(hd.Position); if not on then continue end
        local d2=(sp-mp).Magnitude; if d2<bestD then bestD=d2 best=sp end
    end
    if best then
        local d=best-mp; S(function() mousemoverel(d.X*C.Assist.Str*C.Assist.Sm, d.Y*C.Assist.Str*C.Assist.Sm) end)
    end
end

-- ============================================
-- BUNNY HOP
-- ============================================
local function EnableBHop()
    if BHop then return end
    BHop = UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if not C.BHOP.On or inp.KeyCode~=Enum.KeyCode.Space then return end
        local c=Get(LocalPlayer); if not c then return end
        local h=Hum(c); if not h or h.FloorMaterial==Enum.Material.Air then return end
        h:ChangeState(Enum.HumanoidStateType.Jumping)
        if C.BHOP.Strafe and h.MoveDirection.Magnitude>0 then
            local r=Root(c); if r then r.Velocity=r.Velocity+h.MoveDirection*C.BHOP.Spd*0.5 end
        end
    end)
end
local function DisableBHop() if BHop then BHop:Disconnect() BHop=nil end end

