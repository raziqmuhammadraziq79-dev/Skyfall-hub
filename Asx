-- ===================== ESP SYSTEM =====================
local function createESP(player)
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    
    local character = player.Character
    local hrp = character.HumanoidRootPart
    
    -- Box ESP
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(4, 0, 6, 0)
    billboard.StudsOffset = Vector3.new(0, 0, 0)
    billboard.MaxDistance = 500
    billboard.Parent = hrp
    
    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 1, 0)
    box.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    box.BackgroundTransparency = 0.7
    box.BorderColor3 = Color3.fromRGB(255, 255, 255)
    box.BorderSizePixel = 2
    box.Parent = billboard
    
    -- Name Label
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.2, 0)
    nameLabel.Position = UDim2.new(0, 0, -0.3, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextSize = 14
    nameLabel.Text = player.Name
    nameLabel.Parent = billboard
    
    playerCache[player] = {
        billboard = billboard,
        box = box,
        nameLabel = nameLabel,
        character = character,
        lastUpdate = tick()
    }
end

local function removeESP(player)
    if playerCache[player] then
        if playerCache[player].billboard then
            playerCache[player].billboard:Destroy()
        end
        playerCache[player] = nil
    end
end

local function updateESP()
    if not Config.ESPEnabled then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                if not playerCache[player] then
                    createESP(player)
                end
            else
                removeESP(player)
            end
        end
    end
end

-- ===================== AIMBOT SYSTEM =====================
local function getClosestEnemy()
    local closestDistance = math.huge
    local closestTarget = nil
    local localChar = Players.LocalPlayer.Character
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character then
            local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                local distance = (localChar.HumanoidRootPart.Position - targetHRP.Position).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestTarget = player
                end
            end
        end
    end
    
    return closestTarget
end

local function aimAtTarget(target)
    if not target or not target.Character then return end
    
    local targetHead = target.Character:FindFirstChild("Head")
    if not targetHead then
        targetHead = target.Character:FindFirstChild("HumanoidRootPart")
    end
    
    if targetHead then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetHead.Position)
    end
end

local function autoTarget()
    if not Config.TargetingEnabled then return end
    
    selectedTarget = getClosestEnemy()
    
    if selectedTarget and Config.AimbotEnabled then
        aimAtTarget(selectedTarget)
    end
end

