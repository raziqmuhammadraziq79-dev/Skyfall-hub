-- BUNNY HOP — MOBILE FIXED
-- ═══════════════════════════════════════════════════════
local BHConn
local function StartBH()
    if BHConn then pcall(function() BHConn:Disconnect() end) end
    BHConn = RunService.Heartbeat:Connect(function()
        if not Cfg.BunnyHop then return end
        local c = LP.Character
        if not c then return end
        local hum  = GetHum(c)
        if not hum then return end
        -- State jumping = lebih reliable di mobile daripada .Jump = true
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.Running
        or state == Enum.HumanoidStateType.RunningNoPhysics then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end
StartBH()
LP.CharacterAdded:Connect(function() task.wait(1); StartBH() end)

-- ═══════════════════════════════════════════════════════
-- AUTO SLIDE
-- ═══════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    if not Cfg.AutoSlide then return end
    local c = LP.Character
    if not c then return end
    local hum  = GetHum(c)
    local root = GetRoot(c)
    if not hum or not root then return end
    if root.Velocity.Magnitude > 20
    and hum.MoveDirection.Magnitude > 0
    and hum.FloorMaterial ~= Enum.Material.Air then
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
end)

