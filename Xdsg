-- ═══════════════════════════════════════════════════════
-- TEAM DETECTION ENGINE (STRICT)
-- Deteksi team BENERAN, bukan tebak-tebakan
-- ═══════════════════════════════════════════════════════
local TeamCache = {}

local function RefreshTeam()
    TeamCache = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            TeamCache[p] = {
                isEnemy  = false,
                isTeam   = false,
                isFriend = false,
            }
            -- Method 1: Team property
            if LP.Team ~= nil and p.Team ~= nil then
                if p.Team == LP.Team then
                    TeamCache[p].isTeam  = true
                else
                    TeamCache[p].isEnemy = true
                end
            else
                -- Method 2: Team color
                if LP.TeamColor ~= nil and p.TeamColor ~= nil then
                    if p.TeamColor == LP.TeamColor then
                        TeamCache[p].isTeam  = true
                    else
                        TeamCache[p].isEnemy = true
                    end
                else
                    TeamCache[p].isEnemy = true -- default musuh kalau ga ada team info
                end
            end
            -- Friend check
            local ok, res = pcall(function() return LP:IsFriendsWith(p.UserId) end)
            TeamCache[p].isFriend = ok and res or false
        end
    end
end

-- Refresh setiap 3 detik biar akurat
task.spawn(function()
    while true do
        pcall(RefreshTeam)
        task.wait(3)
    end
end)

Players.PlayerAdded:Connect(function() task.wait(1); RefreshTeam() end)
Players.PlayerRemoving:Connect(function(p) TeamCache[p] = nil end)
LP:GetPropertyChangedSignal("Team"):Connect(RefreshTeam)
RefreshTeam()

local function GetRelation(p)
    local t = TeamCache[p]
    if not t then return "enemy" end
    if t.isTeam   then return "team"   end
    if t.isFriend then return "friend" end
    return "enemy"
end

