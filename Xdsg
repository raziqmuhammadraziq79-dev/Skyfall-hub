-- ═══════════════════════════════════════════════════════
-- MAIN RENDER LOOP
-- ═══════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)

    -- Crosshair
    CrossH.From=Vector2.new(center.X-12,center.Y); CrossH.To=Vector2.new(center.X+12,center.Y)
    CrossH.Visible = Cfg.ShowCrosshair
    CrossV.From=Vector2.new(center.X,center.Y-12); CrossV.To=Vector2.new(center.X,center.Y+12)
    CrossV.Visible = Cfg.ShowCrosshair

    -- FOV
    FOVCirc.Position=center; FOVCirc.Radius=Cfg.AimFOV; FOVCirc.Visible=Cfg.ShowFOV

    -- ── AIMBOT ──
    if Cfg.Aimbot then
        AimTarget = FindTarget()
        if AimTarget then
            local c    = GetChar(AimTarget)
            local part = c and (c:FindFirstChild(Cfg.AimPart) or GetRoot(c))
            if part then
                local targetCF = CFrame.new(Camera.CFrame.Position, part.Position)
                if Cfg.AimAssist or Cfg.AutoLock then
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF,
                        Cfg.AimAssist and Cfg.AssistStr or Cfg.AimSmooth)
                end
                MobileShoot()
            end
        end
    else
        AimTarget = nil
    end

    -- ── ESP LOOP ──
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end

        local e = ESPMap[player]
        if not e then continue end

        local rel = GetRelation(player)  -- "enemy" | "team" | "friend"

        -- ── STRICT VISIBILITY ──
        local showESP = Cfg.ESP and (
            (rel == "enemy"  and Cfg.ESP_Enemy)  or
            (rel == "team"   and Cfg.ESP_Team)   or
            (rel == "friend" and Cfg.ESP_Friend)
        )
        local showTrc = Cfg.Tracer and (
            (rel == "enemy"  and Cfg.Tracer_Enemy)  or
            (rel == "team"   and Cfg.Tracer_Team)   or
            (rel == "friend" and Cfg.Tracer_Friend)
        )

        local c    = GetChar(player)
        local hum  = GetHum(c)
        local root = GetRoot(c)

        if not c or not hum or hum.Health <= 0 or not root then
            HideESP(player); continue
        end

        local dist   = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > Cfg.MaxDist then HideESP(player); continue end

        local rootSV, onScreen = W2V(root.Position)

        -- color by relation
        local col    = rel=="enemy" and Cfg.Col_Enemy  or
                       rel=="team"  and Cfg.Col_Team   or Cfg.Col_Friend
        local trcCol = rel=="enemy" and Cfg.Col_Tracer_E or
                       rel=="team"  and Cfg.Col_Tracer_T or Cfg.Col_Tracer_F
        local lblCol = rel=="enemy" and Cfg.Col_Label_E or
                       rel=="team"  and Cfg.Col_Label_T or Cfg.Col_Label_F
        local lblTxt = rel=="enemy" and "[ MUSUH ]" or
                       rel=="team"  and "[ TEMAN ]" or "[ FRIEND ]"

        -- ── OFF-SCREEN ARROW ──
        if not onScreen and showESP then
            local dir   = (rootSV - center).Unit
            local edge  = center + dir * (math.min(center.X, center.Y) * 0.80)
            e.Arrow.PointA = edge + dir * 10
            e.Arrow.PointB = edge + Vector2.new(-dir.Y, dir.X) * 8
            e.Arrow.PointC = edge - Vector2.new(-dir.Y, dir.X) * 8
            e.Arrow.Color  = col
            e.Arrow.Visible= true
        else
            e.Arrow.Visible= false
        end

        if not onScreen then
            for _,v in pairs(e.C) do v.Visible=false end
            e.Name.Visible=false; e.Label.Visible=false
            e.Dist.Visible=false; e.HBG.Visible=false
            e.HBar.Visible=false; e.Tracer.Visible=false
            continue
        end

        -- ── BOX + INFO ──
        if showESP and Cfg.ShowBox then
            local tl, br = BBox2D(c)
            if tl and br then
                local tr = Vector2.new(br.X, tl.Y)
                local bl = Vector2.new(tl.X, br.Y)
                DrawCorner(e.C, tl, tr, bl, br, col)

                -- Health bar
                if Cfg.ShowHealth then
                    local pct = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                    local bH  = br.Y - tl.Y
                    local bx  = tl.X - 7
                    e.HBG.From=Vector2.new(bx,tl.Y); e.HBG.To=Vector2.new(bx,br.Y); e.HBG.Visible=true
                    e.HBar.Color=LerpC(Cfg.Col_HP_Lo, Cfg.Col_HP_Hi, pct)
                    e.HBar.From=Vector2.new(bx,br.Y)
                    e.HBar.To  =Vector2.new(bx,br.Y - bH*pct)
                    e.HBar.Visible=true
                else
                    e.HBG.Visible=false; e.HBar.Visible=false
                end

                local mx = (tl.X+br.X)/2

                -- Name
                if Cfg.ShowName then
                    e.Name.Text    = player.DisplayName
                    e.Name.Position= Vector2.new(mx, tl.Y-16)
                    e.Name.Color   = Cfg.Col_Name
                    e.Name.Visible = true
                else e.Name.Visible=false end

                -- SINYAL MUSUH/TEMAN LABEL
                if Cfg.ShowTeamLabel then
                    e.Label.Text    = lblTxt
                    e.Label.Position= Vector2.new(mx, tl.Y-28)
                    e.Label.Color   = lblCol
                    e.Label.Visible = true
                else e.Label.Visible=false end

                -- Distance
                if Cfg.ShowDist then
                    e.Dist.Text    = string.format("[%dm]", math.floor(dist))
                    e.Dist.Position= Vector2.new(mx, br.Y+3)
                    e.Dist.Color   = Cfg.Col_Dist
                    e.Dist.Visible = true
                else e.Dist.Visible=false end
            end
        else
            for _,v in pairs(e.C) do v.Visible=false end
            e.Name.Visible=false; e.Label.Visible=false
            e.Dist.Visible=false; e.HBG.Visible=false; e.HBar.Visible=false
        end

        -- ── TRACER ──
        if showTrc then
            local oy = Cfg.TracerOrigin=="Bottom" and vp.Y
                    or Cfg.TracerOrigin=="Top"    and 0
                    or vp.Y/2
            e.Tracer.From   = Vector2.new(center.X, oy)
            e.Tracer.To     = rootSV
            e.Tracer.Color  = trcCol
            e.Tracer.Visible= true
        else
            e.Tracer.Visible= false
        end
    end
end)

