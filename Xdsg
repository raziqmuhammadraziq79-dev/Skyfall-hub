local ESPMap = {}

local function MakeESP(p)
    local e = {
        C      = {},   -- 8 corner lines
        Name   = D("Text",     {Size=13, Font=2, Center=true, Outline=true, ZIndex=7, Visible=false}),
        Label  = D("Text",     {Size=11, Font=2, Center=true, Outline=true, ZIndex=7, Visible=false}),
        Dist   = D("Text",     {Size=11, Font=2, Center=true, Outline=true, ZIndex=7, Visible=false}),
        HBG    = D("Line",     {Thickness=5, Color=Color3.new(0,0,0), ZIndex=5, Visible=false}),
        HBar   = D("Line",     {Thickness=5, ZIndex=6, Visible=false}),
        Tracer = D("Line",     {Thickness=1.4, ZIndex=5, Visible=false}),
        Arrow  = D("Triangle", {Filled=true, ZIndex=8, Visible=false}),
    }
    for i=1,8 do
        e.C[i] = D("Line", {Thickness=1.8, ZIndex=6, Visible=false})
    end
    ESPMap[p] = e
end

local function HideESP(p)
    local e = ESPMap[p]
    if not e then return end
    for _,v in pairs(e.C) do v.Visible=false end
    e.Name.Visible=false; e.Label.Visible=false
    e.Dist.Visible=false; e.HBG.Visible=false
    e.HBar.Visible=false; e.Tracer.Visible=false
    e.Arrow.Visible=false
end

local function DestroyESP(p)
    local e = ESPMap[p]
    if not e then return end
    for _,v in pairs(e.C) do Kill(v) end
    Kill(e.Name); Kill(e.Label); Kill(e.Dist)
    Kill(e.HBG);  Kill(e.HBar);  Kill(e.Tracer); Kill(e.Arrow)
    ESPMap[p] = nil
end

-- ═══════════════════════════════════════════════════════
-- CORNER BOX
-- ═══════════════════════════════════════════════════════
local function DrawCorner(C, tl, tr, bl, br, col)
    local cw = (tr.X-tl.X)*0.22
    local ch = (bl.Y-tl.Y)*0.22
    C[1].From=tl;           C[1].To=tl+Vector2.new(cw,0);  C[1].Color=col; C[1].Visible=true
    C[2].From=tl;           C[2].To=tl+Vector2.new(0,ch);  C[2].Color=col; C[2].Visible=true
    C[3].From=tr;           C[3].To=tr-Vector2.new(cw,0);  C[3].Color=col; C[3].Visible=true
    C[4].From=tr;           C[4].To=tr+Vector2.new(0,ch);  C[4].Color=col; C[4].Visible=true
    C[5].From=bl;           C[5].To=bl+Vector2.new(cw,0);  C[5].Color=col; C[5].Visible=true
    C[6].From=bl;           C[6].To=bl-Vector2.new(0,ch);  C[6].Color=col; C[6].Visible=true
    C[7].From=br;           C[7].To=br-Vector2.new(cw,0);  C[7].Color=col; C[7].Visible=true
    C[8].From=br;           C[8].To=br-Vector2.new(0,ch);  C[8].Color=col; C[8].Visible=true
end

-- ═══════════════════════════════════════════════════════
-- AIMBOT ENGINE
-- ═══════════════════════════════════════════════════════
local AimTarget  = nil
local LastShot   = 0

local function FindTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local bestD  = Cfg.AimFOV
    local bestP  = nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and GetRelation(p) == "enemy" then
            local c   = GetChar(p)
            local hum = GetHum(c)
            if c and hum and hum.Health > 0 then
                local part = c:FindFirstChild(Cfg.AimPart) or GetRoot(c)
                if part then
                    local sv, on = W2V(part.Position)
                    if on then
                        local d = (sv-center).Magnitude
                        if d < bestD then
                            bestD = d
                            bestP = p
                        end
                    end
                end
            end
        end
    end
    return bestP
end

-- ═══════════════════════════════════════════════════════
-- SILENT AIM HOOK
-- ═══════════════════════════════════════════════════════
pcall(function()
    local mt  = getrawmetatable(game)
    local old = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, key)
        if key == "Hit" and self == LP:GetMouse() then
            if Cfg.SilentAim and Cfg.Aimbot and AimTarget then
                local c    = GetChar(AimTarget)
                local part = c and (c:FindFirstChild(Cfg.AimPart) or GetRoot(c))
                if part then return CFrame.new(part.Position) end
            end
        end
        return old(self, key)
    end)
    setreadonly(mt, true)
end)

-- ═══════════════════════════════════════════════════════
-- AUTO SHOOT — MOBILE SAFE
-- Gunakan VirtualUser:CaptureController() style
-- atau fireproximityprompt, atau tool:Activate()
-- ═══════════════════════════════════════════════════════
local function MobileShoot()
    if not Cfg.AutoShoot or not AimTarget then return end
    local now = tick()
    if now - LastShot < Cfg.ShootDelay then return end
    LastShot = now

    local c   = GetChar(AimTarget)
    local hum = GetHum(c)
    if not c or not hum or hum.Health <= 0 then return end

    -- Method 1: Tool:Activate (paling kompatibel mobile)
    pcall(function()
        local char = LP.Character
        if not char then return end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                -- Fire remote event yang biasanya dipake FPS games
                local remote = tool:FindFirstChild("RemoteEvent")
                        or tool:FindFirstChild("Fire")
                        or tool:FindFirstChild("Shoot")
                if remote and remote:IsA("RemoteEvent") then
                    local part = GetChar(AimTarget) and
                                 (GetChar(AimTarget):FindFirstChild(Cfg.AimPart)
                                  or GetRoot(GetChar(AimTarget)))
                    if part then
                        remote:FireServer(part.Position)
                    end
                end
                -- Fallback: tool activate
                tool:Activate()
            end
        end
    end)

    -- Method 2: VirtualUser button press (Delta mobile support)
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(
            Camera.ViewportSize.X/2,
            Camera.ViewportSize.Y/2
        ), CFrame.new())
        task.delay(0.05, function()
            pcall(function()
                VirtualUser:Button1Up(Vector2.new(
                    Camera.ViewportSize.X/2,
                    Camera.ViewportSize.Y/2
                ), CFrame.new())
            end)
        end)
    end)
end

