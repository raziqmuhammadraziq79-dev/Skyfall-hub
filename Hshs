local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

-- CONFIG
local CONFIG = {
    ESP_ENABLED = false,
    AIMBOT_ENABLED = false,
    TRACER_ENABLED = false,
    LOCK_HEAD = true,
    AUTO_LOCK_NEAREST = true,
    SMOOTH_AIM = 0.1,
    MAX_DISTANCE = 500,
    PANEL_X = 20,
    PANEL_Y = 20
}

local LocalPlayer = Players.LocalPlayer
local LocalCharacter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local EnemyList = {}
local CurrentLockTarget = nil

-- ============================================
-- UTILITY FUNCTIONS
-- ============================================

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if not player.Character:FindFirstChild("Humanoid") then return false end
    if not player.Character:FindFirstChild("HumanoidRootPart") then return false end
    
    -- Ignore team (jika ada sistem team)
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    
    return true
end

local function GetDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function GetScreenPosition(worldPos)
    local screenPos, onScreen = Camera:WorldToScreenPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function CreateESPLabel(player)
    local label = Instance.new("BillboardGui")
    label.Name = "ESP_" .. player.Name
    label.Size = UDim2.new(4, 0, 2, 0)
    label.MaxDistance = CONFIG.MAX_DISTANCE
    label.Parent = player.Character.HumanoidRootPart
    
    local textLabel = Instance.new("TextLabel")
    textLabel.BackgroundTransparency = 1
    textLabel.TextScaled = true
    textLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = label
    
    return label, textLabel
end

local function UpdateESP()
    if not CONFIG.ESP_ENABLED then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if IsEnemy(player) then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local humanoid = char:FindFirstChild("Humanoid")
                local distance = GetDistance(LocalCharacter.HumanoidRootPart.Position, hrp.Position)
                
                -- Cek atau buat ESP label
                local espLabel = hrp:FindFirstChild("ESP_" .. player.Name)
                if not espLabel then
                    espLabel, _ = CreateESPLabel(player)
                end
                
                local textLabel = espLabel:FindFirstChild("TextLabel")
                if textLabel then
                    local health = humanoid and humanoid.Health or 0
                    textLabel.Text = string.format("%s\n%.0fm\nHP: %.0f", 
                        player.Name, distance, health)
                    textLabel.TextColor3 = health > 50 and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                end
            end
        end
    end
end

local function UpdateTracer()
    if not CONFIG.TRACER_ENABLED then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if IsEnemy(player) then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local targetPos = char.HumanoidRootPart.Position
                local cameraPos = Camera.CFrame.Position
                
                -- Draw line dari camera ke target (sederhana)
                local line = Instance.new("Part")
                line.Shape = Enum.PartType.Cylinder
                line.Material = Enum.Material.Neon
                line.Color = Color3.fromRGB(255, 255, 0)
                line.CanCollide = false
                line.CFrame = CFrame.new((cameraPos + targetPos) / 2, targetPos)
                line.Size = Vector3.new(0.2, (cameraPos - targetPos).Magnitude, 0.2)
                line.Parent = workspace
                
                game:GetService("Debris"):AddItem(line, 0.016) -- Remove next frame
            end
        end
    end
end

local function FindNearestEnemy()
    local nearest = nil
    local minDistance = CONFIG.MAX_DISTANCE
    
    for _, player in pairs(Players:GetPlayers()) do
        if IsEnemy(player) then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local distance = GetDistance(LocalCharacter.HumanoidRootPart.Position, 
                    char.HumanoidRootPart.Position)
                
                if distance < minDistance then
                    minDistance = distance
                    nearest = player
                end
            end
        end
    end
    
    return nearest
end

local function GetAimPosition(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return nil end
    
    local char = targetPlayer.Character
    local head = char:FindFirstChild("Head")
    
    if CONFIG.LOCK_HEAD and head then
        return head.Position
    else
        local hrp = char:FindFirstChild("HumanoidRootPart")
        return hrp and hrp.Position or nil
    end
end

local function UpdateAimbot()
    if not CONFIG.AIMBOT_ENABLED then 
        CurrentLockTarget = nil
        return 
    end
    
    -- Auto lock nearest
    if CONFIG.AUTO_LOCK_NEAREST then
        CurrentLockTarget = FindNearestEnemy()
    end
    
    if CurrentLockTarget and CurrentLockTarget.Character then
        local targetPos = GetAimPosition(CurrentLockTarget)
        if targetPos then
            local cameraPos = Camera.CFrame.Position
            local direction = (targetPos - cameraPos).Unit
            
            -- Smooth aim
            local newCFrame = CFrame.new(cameraPos, cameraPos + direction)
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, CONFIG.SMOOTH_AIM)
        end
    end
end

-- ============================================
-- TOGGLE PANEL UI
-- ============================================

local function CreateTogglePanel()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "AimbotPanel"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    
    local panelFrame = Instance.new("Frame")
    panelFrame.Name = "Panel"
    panelFrame.Size = UDim2.new(0, 200, 0, 150)
    panelFrame.Position = UDim2.new(0, CONFIG.PANEL_X, 0, CONFIG.PANEL_Y)
    panelFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    panelFrame.BorderSizePixel = 2
    panelFrame.BorderColor3 = Color3.fromRGB(255, 0, 0)
    panelFrame.Parent = screenGui
    
    -- Title
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, 0, 0, 25)
    title.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Text = "AIMBOT PANEL"
    title.Font = Enum.Font.GothamBold
    title.TextScaled = true
    title.Parent = panelFrame
    
    -- ESP Toggle
    local espBtn = Instance.new("TextButton")
    espBtn.Name = "ESP_Toggle"
    espBtn.Size = UDim2.new(1, -10, 0, 25)
    espBtn.Position = UDim2.new(0, 5, 0, 30)
    espBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    espBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
    espBtn.Text = "ESP: OFF"
    espBtn.Font = Enum.Font.Gotham
    espBtn.TextScaled = true
    espBtn.Parent = panelFrame
    
    espBtn.MouseButton1Click:Connect(function()
        CONFIG.ESP_ENABLED = not CONFIG.ESP_ENABLED
        espBtn.Text = CONFIG.ESP_ENABLED and "ESP: ON" or "ESP: OFF"
        espBtn.TextColor3 = CONFIG.ESP_ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)
    
    -- AIMBOT Toggle
    local aimbotBtn = Instance.new("TextButton")
    aimbotBtn.Name = "Aimbot_Toggle"
    aimbotBtn.Size = UDim2.new(1, -10, 0, 25)
    aimbotBtn.Position = UDim2.new(0, 5, 0, 60)
    aimbotBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    aimbotBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
    aimbotBtn.Text = "AIMBOT: OFF"
    aimbotBtn.Font = Enum.Font.Gotham
    aimbotBtn.TextScaled = true
    aimbotBtn.Parent = panelFrame
    
    aimbotBtn.MouseButton1Click:Connect(function()
        CONFIG.AIMBOT_ENABLED = not CONFIG.AIMBOT_ENABLED
        aimbotBtn.Text = CONFIG.AIMBOT_ENABLED and "AIMBOT: ON" or "AIMBOT: OFF"
        aimbotBtn.TextColor3 = CONFIG.AIMBOT_ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)
    
    -- TRACER Toggle
    local tracerBtn = Instance.new("TextButton")
    tracerBtn.Name = "Tracer_Toggle"
    tracerBtn.Size = UDim2.new(1, -10, 0, 25)
    tracerBtn.Position = UDim2.new(0, 5, 0, 90)
    tracerBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    tracerBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
    tracerBtn.Text = "TRACER: OFF"
    tracerBtn.Font = Enum.Font.Gotham
    tracerBtn.TextScaled = true
    tracerBtn.Parent = panelFrame
    
    tracerBtn.MouseButton1Click:Connect(function()
        CONFIG.TRACER_ENABLED = not CONFIG.TRACER_ENABLED
        tracerBtn.Text = CONFIG.TRACER_ENABLED and "TRACER: ON" or "TRACER: OFF"
        tracerBtn.TextColor3 = CONFIG.TRACER_ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)
    
    -- Drag functionality
    local dragging = false
    local dragInput, dragStart, startPos
    
    panelFrame.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = panelFrame.Position
        end
    end)
    
    panelFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            panelFrame.Position = startPos + UDim2.new(0, delta.X, 0, delta.Y)
        end
    end)
end

-- ============================================
-- MAIN LOOP
-- ============================================

RunService.RenderStepped:Connect(function()
    if not LocalCharacter or not LocalCharacter:FindFirstChild("HumanoidRootPart") then
        LocalCharacter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        return
    end
    
    UpdateESP()
    UpdateAimbot()
    UpdateTracer()
end)

-- Handle character respawn
LocalPlayer.CharacterAdded:Connect(function(char)
    LocalCharacter = char
end)

-- Create panel on startup
CreateTogglePanel()

print("✓ AIMBOT LOADED - Panel ready")
