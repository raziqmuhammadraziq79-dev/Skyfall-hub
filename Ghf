local function UpdateESP()
    for Plr, d in pairs(ESPD) do
        -- ⚠️ KALAU PLAYER KELUAR ATAU UDAH BUKAN MUSUH → HAPUS ⚠️
        if not Plr.Parent or not IsEnemy(Plr) then
            S(function()
                for _, v in pairs(d) do
                    if type(v) == "userdata" then v:Remove() end
                end
            end)
            ESPD[Plr] = nil
            continue
        end

        local c = GetChar(Plr)
        if not c or not C.ESP.On then
            for _, v in pairs(d) do
                if type(v) == "userdata" and v.Visible then v.Visible = false end
            end
            continue
        end

        local hd = GetHead(c); local rt = GetRoot(c); local hu = GetHum(c)
        if not hd or not rt or not hu then continue end

        local hp, hs = W2S(hd.Position); local rp, rs = W2S(rt.Position)
        if not hs and not rs then
            for _, v in pairs(d) do if type(v) == "userdata" then v.Visible = false end end
            continue
        end

        local dist = Dist3D(rt.Position)
        if dist > C.ESP.MaxDist then
            for _, v in pairs(d) do if type(v) == "userdata" then v.Visible = false end end
            continue
        end

        local sc = math.clamp(1 / (dist * 0.001), 0.2, 3)
        local bh = 300 * sc; local bw = 180 * sc; local cl = bh * 0.22
        local cx = rp.X; local ty = hp.Y - bh * 0.35; local by = rp.Y + bh * 0.15
        local lx = cx - bw / 2; local rx = cx + bw / 2
        local TL = Vector2.new(lx, ty); local TR = Vector2.new(rx, ty)
        local BL = Vector2.new(lx, by); local BR = Vector2.new(rx, by)

        if C.ESP.Box then
            d[1].Visible = true; d[1].From = TL; d[1].To = TL + Vector2.new(cl, 0)
            d[2].Visible = true; d[2].From = TL; d[2].To = TL + Vector2.new(0, cl)
            d[3].Visible = true; d[3].From = TR; d[3].To = TR - Vector2.new(cl, 0)
            d[4].Visible = true; d[4].From = TR; d[4].To = TR + Vector2.new(0, cl)
            d[5].Visible = true; d[5].From = BL; d[5].To = BL + Vector2.new(cl, 0)
            d[6].Visible = true; d[6].From = BL; d[6].To = BL - Vector2.new(0, cl)
            d[7].Visible = true; d[7].From = BR; d[7].To = BR - Vector2.new(cl, 0)
            d[8].Visible = true; d[8].From = BR; d[8].To = BR - Vector2.new(0, cl)
        else
            for i = 1, 8 do if d[i] then d[i].Visible = false end end
        end

        if C.ESP.HeadDot and d.HDot then
            d.HDot.Visible = hs
            if hs then d.HDot.Position = hp; d.HDot.Radius = math.clamp(30 / (dist * 0.01), 3, 7) end
        end
        if C.ESP.Name and d.Name then
            d.Name.Visible = true; d.Name.Text = Plr.Name; d.Name.Position = Vector2.new(cx, ty - 18)
        end
        if C.ESP.Dist and d.Dist then
            d.Dist.Visible = true; d.Dist.Text = math.floor(dist) .. "m"; d.Dist.Position = Vector2.new(cx, by + 12)
        end
        if C.ESP.HP and d.HBg and d.HBar then
            local hpct = math.clamp(hu.Health / hu.MaxHealth, 0, 1)
            local bx = lx - 10; local bw2 = 3; local bht = by - ty
            d.HBg.Visible = true; d.HBg.Position = Vector2.new(bx, ty); d.HBg.Size = Vector2.new(bw2, bht)
            local fh = bht * hpct
            d.HBar.Visible = true; d.HBar.Position = Vector2.new(bx, by - fh); d.HBar.Size = Vector2.new(bw2, fh)
            d.HBar.Color = hpct > 0.7 and Color3.fromRGB(0, 255, 60) or (hpct > 0.4 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 30, 30))
        end
        if C.ESP.Wpn and d.Wpn then
            d.Wpn.Visible = true; d.Wpn.Text = GetTool(c); d.Wpn.Position = Vector2.new(cx, by + 26)
        end
    end
end

