-- ============================================
-- AIMBOT (ONLY ENEMY)
-- ============================================
local function FindAimTarget()
    local mp = TouchPos
    local best = nil; local bestD = C.Aimbot.FOV
    for _, Plr in ipairs(Players:GetPlayers()) do
        -- ⚠️ HANYA MUSUH ⚠️
        if not IsEnemy(Plr) then continue end
        local c = GetChar(Plr)
        if not c then continue end
        local ap = c:FindFirstChild(C.Aimbot.Part)
        if not ap then continue end
        if Dist3D(ap.Position) > C.Aimbot.MaxDist then continue end
        local sp, on = W2S(ap.Position)
        if not on then continue end
        local d2 = (sp - mp).Magnitude
        if d2 < bestD then bestD = d2; best = {Plr = Plr, Part = ap, Pos = ap.Position, Vel = ap.Velocity} end
    end
    return best
end

local function UpdateAimbot()
    if not C.Aimbot.On then IsAiming = false; return end
    local t = FindAimTarget()
    if not t then IsAiming = false; return end
    IsAiming = true
    local tp = t.Pos
    if C.Aimbot.Predict and t.Vel.Magnitude > 3 then
        tp = tp + t.Vel * (Dist3D(t.Pos) / 3000) * 0.13
    end
    local cp = Camera.CFrame.Position
    local dd = (tp - cp).Unit
    local cd = Camera.CFrame.LookVector
    Camera.CFrame = CFrame.new(cp, cp + cd:Lerp(dd, C.Aimbot.Smooth))
    if C.Aimbot.AutoShoot then
        local now = tick()
        if now - LastShot >= C.Aimbot.ShootDelay then FireWeapon(); LastShot = now end
    end
end

-- ============================================
-- TRIGGERBOT (ONLY ENEMY)
-- ============================================
local function UpdateTrigger()
    if not C.Trigger.On then return end
    if IsAiming and C.Aimbot.AutoShoot then return end
    if not IsTouching then return end
    local mp = TouchPos
    for _, Plr in ipairs(Players:GetPlayers()) do
        -- ⚠️ HANYA MUSUH ⚠️
        if not IsEnemy(Plr) then continue end
        local c = GetChar(Plr); local hd = GetHead(c)
        if not hd then continue end
        local sp, on = W2S(hd.Position)
        if not on then continue end
        if (sp - mp).Magnitude <= C.Trigger.FOV then
            local now = tick()
            if now - LastShot >= C.Trigger.Delay then FireWeapon(); LastShot = now; return end
        end
    end
end

-- ============================================
-- AIM ASSIST (ONLY ENEMY)
-- ============================================
local function UpdateAssist()
    if not C.Assist.On or IsAiming then return end
    if not IsTouching then return end
    local mp = TouchPos
    local best = nil; local bestD = C.Assist.FOV
    for _, Plr in ipairs(Players:GetPlayers()) do
        -- ⚠️ HANYA MUSUH ⚠️
        if not IsEnemy(Plr) then continue end
        local c = GetChar(Plr); local hd = GetHead(c)
        if not hd then continue end
        local sp, on = W2S(hd.Position)
        if not on then continue end
        local d2 = (sp - mp).Magnitude
        if d2 < bestD then bestD = d2; best = sp end
    end
    if best then
        local delta = best - mp
        local moveX = delta.X * C.Assist.Str * C.Assist.Sm
        local moveY = delta.Y * C.Assist.Str * C.Assist.Sm
        local currentCF = Camera.CFrame
        local yaw = math.rad(-moveX * 0.1)
        local pitch = math.rad(-moveY * 0.1)
        Camera.CFrame = currentCF * CFrame.Angles(pitch, yaw, 0)
    end
end

