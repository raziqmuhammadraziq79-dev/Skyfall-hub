local function EnableBHop()
    if BHopConn then return end
    BHopConn = UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if not C.Move.BHOP or inp.KeyCode ~= Enum.KeyCode.Space then return end
        local c = GetChar(LocalPlayer); if not c then return end
        local h = GetHum(c); if not h or h.FloorMaterial == Enum.Material.Air then return end
        h:ChangeState(Enum.HumanoidStateType.Jumping)
        if C.Move.Strafe and h.MoveDirection.Magnitude > 0 then
            local r = GetRoot(c)
            if r then r.Velocity = r.Velocity + h.MoveDirection * C.Move.Spd * 0.5 end
        end
    end)
end
