local function GetChar(Plr) return Plr and Plr.Character end
local function GetRoot(C) return C and C:FindFirstChild("HumanoidRootPart") end
local function GetHead(C) return C and C:FindFirstChild("Head") end
local function GetHum(C) return C and C:FindFirstChildOfClass("Humanoid") end

-- ⚠️ INI FILTER UTAMA — HANYA MUSUH ⚠️
local function IsEnemy(Plr)
    -- BUKAN player
    if not Plr then return false end
    -- BUKAN diri sendiri
    if Plr == LocalPlayer then return false end
    -- BUKAN teman satu tim
    if LocalPlayer.Team and Plr.Team == LocalPlayer.Team then return false end
    -- Karakter ada?
    local c = GetChar(Plr)
    if not c then return false end
    -- Masih hidup?
    local h = GetHum(c)
    if not h or h.Health <= 0 then return false end
    return true
end

local function Dist3D(Pos)
    return Camera and (Camera.CFrame.Position - Pos).Magnitude or 99999
end

local function W2S(Pos)
    local v, on = Camera:WorldToViewportPoint(Pos)
    return Vector2.new(v.X, v.Y), on
end

local function GetTool(Char)
    if not Char then return "HANDS" end
    for _, o in ipairs(Char:GetChildren()) do
        if o:IsA("Tool") then return o.Name end
    end
    return "HANDS"
end

