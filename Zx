-- ================= ADVANCED ESP ENGINE =================
function InitESP(Player)
    if Player == LocalPlayer then return end
    
    local Diamond = Drawing.new("Square")
    Diamond.Thickness = 2.5
    Diamond.Filled = false
    
    local Tracer = Drawing.new("Line")
    Tracer.Thickness = 2
    
    local NameTag = Drawing.new("Text")
    NameTag.Size = 14
    NameTag.Center = true
    NameTag.Outline = true
    
    ESP_Data[Player] = {
        Diamond = Diamond,
        Tracer = Tracer,
        NameTag = NameTag,
        Root = nil
    }
end

function RenderOmega()
    if not Config.Active then
        FOV_Circle.Visible = false
        for _, D in pairs(ESP_Data) do
            D.Diamond.Visible = false
            D.Tracer.Visible = false
            D.NameTag.Visible = false
        end
        return
    end

    FOV_Circle.Visible = true
    FOV_Circle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    local TargetCount = 0

    for Player, Data in pairs(ESP_Data) do
        if Player.Character then
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            local Head = Player.Character:FindFirstChild("Head")
            
            if Root and Head then
                Data.Root = Root
                local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                
                if OnScreen then
                    TargetCount = TargetCount + 1
                    local Dist = (Camera.CFrame.Position - Root.Position).Magnitude
                    local Size = math.clamp(700 / Dist, 15, 120)
                    
                    -- Pulse Effect Calculation
                    local Pulse = math.sin(tick() * Config.PulseSpeed) * 2
                    
                    Data.Diamond.Size = Vector2.new(Size + Pulse, Size + Pulse)
                    Data.Diamond.Position = Vector2.new(Pos.X - (Size/2), Pos.Y - (Size/2))
                    
                    -- Color & Transparency Logic
                    local IsEnemy = not (LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team)
                    local BaseColor = IsEnemy and Config.ColorEnemy or Config.ColorTeam
                    
                    -- Distance Fade
                    local Transparency = math.clamp(1 - (Dist / 500), 0.2, 1)
                    
                    Data.Diamond.Color = BaseColor
                    Data.Diamond.Transparency = Transparency
                    Data.Tracer.Color = BaseColor
                    Data.Tracer.Transparency = Transparency
                    Data.NameTag.Color = BaseColor
                    
                    -- Tracer & Name
                    Data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    Data.Tracer.To = Vector2.new(Pos.X, Pos.Y)
                    Data.Tracer.Visible = true
                    
                    Data.NameTag.Text = Player.Name .. " [" .. math.floor(Dist) .. "m]"
                    Data.NameTag.Position = Vector2.new(Pos.X, Pos.Y - Size/2 - 15)
                    Data.NameTag.Visible = true
                    Data.Diamond.Visible = true
                else
                    Data.Diamond.Visible = false
                    Data.Tracer.Visible = false
                    Data.NameTag.Visible = false
                end
            end
        end
    end
    Status.Text = "Tracking: " .. TargetCount .. " Targets"
end

-- ================= HYPER ACCURATE AIMBOT =================
function ExecuteAimbot()
    if not Config.AimbotActive or not IsOn then return end
    
    local ClosestDist = math.huge
    local TargetHead = nil
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local Head = Player.Character:FindFirstChild("Head")
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            
            if Head and Root then
                local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local Dist2D = (Vector2.new(Pos.X, Pos.Y) - Center).Magnitude
                
                local IsEnemy = not (LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team)
                
                if Dist2D < FOV_Circle.Radius and IsEnemy and OnScreen then
                    local Dist3D = (Camera.CFrame.Position - Root.Position).Magnitude
                    if Dist3D < ClosestDist then
                        ClosestDist = Dist3D
                        TargetHead = Head
                    end
                end
            end
        end
    end
    
    if TargetHead then
        local TargetPos = TargetHead.Position
        local CurrentCF = Camera.CFrame
        -- Direct CFrame Manipulation for "Super Fast" feel
        Camera.CFrame = CFrame.new(CurrentCF.Position, TargetPos)
    end
end

-- ================= EVENT HANDLERS =================
Players.PlayerAdded:Connect(function(P)
    P.CharacterAdded:Connect(function()
        task.wait(0.2)
        InitESP(P)
    end)
    if P.Character then InitESP(P) end
end)

Players.PlayerRemoving:Connect(function(P)
    if ESP_Data[P] then
        for _, Obj in pairs(ESP_Data[P]) do if Obj.Remove then Obj:Remove() end end
        ESP_Data[P] = nil
    end
end)

for _, P in pairs(Players:GetPlayers()) do if P.Character then InitESP(P) end end

-- ================= MAIN RENDER LOOP =================
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera
    RenderOmega()
    ExecuteAimbot()
end)

