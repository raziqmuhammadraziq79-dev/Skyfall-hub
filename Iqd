-- // UTILITY
local function GetCharacter(player)
    return player and player.Character
end

local function GetRootPart(player)
    local char = GetCharacter(player)
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
end

local function GetHead(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChild("Head")
end

local function GetHumanoid(player)
    local char = GetCharacter(player)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local hum = GetHumanoid(player)
    return hum and hum.Health > 0
end

local function ScreenDistance(worldPos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    if onScreen then
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        return (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude, screenPos
    end
    return math.huge, nil
end

-- // TARGET RESOLVER
local function ResolveTarget()
    local uname = State.TargetUsername:lower():gsub("%s+", "")
    local best = nil
    local bestDist = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not IsAlive(p) then continue end

        local pname = p.Name:lower()
        local pdisp = p.DisplayName:lower()

        local nameMatch = (uname ~= "" and (pname:find(uname, 1, true) or pdisp:find(uname, 1, true)))

        local part = State.AutoHead and GetHead(p) or GetRootPart(p)
        if not part then continue end

        local dist, screenPos = ScreenDistance(part.Position)

        if uname ~= "" then
            if nameMatch then
                if dist < bestDist then
                    bestDist = dist
                    best = p
                end
            end
        else
            if dist < State.FOV and dist < bestDist then
                bestDist = dist
                best = p
            end
        end
    end

    return best
end

-- // SILENT AIMBOT CORE
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if State.AimbotEnabled and State.SilentAim and method == "FindPartOnRayWithIgnoreList" then
        local target = State.LockedTarget
        if target and IsAlive(target) then
            local part = State.AutoHead and GetHead(target) or GetRootPart(target)
            if part then
                local fakeRay = Ray.new(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000)
                args[1] = fakeRay
                return OldNamecall(self, table.unpack(args))
            end
        end
    end

    return OldNamecall(self, table.unpack(args))
end)

-- // CAMERA LOCK (Hard Snap)
RunService.RenderStepped:Connect(function()
    State.LockedTarget = ResolveTarget()

    if State.AimbotEnabled and State.LockedTarget then
        local target = State.LockedTarget
        local part = State.AutoHead and GetHead(target) or GetRootPart(target)
        if part then
            local targetPos = part.Position
            local currentCF = Camera.CFrame
            local direction = (targetPos - currentCF.Position).Unit
            local targetCF = CFrame.lookAt(currentCF.Position, currentCF.Position + direction)
            Camera.CFrame = currentCF:Lerp(targetCF, State.Smoothness)
        end
    end
end)

-- // ESP
local ESPFolder = Instance.new("Folder", Workspace)
ESPFolder.Name = "OnyxESP"

local function ClearESP()
    for _, v in ipairs(ESPFolder:GetChildren()) do
        v:Destroy()
    end
end

local function DrawESP(player)
    if player == LocalPlayer then return end
    local char = GetCharacter(player)
    if not char then return end

    local box = Instance.new("SelectionBox")
    box.Color3 = Color3.fromRGB(255, 0, 0)
    box.LineThickness = 0.05
    box.SurfaceTransparency = 0.7
    box.SurfaceColor3 = Color3.fromRGB(255, 0, 0)
    box.Adornee = char
    box.Parent = ESPFolder
    box.Name = player.Name .. "_ESP"
end

RunService.Heartbeat:Connect(function()
    if not State.ESPEnabled then
        ClearESP()
        return
    end
    ClearESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if IsAlive(p) then
            DrawESP(p)
        end
    end
end)

-- // INFINITE AMMO
local function PatchAmmo()
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then
            local n = v.Name:lower()
            if n:find("ammo") or n:find("bullet") or n:find("mag") or n:find("clip") then
                v.Value = 9999
                v.Changed:Connect(function()
                    if State.InfAmmo then
                        v.Value = 9999
                    end
                end)
            end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and State.InfAmmo then
            task.wait(0.3)
            PatchAmmo()
        end
    end)
end)

-- // TELEPORT TO PLAYER
local function TeleportToUsername(name)
    local n = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if p.Name:lower():find(n, 1, true) or p.DisplayName:lower():find(n, 1, true) then
            local root = GetRootPart(LocalPlayer)
            local targetRoot = GetRootPart(p)
            if root and targetRoot then
                root.CFrame = targetRoot.CFrame + Vector3.new(2, 0, 0)
                return true, p.Name
            end
        end
    end
    return false, nil
end

