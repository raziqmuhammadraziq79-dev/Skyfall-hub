local Tracer = {}

function Tracer:CreateBeam(Player)
    if TracerBeams[Player] then return end
    
    local Character = Player.Character
    if not Character then return end
    if not Character:FindFirstChild("Head") then return end
    
    local Attachment0 = Instance.new("Attachment")
    Attachment0.Name = "PROJAXX_TracerAttach"
    Attachment0.Parent = Character.Head
    
    local Beam = Instance.new("Beam")
    Beam.Name = "PROJAXX_Tracer"
    Beam.Attachment0 = Attachment0
    Beam.Width0 = 0.3
    Beam.Width1 = 0.15
    Beam.FaceCamera = true
    Beam.Parent = Attachment0
    
    TracerBeams[Player] = {Beam = Beam, Attachment = Attachment0}
end

function Tracer:Update()
    for Player, TracerData in pairs(TracerBeams) do
        if not Player.Parent or not Player.Character then
            Tracer:Remove(Player)
            continue
        end
        
        local Character = Player.Character
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        
        if not Humanoid or Humanoid.Health <= 0 then
            TracerData.Beam.Enabled = false
            continue
        end
        
        TracerData.Beam.Enabled = Config.Tracer.Enabled and Config.ESP.Enabled
        
        if Config.Tracer.Enabled and Config.ESP.Enabled then
            if Config.Tracer.Rainbow then
                local Hue = (tick() * 2) % 1
                TracerData.Beam.Color = ColorSequence.new(Color3.fromHSV(Hue, 1, 1))
            else
                TracerData.Beam.Color = ColorSequence.new(Config.Tracer.Color)
            end
            
            TracerData.Beam.Transparency = NumberSequence.new(Config.Tracer.Transparency)
            
            -- Set destination to camera position (or gun position)
            if Camera then
                local GunPos = Camera.CFrame.Position
                -- Beam needs Attachment1 (destination)
                if not TracerData.Beam.Attachment1 then
                    local Attach1 = Instance.new("Attachment")
                    Attach1.Name = "DestAttach"
                    Attach1.Parent = Camera
                    TracerData.Beam.Attachment1 = Attach1
                end
                if TracerData.Beam.Attachment1 then
                    TracerData.Beam.Attachment1.WorldPosition = GunPos
                end
            end
        end
    end
end

function Tracer:Remove(Player)
    local TracerData = TracerBeams[Player]
    if not TracerData then return end
    if TracerData.Beam then TracerData.Beam:Destroy() end
    if TracerData.Attachment then TracerData.Attachment:Destroy() end
    TracerBeams[Player] = nil
end

