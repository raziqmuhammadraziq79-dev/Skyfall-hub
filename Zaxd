--====================================--
local Aimbot = {}

function Aimbot:GetTarget()
    local Closest = nil
    local MinDist = Config.Aimbot.FOVRadius
    local MousePos = UserInputService:GetMouseLocation()
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if not IsEnemy(Player) then continue end
        if not Player.Character then continue end
        
        local TargetPart = Player.Character:FindFirstChild(Config.Aimbot.AimPart)
        if not TargetPart then continue end
        
        local Humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then continue end
        
        local Dist = (Camera.CFrame.Position - TargetPart.Position).Magnitude
        if Dist > Config.Aimbot.MaxDistance then continue end
        
        if Config.Aimbot.CheckIfVisible and not IsVisible(TargetPart) then continue end
        
        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)
        if not OnScreen then continue end
        
        local ScreenDist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos).Magnitude
        
        if ScreenDist < MinDist then
            MinDist = ScreenDist
            Closest = {Player = Player, Part = TargetPart, Position = TargetPart.Position}
        end
    end
    
    return Closest
end

function Aimbot:Update()
    if not Config.Aimbot.Enabled then return end
    if not UserInputService:IsKeyDown(Config.Aimbot.AimKey) then return end
    
    local Target = Aimbot:GetTarget()
    if not Target then return end
    
    local TargetPos = Target.Position
    
    -- Prediction
    if Config.Aimbot.Prediction and Target.Player.Character then
        local Velocity = Target.Part.Velocity
        TargetPos = TargetPos + (Velocity * Config.Aimbot.PredictionAmount)
    end
    
    local CameraCFrame = Camera.CFrame
    local LookAt = CFrame.new(CameraCFrame.Position, TargetPos)
    Camera.CFrame = CameraCFrame:Lerp(LookAt, Config.Aimbot.Smoothness)
    
    -- Auto Shoot
    if Config.Triggerbot.Enabled and Config.Triggerbot.AutoShoot then
        local Now = tick()
        if Now - LastShot >= Config.Triggerbot.Delay / 1000 then
            -- Simulate mouse click
            mouse1press()
            wait(0.05)
            mouse1release()
            LastShot = Now
        end
    end
end

