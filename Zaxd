local function GetDistance(Player)
    if not Player or not Player.Character then return math.huge end
    local Root = Player.Character:FindFirstChild("HumanoidRootPart")
    if not Root then return math.huge end
    return (Camera.CFrame.Position - Root.Position).Magnitude
end

local function IsEnemy(Player)
    if not Player or Player == LocalPlayer then return false end
    if Config.Aimbot.TeamCheck and Team and Player.Team == Team then return false end
    return true
end

local function IsVisible(Target)
    if not Config.WallCheck.Enabled then return true end
    if not Target then return false end
    
    local Character = Target.Parent
    if not Character then return false end
    
    local Origin = Camera.CFrame.Position
    local Direction = (Target.Position - Origin).Unit * (Target.Position - Origin).Magnitude
    
    local RayParams = RaycastParams.new()
    RayParams.FilterDescendantsInstances = {LocalPlayer.Character, Character}
    RayParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local RayResult = Workspace:Raycast(Origin, Direction, RayParams)
    return RayResult == nil
end

local function GetHealthColor(Health)
    if Health > 75 then return Color3.fromRGB(0, 255, 0)
    elseif Health > 50 then return Color3.fromRGB(255, 255, 0)
    elseif Health > 25 then return Color3.fromRGB(255, 165, 0)
    else return Color3.fromRGB(255, 0, 0)
    end
end

local function GetClosestEnemy()
    local Closest = nil
    local MinDist = Config.Aimbot.FOVRadius
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if not IsEnemy(Player) then continue end
        if not Player.Character then continue end
        
        local Head = Player.Character:FindFirstChild(Config.Aimbot.AimPart)
        if not Head then continue end
        
        local Dist = (Camera.CFrame.Position - Head.Position).Magnitude
        if Dist > Config.Aimbot.MaxDistance then continue end
        
        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Head.Position)
        if not OnScreen then continue end
        
        local MousePos = UserInputService:GetMouseLocation()
        local ScreenDist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos).Magnitude
        
        if ScreenDist < MinDist then
            MinDist = ScreenDist
            Closest = Player
        end
    end
    
    return Closest
end

