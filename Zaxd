--====================================--
local AimAssist = {}

function AimAssist:Update()
    if not Config.AimAssist.Enabled then return end
    
    local MousePos = UserInputService:GetMouseLocation()
    local Nearest = nil
    local NearestDist = Config.AimAssist.MaxDistance
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if not IsEnemy(Player) then continue end
        if not Player.Character then continue end
        
        local Head = Player.Character:FindFirstChild("Head")
        if not Head then continue end
        
        local Humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then continue end
        
        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Head.Position)
        if not OnScreen then continue end
        
        local Dist = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos).Magnitude
        
        if Dist < NearestDist then
            NearestDist = Dist
            Nearest = ScreenPos
        end
    end
    
    if Nearest then
        local NewPos = MousePos:Lerp(Vector2.new(Nearest.X, Nearest.Y), Config.AimAssist.Strength * Config.AimAssist.SmoothFactor)
        mousemoverel(NewPos.X - MousePos.X, NewPos.Y - MousePos.Y)
    end
end

