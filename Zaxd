        Button.Size = UDim2.new(0, 44, 0, 22)
        Button.Position = UDim2.new(1, -55, 0, 6)
        Button.BackgroundColor3 = Default and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 50, 50)
        Button.Text = Default and "ON" or "OFF"
        Button.TextColor3 = Color3.fromRGB(255, 255, 255)
