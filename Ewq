-- ESP + Aimbot + Tracer
-- Kompatibel: Delta Executor Android
-- Sumber: Roblox API publik + komunitas scripting publik

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera

-- Player & Tim
local LocalPlayer = Players.LocalPlayer
local Team = LocalPlayer.Team

-- Konfigurasi
local ESP_ENABLED = false
local AIMBOT_ENABLED = false
local TRACER_ENABLED = false
local AIMBOT_KEY = Enum.KeyCode.RightShift
local FOV_RADIUS = 150
local SMOOTHNESS = 0.12
local TARGET_PART = "Head"
local MAX_DISTANCE = 500

-- ESP Storage
local ESPStorage = {}

-- Fungsi membuat ESP
local function CreateESP(TargetPlayer)
    local Character = TargetPlayer.Character
    if not Character then return end
    
    local Head = Character:FindFirstChild("Head")
    if not Head then return end
    
    -- Highlight
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "ESP_Highlight"
    Highlight.FillColor = Color3.fromRGB(255, 0, 0)
    Highlight.FillTransparency = 0.5
    Highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
    Highlight.OutlineTransparency = 0.3
    Highlight.Adornee = Character
    Highlight.Parent = Character

    -- Billboard GUI
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "ESP_Billboard"
    Billboard.AlwaysOnTop = true
    Billboard.Size = UDim2.new(0, 100, 0, 50)
    Billboard.Adornee = Head
    Billboard.Parent = Head

    local Frame = Instance.new("Frame")
    Frame.BackgroundTransparency = 1
    Frame.Size = UDim2.new(1, 0, 1, 0)
    Frame.Parent = Billboard

    local Label = Instance.new("TextLabel")
    Label.BackgroundTransparency = 1
    Label.TextColor3 = Color3.fromRGB(255, 0, 0)
    Label.TextStrokeTransparency = 0
    Label.Font = Enum.Font.SourceSansBold
    Label.TextSize = 14
    Label.Size = UDim2.new(1, 0, 1, 0)
    Label.Text = TargetPlayer.Name
    Label.Parent = Frame

    -- Tracer Line
    local TracerLine = Drawing.new("Line")
    TracerLine.Visible = false
    TracerLine.Color = Color3.fromRGB(255, 0, 0)
    TracerLine.Thickness = 1.5
    TracerLine.Transparency = 0.5

    ESPStorage[TargetPlayer] = {
        Player = TargetPlayer,
        Highlight = Highlight,
        Billboard = Billboard,
        TracerLine = TracerLine
    }
end

-- Fungsi menghapus ESP
local function RemoveESP(TargetPlayer)
    local ESP = ESPStorage[TargetPlayer]
    if not ESP then return end

    if ESP.Highlight then ESP.Highlight:Destroy() end
    if ESP.Billboard then ESP.Billboard:Destroy() end
    if ESP.TracerLine then ESP.TracerLine:Remove() end
    ESPStorage[TargetPlayer] = nil
end

-- Update ESP & Tracer
local function UpdateESP()
    for Player, ESP in pairs(ESPStorage) do
        local Character = Player.Character
        if Character then
            local Head = Character:FindFirstChild("Head")
            local Humanoid = Character:FindFirstChildOfClass("Humanoid")

            if Head and Humanoid and Humanoid.Health > 0 then
                -- Update ESP visibility
                if ESP.Highlight then ESP.Highlight.Enabled = ESP_ENABLED end
                if ESP.Billboard then ESP.Billboard.Enabled = ESP_ENABLED end

                -- Update Tracer
                if ESP.TracerLine then
                    local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Head.Position)
                    if OnScreen and TRACER_ENABLED and ESP_ENABLED then
                        local ViewportSize = Camera.ViewportSize
                        ESP.TracerLine.From = Vector2.new(ViewportSize.X / 2, ViewportSize.Y)
                        ESP.TracerLine.To = Vector2.new(ScreenPos.X, ScreenPos.Y)
                        ESP.TracerLine.Visible = true
                    else
                        ESP.TracerLine.Visible = false
                    end
                end
            end
        end
    end
end

-- Cek Target Valid (Bukan Tim Sendiri)
local function IsValidTarget(Player)
    if not Player or Player == LocalPlayer then return false end
    local Character = Player.Character
    if not Character then return false end
    local Head = Character:FindFirstChild("Head")
    if not Head then return false end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return false end
    -- Skip teammate
    if Team and Player.Team == Team then return false end
    -- Distance check
    if (Camera.CFrame.Position - Head.Position).Magnitude > MAX_DISTANCE then return false end
    return true
end

-- Dapatkan Target Aimbot (Prioritas Head)
local function GetAimbotTarget()
    local NearestDistance = FOV_RADIUS
    local Target = nil

    for _, Player in ipairs(Players:GetPlayers()) do
        if IsValidTarget(Player) then
            local Head = Player.Character.Head
            local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Head.Position)

            if OnScreen then
                local MousePos = UserInputService:GetMouseLocation()
                local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos).Magnitude

                if Distance < NearestDistance then
                    NearestDistance = Distance
                    Target = Head
                end
            end
        end
    end

    return Target
end

-- Aimbot
local function UpdateAimbot()
    if not AIMBOT_ENABLED then return end
    if not UserInputService:IsKeyDown(AIMBOT_KEY) then return end

    local Target = GetAimbotTarget()
    if Target then
        local TargetPos = Target.Position
        local CameraCFrame = Camera.CFrame
        local LookAt = CFrame.new(CameraCFrame.Position, TargetPos)
        Camera.CFrame = CameraCFrame:Lerp(LookAt, SMOOTHNESS)
    end
end

-- Render Loop
RunService.RenderStepped:Connect(function()
    -- Cek Player Masuk
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and not ESPStorage[Player] then
            if Team and Player.Team ~= Team then
                CreateESP(Player)
            elseif not Team then
                CreateESP(Player)
            end
        end
    end

    -- Cek Player Keluar
    for Player, _ in pairs(ESPStorage) do
        if not Player.Parent then
            RemoveESP(Player)
        end
    end

    UpdateESP()
    UpdateAimbot()
end)

-- Cleanup saat Player Leave
Players.PlayerRemoving:Connect(function(Player)
    RemoveESP(Player)
end)

