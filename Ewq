    ESPButton.Font = Enum.Font.SourceSansBold
    ESPButton.TextSize = 13
    ESPButton.Parent = MainFrame

    -- Tracer Toggle
    local TracerButton = Instance.new("TextButton")
    TracerButton.Size = UDim2.new(1, -10, 0, 25)
    TracerButton.Position = UDim2.new(0, 5, 0, 58)
    TracerButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    TracerButton.Text = "TRACER: OFF"
    TracerButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    TracerButton.Font = Enum.Font.SourceSansBold
    TracerButton.TextSize = 13
    TracerButton.Parent = MainFrame

    -- Aimbot Toggle
    local AimButton = Instance.new("TextButton")
    AimButton.Size = UDim2.new(1, -10, 0, 25)
    AimButton.Position = UDim2.new(0, 5, 0, 86)
    AimButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    AimButton.Text = "AIMBOT: OFF"
    AimButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    AimButton.Font = Enum.Font.SourceSansBold
    AimButton.TextSize = 13
    AimButton.Parent = MainFrame

    -- Hide Button
    local HideButton = Instance.new("TextButton")
    HideButton.Size = UDim2.new(0, 25, 0, 25)
    HideButton.Position = UDim2.new(1, -30, 0, 0)
    HideButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    HideButton.Text = "-"
    HideButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    HideButton.Font = Enum.Font.SourceSansBold
    HideButton.TextSize = 16
    HideButton.Parent = MainFrame

    -- Toggle Functions
    local Visible = true
    ESPButton.MouseButton1Click:Connect(function()
        ESP_ENABLED = not ESP_ENABLED
        ESPButton.Text = ESP_ENABLED and "ESP: ON" or "ESP: OFF"
        ESPButton.TextColor3 = ESP_ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        TRACER_ENABLED = ESP_ENABLED and TRACER_ENABLED
        if not ESP_ENABLED then TRACER_ENABLED = false end
        TracerButton.Text = TRACER_ENABLED and "TRACER: ON" or "TRACER: OFF"
        TracerButton.TextColor3 = TRACER_ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)

    TracerButton.MouseButton1Click:Connect(function()
        if not ESP_ENABLED then return end
        TRACER_ENABLED = not TRACER_ENABLED
        TracerButton.Text = TRACER_ENABLED and "TRACER: ON" or "TRACER: OFF"
        TracerButton.TextColor3 = TRACER_ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)

    AimButton.MouseButton1Click:Connect(function()
        AIMBOT_ENABLED = not AIMBOT_ENABLED
        AimButton.Text = AIMBOT_ENABLED and "AIMBOT: ON" or "AIMBOT: OFF"
        AimButton.TextColor3 = AIMBOT_ENABLED and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)

    HideButton.MouseButton1Click:Connect(function()
        Visible = not Visible
        MainFrame.Visible = Visible
    end)
end

-- Inisialisasi GUI
CreateToggleGUI()

-- Cleanup ESP awal
for _, Player in ipairs(Players:GetPlayers()) do
    if IsValidTarget(Player) then
        CreateESP(Player)
    end
end
