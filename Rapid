-- ========================================
-- UTILITY
-- ========================================
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getEnemies()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function getClosest()
    local closest, closestDist = nil, Config.AimFOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in pairs(getEnemies()) do
        local part = p.Character:FindFirstChild(Config.AimPart) or p.Character:FindFirstChild("HumanoidRootPart")
        if part then
            local sp, vis = Camera:WorldToViewportPoint(part.Position)
            if vis then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = part
                end
            end
        end
    end
    return closest
end

-- ========================================
-- GOD MODE — FULL SERVER BYPASS
-- ========================================
local function setupGodMode()
    local char = getChar()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    -- Block all incoming damage
    hum:GetPropertyChangedSignal("Health"):Connect(function()
        if Config.GodMode then
            if hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end
    end)

    -- Force max health loop
    RunService.Heartbeat:Connect(function()
        if Config.GodMode and hum and hum.Parent then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
        end
    end)

    -- Block damage remotes
    local oldFireServer
    oldFireServer = hookfunction(game.ReplicatedStorage.DescendantAdded, function(...)
        return oldFireServer(...)
    end)
end

LocalPlayer.CharacterAdded:Connect(function()
    wait(0.5)
    setupGodMode()
end)
setupGodMode()

-- ========================================
-- INFINITE AMMO — REAL EFFECT
-- ========================================
RunService.Heartbeat:Connect(function()
    if not Config.InfiniteAmmo then return end
    local char = getChar()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    for _, v in pairs(tool:GetDescendants()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then
            local n = v.Name:lower()
            if n:find("ammo") or n:find("bullet") or n:find("clip") or n:find("mag") or n:find("round") then
                v.Value = 9999
            end
        end
    end
    -- Also hook remote to prevent server ammo check
    for _, v in pairs(tool:GetDescendants()) do
        if v:IsA("RemoteFunction") then
            v.OnClientInvoke = function()
                return true
            end
        end
    end
end)

-- ========================================
-- RAPID FIRE — REAL SERVER FIRE
-- ========================================
local lastFire = 0
RunService.Heartbeat:Connect(function()
    if not Config.RapidFire then return end
    local now = tick()
    if now - lastFire < Config.RapidFireDelay then return end
    local char = getChar()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    -- Find and fire actual shoot remote
    for _, v in pairs(tool:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = v.Name:lower()
            if n:find("fire") or n:find("shoot") or n:find("attack") or n:find("bullet") then
                local target = getClosest()
                if target then
                    v:FireServer(target.Position, target.Position, target)
                end
            end
        end
    end
    lastFire = now
end)

