-- ========================================
-- FLY HACK
-- ========================================
local flyBody = nil
local function enableFly()
    local root = getRoot()
    if not root then return end
    flyBody = Instance.new("BodyVelocity")
    flyBody.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyBody.Velocity = Vector3.new(0, 0, 0)
    flyBody.Parent = root
end
local function disableFly()
    if flyBody then flyBody:Destroy() flyBody = nil end
end
RunService.RenderStepped:Connect(function()
    if Config.FlyEnabled then
        if not flyBody then enableFly() end
        local root = getRoot()
        if root and flyBody then
            flyBody.Velocity = Camera.CFrame.LookVector * Config.FlySpeed
        end
    else
        if flyBody then disableFly() end
    end
end)

-- ========================================
-- KILL AURA — REAL DAMAGE
-- ========================================
RunService.Heartbeat:Connect(function()
    if not Config.KillAura then return end
    local root = getRoot()
    if not root then return end
    for _, p in pairs(getEnemies()) do
        local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
        if eRoot then
            local dist = (eRoot.Position - root.Position).Magnitude
            if dist <= Config.KillAuraRange then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                -- Try tool remote first
                local char = getChar()
                local tool = char and char:FindFirstChildOfClass("Tool")
                if tool then
                    for _, v in pairs(tool:GetDescendants()) do
                        if v:IsA("RemoteEvent") then
                            v:FireServer(eRoot.Position, eRoot.Position, eRoot)
                        end
                    end
                end
                -- Fallback
                if hum then hum.Health = 0 end
            end
        end
    end
end)

