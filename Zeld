-- ══════════════════════════════════
-- ESP DRAWING FACTORY
-- ══════════════════════════════════
local function newLine(color, thickness)
    local l = Drawing.new("Line")
    l.Color = color
    l.Thickness = thickness
    l.Visible = false
    return l
end

local function newText(size, color)
    local t = Drawing.new("Text")
    t.Size = size
    t.Color = color
    t.Outline = true
    t.Center = true
    t.Visible = false
    return t
end

local function createESP(player)
    ESPObjects[player] = {
        box   = { newLine(Config.ESP.BoxColor, Config.ESP.BoxThickness),
                  newLine(Config.ESP.BoxColor, Config.ESP.BoxThickness),
                  newLine(Config.ESP.BoxColor, Config.ESP.BoxThickness),
                  newLine(Config.ESP.BoxColor, Config.ESP.BoxThickness) },
        trace  = newLine(Config.ESP.TraceColor, Config.ESP.TraceThickness),
        tracer = newLine(Config.ESP.TracerColor, Config.ESP.TracerThickness),
        name   = newText(13, Config.ESP.NameColor),
        health = newLine(Color3.fromRGB(0,255,0), 3),
        dist   = newText(11, Color3.fromRGB(180,180,255)),
        corner = { -- corner bracket style
            newLine(Color3.fromRGB(255,80,80), 2),
            newLine(Color3.fromRGB(255,80,80), 2),
            newLine(Color3.fromRGB(255,80,80), 2),
            newLine(Color3.fromRGB(255,80,80), 2),
            newLine(Color3.fromRGB(255,80,80), 2),
            newLine(Color3.fromRGB(255,80,80), 2),
            newLine(Color3.fromRGB(255,80,80), 2),
            newLine(Color3.fromRGB(255,80,80), 2),
        },
    }
end

local function removeESP(player)
    if not ESPObjects[player] then return end
    local d = ESPObjects[player]
    for _, l in ipairs(d.box) do l:Remove() end
    d.trace:Remove()
    d.tracer:Remove()
    d.name:Remove()
    d.health:Remove()
    d.dist:Remove()
    for _, l in ipairs(d.corner) do l:Remove() end
    ESPObjects[player] = nil
end

local function hideAll(d)
    for _, l in ipairs(d.box) do l.Visible = false end
    d.trace.Visible = false
    d.tracer.Visible = false
    d.name.Visible = false
    d.health.Visible = false
    d.dist.Visible = false
    for _, l in ipairs(d.corner) do l.Visible = false end
end

local function drawCornerBox(d, x, y, w, h)
    -- corner bracket, bukan full box
    local cs = math.floor(w * 0.25) -- corner size
    local c = d.corner
    -- top-left
    c[1].From = Vector2.new(x, y)        c[1].To = Vector2.new(x+cs, y)        c[1].Visible = true
    c[2].From = Vector2.new(x, y)        c[2].To = Vector2.new(x, y+cs)        c[2].Visible = true
    -- top-right
    c[3].From = Vector2.new(x+w, y)      c[3].To = Vector2.new(x+w-cs, y)      c[3].Visible = true
    c[4].From = Vector2.new(x+w, y)      c[4].To = Vector2.new(x+w, y+cs)      c[4].Visible = true
    -- bot-left
    c[5].From = Vector2.new(x, y+h)      c[5].To = Vector2.new(x+cs, y+h)      c[5].Visible = true
    c[6].From = Vector2.new(x, y+h)      c[6].To = Vector2.new(x, y+h-cs)      c[6].Visible = true
    -- bot-right
    c[7].From = Vector2.new(x+w, y+h)    c[7].To = Vector2.new(x+w-cs, y+h)    c[7].Visible = true
    c[8].From = Vector2.new(x+w, y+h)    c[8].To = Vector2.new(x+w, y+h-cs)    c[8].Visible = true
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            if not ESPObjects[player] then createESP(player) end
            local d   = ESPObjects[player]
            local box = getCharBox(player.Character)
            local hum = player.Character:FindFirstChild("Humanoid")
            local hp  = hum and (hum.Health / math.max(hum.MaxHealth,1)) or 0
            local screenBot = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            local isPinned = (PinnedTarget == player)

            if box and Config.ESP.Enabled then
                local x = box.topScreen.X - box.width/2
                local y = box.topScreen.Y
                local w = box.width
                local h = box.height

                -- Corner bracket box (lebih clean dari full box)
                drawCornerBox(d, x, y, w, h)

                -- Trace (semua enemy)
                d.trace.From = screenBot
                d.trace.To   = box.botScreen
                d.trace.Color = isPinned and Config.ESP.TracerColor or Config.ESP.TraceColor
                d.trace.Visible = true

                -- Tracer khusus pinned target (tebal, beda warna)
                if isPinned and Config.ESP.ShowTracer then
                    d.tracer.From = screenBot
                    d.tracer.To   = box.topScreen
                    d.tracer.Visible = true
                else
                    d.tracer.Visible = false
                end

                -- Name
                if Config.ESP.ShowName then
                    local tag = isPinned and ("🎯 "..player.DisplayName) or player.DisplayName
                    d.name.Text = tag
                    d.name.Position = Vector2.new(box.topScreen.X, y - 16)
                    d.name.Color = isPinned and Color3.fromRGB(0,220,255) or Config.ESP.NameColor
                    d.name.Visible = true
                end

                -- Health bar
                if Config.ESP.ShowHealth then
                    local barH = h * hp
                    d.health.From = Vector2.new(x-5, y+h)
                    d.health.To   = Vector2.new(x-5, y+h-barH)
                    d.health.Color = Color3.fromRGB(
                        math.floor(255*(1-hp)),
                        math.floor(255*hp),
                        0
                    )
                    d.health.Visible = true
                end

                -- Distance + ping (pinned target)
                if Config.ESP.ShowDistance then
                    local dist = getDistance(player)
                    local extra = isPinned and " [LOCKED]" or ""
                    d.dist.Text = dist.."m"..extra
                    d.dist.Position = Vector2.new(box.topScreen.X, box.botScreen.Y+4)
                    d.dist.Visible = true
                end
            else
                hideAll(d)
            end
        else
            removeESP(player)
        end
    end
end

-- ══════════════════════════════════
-- AIMBOT v30
-- FIX: ga nge-pull paksa, hanya aktif saat hold
-- Kalau RequireHold = false → always on tapi smoothness rendah
-- ══════════════════════════════════
local function runAimbot()
    if not Config.Aimbot.Enabled then return end

    -- Gate: kalau RequireHold true, hanya jalan saat hold
    if Config.Aimbot.RequireHold and not IsHolding then
        return  -- ga ngapa-ngapain, kamera bebas sepenuhnya
    end

    refreshCache()

    -- Priority: pinned target dulu
    local targetPlayer = nil
    local targetWorldPos = nil

    if PinnedTarget and isEnemy(PinnedTarget) then
        targetPlayer = PinnedTarget
    elseif Config.Aimbot.AutoLock then
        local nearest = getNearestEnemy()
        if nearest then
            targetPlayer = nearest.player
        end
    end

    if not targetPlayer then
        LockedTarget = nil
        return
    end

    LockedTarget = targetPlayer

    local targetPart = targetPlayer.Character:FindFirstChild(Config.Aimbot.TargetPart)
    if not targetPart then return end

    -- Prediction
    local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local vel = hrp and hrp.Velocity or Vector3.zero
    local basePos = targetPart.Position
    targetWorldPos = Config.Aimbot.Prediction
        and (basePos + vel * Config.Aimbot.PredictionFactor)
        or  basePos

    -- Smooth aim (rendah = ga nge-pull paksa)
    local cf = Camera.CFrame
    local lookAt = CFrame.lookAt(cf.Position, targetWorldPos)
    Camera.CFrame = cf:Lerp(lookAt, Config.Aimbot.Smoothness)
end

-- ══════════════════════════════════
-- TARGET LOCK UPDATE
-- ══════════════════════════════════
local function updatePinnedTarget()
    if not Config.TargetLock.Enabled or Config.TargetLock.Username == "" then
        PinnedTarget = nil
        return
    end
    local found = findPlayerByPartialName(Config.TargetLock.Username)
    PinnedTarget = (found and isEnemy(found)) and found or nil
end

-- ══════════════════════════════════
-- SILENT AIM
-- ══════════════════════════════════
local function initSilentAim()
    if not Config.Aimbot.SilentAim then return end
    local ok, mt = pcall(getrawmetatable, game)
    if not ok then return end
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") then
            local target = PinnedTarget or LockedTarget
            if target and isEnemy(target) then
                local head = target.Character:FindFirstChild("Head")
                if head then
                    local args = {...}
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then args[i] = head.Position end
                        if typeof(v) == "Instance" and v:IsA("BasePart") then args[i] = head end
                    end
                    return old(self, table.unpack(args))
                end
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end

initSilentAim()

