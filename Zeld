-- ══════════════════════════════════
-- UTILS
-- ══════════════════════════════════
local function isEnemy(player)
    if player == LocalPlayer then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function getScreenPos(worldPos)
    local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(sp.X, sp.Y), onScreen, sp.Z
end

local function getDistance(player)
    local char = player.Character
    local lchar = LocalPlayer.Character
    if not char or not lchar then return 0 end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local lhrp = lchar:FindFirstChild("HumanoidRootPart")
    if not hrp or not lhrp then return 0 end
    return math.floor((hrp.Position - lhrp.Position).Magnitude)
end

local function getCharBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local top = hrp.Position + Vector3.new(0, 3.5, 0)
    local bot = hrp.Position + Vector3.new(0, -3.2, 0)
    local topS, onScreen = getScreenPos(top)
    local botS = getScreenPos(bot)
    if not onScreen then return nil end
    local h = math.abs(topS.Y - botS.Y)
    return {
        topScreen = topS,
        botScreen = botS,
        height = h,
        width = h * 0.55,
    }
end

-- ══════════════════════════════════
-- USERNAME PARTIAL MATCH
-- cukup ketik "nob" → match "NobodyXD123"
-- ══════════════════════════════════
local function findPlayerByPartialName(partial)
    if partial == "" then return nil end
    local lower = partial:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Name:lower():find(lower, 1, true) or
               p.DisplayName:lower():find(lower, 1, true) then
                return p
            end
        end
    end
    return nil
end

-- ══════════════════════════════════
-- TARGET CACHE (50ms refresh)
-- ══════════════════════════════════
local function refreshCache()
    local now = tick()
    if now - LastCacheTime < CacheInterval then return end
    LastCacheTime = now
    TargetCache = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local sp, onScreen, depth = getScreenPos(head.Position)
                if onScreen and depth > 0 then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    table.insert(TargetCache, {
                        player   = p,
                        screenPos = sp,
                        depth    = depth,
                        worldPos = head.Position,
                        velocity = hrp and hrp.Velocity or Vector3.zero,
                    })
                end
            end
        end
    end
end

local function getNearestEnemy()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, closestDist = nil, Config.Aimbot.FOV
    for _, data in ipairs(TargetCache) do
        local d = (data.screenPos - center).Magnitude
        if d < closestDist then
            closestDist = d
            closest = data
        end
    end
    return closest
end

