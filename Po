-- Strike Warfare Full Exploit
-- Ammo override, fire rate removal, helicopter infinite mag

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

-- Weapon detection & ammo hook
local function GetWeapon()
    for _, v in pairs(Character:GetChildren()) do
        if v:FindFirstChild("Handle") and v:FindFirstChild("Ammo") then
            return v
        end
    end
    return nil
end

-- Infinite ammo loop
RunService.RenderStepped:Connect(function()
    local weapon = GetWeapon()
    if weapon then
        local ammoValue = weapon:FindFirstChild("Ammo")
        if ammoValue then
            ammoValue.Value = 999
        end
        
        local clipValue = weapon:FindFirstChild("Clip")
        if clipValue then
            clipValue.Value = 999
        end
    end
end)

-- Fire rate removal (no delay between shots)
local UserInputService = game:GetService("UserInputService")
local isFiring = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isFiring = true
        while isFiring do
            local weapon = GetWeapon()
            if weapon then
                -- Fire event override
                local fireEvent = weapon:FindFirstChild("Fire") or weapon:FindFirstChildOfClass("RemoteEvent")
                if fireEvent then
                    fireEvent:FireServer()
                end
            end
            wait(0.01) -- 0.01 delay = rapid fire
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isFiring = false
    end
end)

-- Helicopter specific: mag size override
local function OverrideHelicopter()
    local char = LocalPlayer.Character
    if char:FindFirstChild("Helicopter") then
        local helicopterWeapon = char.Helicopter:FindFirstChild("Weapon")
        if helicopterWeapon then
            local magSize = helicopterWeapon:FindFirstChild("MagSize")
            if magSize then
                magSize.Value = 9999
            end
        end
    end
end

RunService.Heartbeat:Connect(OverrideHelicopter)

-- God mode (optional bonus layer)
Humanoid.HealthChanged:Connect(function()
    if Humanoid.Health < Humanoid.MaxHealth then
        Humanoid.Health = Humanoid.MaxHealth
    end
end)

print("Strike Warfare exploit loaded. 6767 gng.")
