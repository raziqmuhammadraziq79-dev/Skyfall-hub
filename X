    frame.Parent = Content

    local frameCorner = Instance.new("UICorner")
    frameCorner.CornerRadius = UDim.new(0, 6)
    frameCorner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = COLORS.TEXT
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Name = "Toggle"
    btn.Size = UDim2.new(0.35, -5, 0.7, 0)
    btn.Position = UDim2.new(0.62, 0, 0.15, 0)
    btn.BackgroundColor3 = initVal and COLORS.BUTTON_ON or COLORS.BUTTON_OFF
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.Text = initVal and "ON" or "OFF"
    btn.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = btn

    local state = initVal
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "ON" or "OFF"
        btn.BackgroundColor3 = state and COLORS.BUTTON_ON or COLORS.BUTTON_OFF
        callback(state)
    end)

    return frame
end

-- Function: Create Slider
local function CreateSlider(text, minVal, maxVal, initVal, callback)
    local frame = Instance.new("Frame")
    frame.Name = text
    frame.Size = UDim2.new(1, -10, 0, 60)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    frame.BorderSizePixel = 1
    frame.BorderColor3 = Color3.fromRGB(80, 80, 100)
    frame.Parent = Content

    local frameCorner = Instance.new("UICorner")
    frameCorner.CornerRadius = UDim.new(0, 6)
    frameCorner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0.4, 0)
    label.Position = UDim2.new(0, 5, 0, 2)
    label.BackgroundTransparency = 1
    label.TextColor3 = COLORS.TEXT
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.Text = text .. ": " .. initVal
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -10, 0, 5)
    bar.Position = UDim2.new(0, 5, 0.45, 0)
    bar.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    bar.BorderSizePixel = 0
    bar.Parent = frame

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(0, 2)
    barCorner.Parent = bar

    local thumb = Instance.new("TextButton")
    thumb.Size = UDim2.new(0, 12, 0, 12)
    thumb.Position = UDim2.new((initVal - minVal) / (maxVal - minVal), -6, 0.5, -6)
    thumb.BackgroundColor3 = COLORS.PANEL_ACCENT
    thumb.BorderSizePixel = 0
    thumb.Text = ""
    thumb.Parent = bar

    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(0, 6)
    thumbCorner.Parent = thumb

    local dragging = false

    thumb.MouseButton1Down:Connect(function()
        dragging = true
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouse = UserInputService:GetMouseLocation()
            local barAbsX = bar.AbsolutePosition.X
            local barAbsSize = bar.AbsoluteSize.X
            local relPos = math.clamp(mouse.X - barAbsX, 0, barAbsSize)
            local pct = relPos / barAbsSize
            local val = math.floor(minVal + (maxVal - minVal) * pct)

            thumb.Position = UDim2.new(pct, -6, 0.5, -6)
            label.Text = text .. ": " .. val
            callback(val)
        end
    end)

    return frame
end

