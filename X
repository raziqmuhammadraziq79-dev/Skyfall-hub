-- ═══════════════════════════════════════════════
-- 🔍 ADVANCED TEAM DETECTION
-- ═══════════════════════════════════════════════

local function UpdateTeamCache()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChild("Humanoid")
            
            if humanoid then
                local teamValue = nil
                
                -- Method 1: Check Humanoid tag
                if humanoid:FindFirstChild("Team") then
                    teamValue = humanoid.Team
                end
                
                -- Method 2: Check Character tag
                if not teamValue and character:FindFirstChild("Team") then
                    teamValue = character.Team
                end
                
                -- Method 3: Check parent Player team
                if not teamValue and player:FindFirstChild("Team") then
                    teamValue = player.Team
                end
                
                -- Method 4: Check Team attribute
                if not teamValue then
                    teamValue = humanoid:GetAttribute("Team") or character:GetAttribute("Team")
                end
                
                PLAYER_TEAMS[player.UserId] = teamValue
            end
        end
    end
end

local function IsEnemyPlayer(player)
    if player == LocalPlayer then return false end
    
    UpdateTeamCache()
    
    local localTeam = PLAYER_TEAMS[LocalPlayer.UserId]
    local playerTeam = PLAYER_TEAMS[player.UserId]
    
    -- Jika tidak bisa detect team, anggap berbeda team
    if not localTeam or not playerTeam then
        return true
    end
    
    return localTeam ~= playerTeam
end

