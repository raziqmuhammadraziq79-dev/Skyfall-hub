-- 👁️ UPDATE ESP SYSTEM
-- ═══════════════════════════════════════════════

local function UpdateESPVisuals()
    if not CONFIG.ESP_ENABLED then return end

    local localHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHRP then return end

    -- Clean dead players
    for player, espData in pairs(ESP_OBJECTS) do
        if not player.Parent or not player.Character then
            pcall(function()
                if espData.Container then espData.Container:Destroy() end
            end)
            ESP_OBJECTS[player] = nil
        else
            local character = player.Character
            if character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
                local hrp = character.HumanoidRootPart
                local humanoid = character.Humanoid
                local distance = (hrp.Position - localHRP.Position).Magnitude

                if distance > CONFIG.ESP_DISTANCE then
                    pcall(function()
                        espData.Container.Parent = nil
                    end)
                else
                    pcall(function()
                        espData.Container.Parent = workspace

                        -- Update Health
                        if CONFIG.SHOW_HEALTH then
                            local hp = math.ceil(humanoid.Health)
                            espData.HealthLabel.Text = "HP: " .. hp
                            if hp > 75 then
                                espData.HealthLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                            elseif hp > 40 then
                                espData.HealthLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                            else
                                espData.HealthLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                            end
                        end

                        -- Update Distance
                        if CONFIG.SHOW_DISTANCE then
                            espData.DistLabel.Text = string.format("%.1f m", distance)
                        end
                    end)
                end
            end
        end
    end

    -- Create ESP for new enemies
    UpdateTeamCache()
    
    for _, player in pairs(Players:GetPlayers()) do
        if not IsEnemyPlayer(player) then continue end

        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then continue end

        if not ESP_OBJECTS[player] then
            local espData = CreatePremiumESP(player, COLORS.ENEMY)
            if espData then
                ESP_OBJECTS[player] = espData
            end
        end
    end
end

-- ═══════════════════════════════════════════════
-- 🎯 FIND NEAREST ENEMY (FIXED AUTO SEARCH)
-- ═══════════════════════════════════════════════

local function FindNearestEnemy()
    local nearest = nil
    local shortestDist = math.huge
    local localHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not localHRP then return nil end

    for _, player in pairs(Players:GetPlayers()) do
        if not IsEnemyPlayer(player) then continue end

        local character = player.Character
        if not character or not character:FindFirstChild("Humanoid") then continue end
        if character.Humanoid.Health <= 0 then continue end

        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        local dist = (hrp.Position - localHRP.Position).Magnitude
        
        if dist < shortestDist and dist <= CONFIG.ESP_DISTANCE then
            shortestDist = dist
            nearest = player
        end
    end

    return nearest
end

-- ═══════════════════════════════════════════════
-- 🔒 SOFT AIMBOT ASSIST (MANUAL + AUTO)
-- ═══════════════════════════════════════════════

local function SoftAimbotAssist()
    if not CONFIG.AIMBOT_ENABLED then return end

    if CONFIG.AUTO_SEARCH then
        CURRENT_TARGET = FindNearestEnemy()
    end

    if not CURRENT_TARGET or not CURRENT_TARGET.Character then
        return
    end

    local targetChar = CURRENT_TARGET.Character
    if not targetChar:FindFirstChild("Humanoid") or targetChar.Humanoid.Health <= 0 then
        CURRENT_TARGET = nil
        return
    end

    local targetPart = CONFIG.TARGET_HEAD and targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end

    local camera = Camera
    local targetPos = targetPart.Position
    local camPos = camera.CFrame.Position

    -- Prediction
    if CONFIG.PREDICTION_ENABLED then
        local hrp = targetChar:FindFirstChild("HumanoidRootPart")
        if hrp then
            local vel = hrp.AssemblyLinearVelocity
            local dist = (targetPos - camPos).Magnitude
            local timeToTarget = dist / 500
            targetPos = targetPos + (vel * timeToTarget * 0.5)
        end
    end

    local direction = (targetPos - camPos).Unit
    local newCFrame = CFrame.new(camPos, camPos + direction)
    
    -- SOFT LOCK - bukan hard lock!
    camera.CFrame = camera.CFrame:Lerp(newCFrame, CONFIG.AIM_SMOOTHNESS)
end

