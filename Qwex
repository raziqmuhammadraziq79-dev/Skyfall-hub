local PanelOpen = true
local function togglePanel()
    PanelOpen = not PanelOpen
    for _, child in ipairs(MainFrame:GetChildren()) do
        if child ~= HideBtn and child ~= Title and not child:IsA("UICorner") then
            if child:IsA("GuiObject") then
                child.Visible = PanelOpen
            end
        end
    end
    MainFrame.Size = PanelOpen and UDim2.new(0, 270, 0, 460) or UDim2.new(0, 270, 0, 82)
    HideBtn.Visible = true
end

HideBtn.MouseButton1Click:Connect(togglePanel)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Minus then togglePanel() end
end)

