local function makeToggle(label, yPos, state, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.88, 0, 0, 38)
    btn.Position = UDim2.new(0.06, 0, 0, yPos)
    btn.BackgroundColor3 = state and Color3.fromRGB(25, 150, 55) or Color3.fromRGB(150, 25, 25)
    btn.Text = label .. (state and "  ✔" or "  ✘")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local enabled = state
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        callback(enabled)
        btn.BackgroundColor3 = enabled and Color3.fromRGB(25, 150, 55) or Color3.fromRGB(150, 25, 25)
        btn.Text = label .. (enabled and "  ✔" or "  ✘")
    end)
    return btn
end

