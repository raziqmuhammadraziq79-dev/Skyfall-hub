-- ══════════════════════════════════
-- STATE
-- ══════════════════════════════════
local ESPObjects = {}
local LockedTarget = nil
local TargetCache = {}      -- cache enemy list, update tiap 0.05s
local LastCacheTime = 0
local CacheInterval = 0.05  -- 50ms refresh = hyper responsive

-- ══════════════════════════════════
-- UTILS
-- ══════════════════════════════════
local function isEnemy(player)
    if player == LocalPlayer then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return true
end

local function getScreenPos(worldPos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local function getDistance(player)
    local char = player.Character
    if not char then return 999 end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local localHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not localHRP then return 999 end
    return math.floor((hrp.Position - localHRP.Position).Magnitude)
end

local function getCharBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local rootPos = hrp.Position
    local top = rootPos + Vector3.new(0, 3.5, 0)
    local bot = rootPos + Vector3.new(0, -3.2, 0)
    local topScreen, onScreen = getScreenPos(top)
    local botScreen = getScreenPos(bot)
    if not onScreen then return nil end
    local height = math.abs(topScreen.Y - botScreen.Y)
    local width = height * 0.55
    return {
        topScreen = topScreen,
        botScreen = botScreen,
        height = height,
        width = width,
        center = Vector2.new(topScreen.X, (topScreen.Y + botScreen.Y) / 2)
    }
end

-- ══════════════════════════════════
-- HYPER FAST ENEMY CACHE
-- Cache enemy list tiap 50ms
-- bukan scan tiap frame = lebih ringan + responsif
-- ══════════════════════════════════
local function refreshTargetCache()
    local now = tick()
    if now - LastCacheTime < CacheInterval then return end
    LastCacheTime = now

    TargetCache = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen, depth = getScreenPos(head.Position)
                if onScreen and depth > 0 then
                    table.insert(TargetCache, {
                        player = p,
                        screenPos = screenPos,
                        depth = depth,
                        worldPos = head.Position,
                        velocity = p.Character.HumanoidRootPart.Velocity,
                    })
                end
            end
        end
    end
end

-- ══════════════════════════════════
-- NEAREST ENEMY (dari cache)
-- ══════════════════════════════════
local function getNearestEnemy()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest = nil
    local closestDist = Config.Aimbot.FOV

    for _, data in ipairs(TargetCache) do
        local dist = (data.screenPos - center).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = data
        end
    end

    return closest
end

-- ══════════════════════════════════
-- PREDICTION — prediksi posisi head
-- berdasarkan velocity HRP
-- ══════════════════════════════════
local function getPredictedPos(data)
    if not Config.Aimbot.Prediction then return data.worldPos end
    local vel = data.velocity
    local predicted = data.worldPos + (vel * Config.Aimbot.PredictionFactor)
    return predicted
end

-- ══════════════════════════════════
-- ESP DRAWING
-- ══════════════════════════════════
local function createESPForPlayer(player)
    local drawings = {}

    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Thickness = Config.ESP.BoxThickness
        line.Color = Config.ESP.BoxColor
        line.Visible = false
        drawings["box"..i] = line
    end

    local trace = Drawing.new("Line")
    trace.Thickness = Config.ESP.TraceThickness
    trace.Color = Config.ESP.TraceColor
    trace.Visible = false
    drawings["trace"] = trace

    local nameTag = Drawing.new("Text")
    nameTag.Size = 13
    nameTag.Color = Config.ESP.NameColor
    nameTag.Outline = true
    nameTag.Center = true
    nameTag.Visible = false
    drawings["name"] = nameTag

    local healthBar = Drawing.new("Line")
    healthBar.Thickness = 3
    healthBar.Color = Config.ESP.HealthColor
    healthBar.Visible = false
    drawings["health"] = healthBar

    local distTag = Drawing.new("Text")
    distTag.Size = 11
    distTag.Color = Color3.fromRGB(180, 180, 255)
    distTag.Outline = true
    distTag.Center = true
    distTag.Visible = false
    drawings["dist"] = distTag

    ESPObjects[player] = drawings
end

local function removeESPForPlayer(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            obj:Remove()
        end
        ESPObjects[player] = nil
    end
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            if not ESPObjects[player] then createESPForPlayer(player) end
            local d = ESPObjects[player]
            local box = getCharBox(player.Character)
            local screenBot = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            local hum = player.Character:FindFirstChild("Humanoid")
            local healthPct = hum and (hum.Health / hum.MaxHealth) or 0

            if box and Config.ESP.Enabled then
                local x = box.topScreen.X - box.width / 2
                local y = box.topScreen.Y
                local w = box.width
                local h = box.height

                d["box1"].From = Vector2.new(x, y)
                d["box1"].To = Vector2.new(x+w, y)
                d["box2"].From = Vector2.new(x, y+h)
                d["box2"].To = Vector2.new(x+w, y+h)
                d["box3"].From = Vector2.new(x, y)
                d["box3"].To = Vector2.new(x, y+h)
                d["box4"].From = Vector2.new(x+w, y)
                d["box4"].To = Vector2.new(x+w, y+h)

                for i=1,4 do d["box"..i].Visible = true end

                d["trace"].From = screenBot
                d["trace"].To = box.botScreen
                d["trace"].Visible = true

                -- Name tag
                if Config.ESP.ShowName then
                    d["name"].Text = player.DisplayName
                    d["name"].Position = Vector2.new(box.topScreen.X, box.topScreen.Y - 16)
                    d["name"].Visible = true
                end

                -- Health bar (kiri box)
                if Config.ESP.ShowHealth then
                    local barH = h * healthPct
                    d["health"].From = Vector2.new(x - 5, y + h)
                    d["health"].To = Vector2.new(x - 5, y + h - barH)
                    d["health"].Color = Color3.fromRGB(
                        math.floor(255 * (1 - healthPct)),
                        math.floor(255 * healthPct),
                        0
                    )
                    d["health"].Visible = true
                end

                -- Distance
                if Config.ESP.ShowDistance then
                    d["dist"].Text = getDistance(player).."m"
                    d["dist"].Position = Vector2.new(box.topScreen.X, box.botScreen.Y + 4)
                    d["dist"].Visible = true
                end
            else
                for _, obj in pairs(d) do obj.Visible = false end
            end
        else
            removeESPForPlayer(player)
        end
    end
end

-- ══════════════════════════════════
-- AIMBOT v25 SUPER ACCURATE
-- ══════════════════════════════════
local function runAimbot()
    if not Config.Aimbot.Enabled then return end

    refreshTargetCache()

    -- Auto lock: cari target terdekat dari cache
    if Config.Aimbot.AutoLock then
        local nearestData = getNearestEnemy()
        if nearestData then
            LockedTarget = nearestData.player

            -- Snap on sight: instant snap kalau masuk threshold
            if Config.Aimbot.SnapOnSight then
                local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                if (nearestData.screenPos - center).Magnitude < Config.Aimbot.SnapThreshold then
                    local predictedPos = getPredictedPos(nearestData)
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predictedPos)
                    return
                end
            end
        else
            LockedTarget = nil
        end
    end

    if not LockedTarget or not isEnemy(LockedTarget) then
        LockedTarget = nil
        return
    end

    local targetPart = LockedTarget.Character:FindFirstChild(Config.Aimbot.TargetPart)
    if not targetPart then return end

    -- Prediction
    local hrp = LockedTarget.Character:FindFirstChild("HumanoidRootPart")
    local vel = hrp and hrp.Velocity or Vector3.zero
    local predictedPos = targetPart.Position + (vel * Config.Aimbot.PredictionFactor)
    local finalPos = Config.Aimbot.Prediction and predictedPos or targetPart.Position

    -- Smooth aim dengan magnet strength
    local currentCF = Camera.CFrame
    local lookAt = CFrame.lookAt(currentCF.Position, finalPos)
    local smooth = 1 - (1 - Config.Aimbot.Smoothness) * (1 - Config.Aimbot.MagnetStrength)
    Camera.CFrame = currentCF:Lerp(lookAt, smooth)
end

-- ══════════════════════════════════
-- SILENT AIM (bullet redirect)
-- hook NewProjectile / peluru arah ke head
-- ══════════════════════════════════
if Config.Aimbot.SilentAim then
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            if LockedTarget and isEnemy(LockedTarget) then
                local head = LockedTarget.Character:FindFirstChild("Head")
                if head then
                    local args = {...}
                    -- redirect arg posisi ke head target
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = head.Position
                        elseif typeof(v) == "Instance" and v:IsA("BasePart") then
                            args[i] = head
                        end
                    end
                    return old(self, table.unpack(args))
                end
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end

