-- ══════════════════════════════════
local Pages = {}
local ActivePage = ""

local function newPage(id)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,0,1,0)
    f.BackgroundTransparency = 1
    f.Visible = false
    f.ClipsDescendants = true
    f.ZIndex = 2
    f.Parent = Content
    Pages[id] = f
    return f
end

local function gotoPage(id)
    for k,f in pairs(Pages) do f.Visible=(k==id) end
    ActivePage = id
end

