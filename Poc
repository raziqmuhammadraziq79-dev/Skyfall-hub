local function mkCorner(p,r) local c=Instance.new("UICorner",p) c.CornerRadius=UDim.new(0,r or 10) end
local function mkStroke(p,col,th) local s=Instance.new("UIStroke",p) s.Color=col s.Thickness=th or 1 end

local function mkCard(parent, x, y, w, h)
    local f = Instance.new("Frame")
    f.Position = UDim2.fromOffset(x,y)
    f.Size = UDim2.fromOffset(w,h)
    f.BackgroundColor3 = C.card
    f.BorderSizePixel = 0
    f.ZIndex = 3
    f.Parent = parent
    mkCorner(f,10)
    mkStroke(f,C.border,1)
    return f
end

local function mkLabel(parent,x,y,w,h,text,col,size,font,xa,zi)
    local l = Instance.new("TextLabel")
    l.Position = UDim2.fromOffset(x,y)
    l.Size = UDim2.fromOffset(w,h)
    l.BackgroundTransparency = 1
    l.Text = text or ""
    l.TextColor3 = col or C.text
    l.Font = font or Enum.Font.Gotham
    l.TextSize = size or 12
    l.TextXAlignment = xa or Enum.TextXAlignment.Left
    l.ZIndex = zi or 4
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = parent
    return l
end

local function mkSecLabel(parent, x, y, text)
    local l = mkLabel(parent,x,y,460,16,text,C.acc2,10,Enum.Font.GothamBold)
    return l
end

-- ══ TOGGLE (iOS pill style) ══
local function mkToggle(parent, x, y, label, setting, callback)
    local row = Instance.new("Frame")
    row.Position = UDim2.fromOffset(x,y)
    row.Size = UDim2.fromOffset(460,34)
    row.BackgroundTransparency = 1
    row.ZIndex = 4
    row.Parent = parent

    mkLabel(row,0,6,360,22,label,C.text,12,Enum.Font.Gotham,Enum.TextXAlignment.Left,5)

    local pill = Instance.new("Frame")
    pill.Size = UDim2.fromOffset(44,24)
    pill.Position = UDim2.fromOffset(400,5)
    pill.BackgroundColor3 = CFG[setting] and C.accent or Color3.fromRGB(50,40,75)
    pill.BorderSizePixel = 0
    pill.ZIndex = 5
    pill.Parent = row
    mkCorner(pill,12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18,18)
    knob.Position = CFG[setting] and UDim2.fromOffset(23,3) or UDim2.fromOffset(3,3)
    knob.BackgroundColor3 = C.white
    knob.BorderSizePixel = 0
    knob.ZIndex = 6
    knob.Parent = pill
    mkCorner(knob,9)

    local hitbox = Instance.new("TextButton")
    hitbox.Size = UDim2.new(1,0,1,0)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.ZIndex = 7
    hitbox.Parent = pill

    hitbox.MouseButton1Click:Connect(function()
        CFG[setting] = not CFG[setting]
        local on = CFG[setting]
        TweenService:Create(pill,TweenInfo.new(0.15),{
            BackgroundColor3 = on and C.accent or Color3.fromRGB(50,40,75)
        }):Play()
        TweenService:Create(knob,TweenInfo.new(0.15),{
            Position = on and UDim2.fromOffset(23,3) or UDim2.fromOffset(3,3)
        }):Play()
        if callback then pcall(callback,on) end
    end)
    return row
end

local function mkBtn(parent,x,y,w,h,text,col,callback)
    local btn = Instance.new("TextButton")
    btn.Position = UDim2.fromOffset(x,y)
    btn.Size = UDim2.fromOffset(w,h)
    btn.BackgroundColor3 = col or C.accent
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = C.white
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.ZIndex = 5
    btn.Parent = parent
    mkCorner(btn,8)
    btn.MouseButton1Click:Connect(function()
        pcall(callback)
        TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=C.acc2}):Play()
        task.wait(0.15)
        TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=col or C.accent}):Play()
    end)
    return btn
end

