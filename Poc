-- ══════════════════════════════════
local function D(t,props)
    local d=Drawing.new(t)
    for k,v in pairs(props) do d[k]=v end
    return d
end

local function clearUID(uid)
    if ESPCache[uid] then
        for k,v in pairs(ESPCache[uid]) do
            if k=="c" then for _,ln in ipairs(v) do pcall(function() ln:Remove() end) end
            else pcall(function() v:Remove() end) end
        end
        ESPCache[uid]=nil
    end
end

local function buildCache(uid)
    local c={}
    for i=1,8 do c[i]=D("Line",{Thickness=2.5,Color=CFG.EnemyBox,Transparency=1,Visible=false}) end
    ESPCache[uid]={
        tracer=D("Line",{Thickness=2,Color=CFG.EnemyTracer,Transparency=1,Visible=false}),
        c=c,
        dot=D("Circle",{Radius=5,Color=CFG.EnemyBox,Filled=true,Thickness=1,Transparency=1,Visible=false}),
        ring=D("Circle",{Radius=22,Color=CFG.LockedColor,Filled=false,Thickness=2,Transparency=1,Visible=false}),
        hpBg=D("Line",{Thickness=4,Color=Color3.fromRGB(50,0,0),Transparency=1,Visible=false}),
        hpFill=D("Line",{Thickness=4,Color=Color3.fromRGB(0,255,80),Transparency=1,Visible=false}),
        name=D("Text",{Size=13,Color=C.white,Outline=true,OutlineColor=Color3.new(0,0,0),Center=true,Visible=false}),
        dist=D("Text",{Size=11,Color=C.acc2,Outline=true,OutlineColor=Color3.new(0,0,0),Center=true,Visible=false}),
    }
end

local function hideUID(uid)
    if not ESPCache[uid] then return end
    local e=ESPCache[uid]
    for k,v in pairs(e) do
        if k=="c" then for _,ln in ipairs(v) do ln.Visible=false end
        else pcall(function() v.Visible=false end) end
    end
end

local function getRelation(p)
    if p==LP then return "self" end
    pcall(function()
        if LP.Team~=nil and p.Team~=nil then
            return LP.Team==p.Team and "team" or "enemy"
        end
    end)
    return "enemy"
end

local function isAlive(p)
    local c=p.Character if not c then return false end
    local h=c:FindFirstChildOfClass("Humanoid")
    local r=c:FindFirstChild("HumanoidRootPart")
    return h and h.Health>0 and r~=nil
end

local function getBounds(char)
    local hrp=char:FindFirstChild("HumanoidRootPart")
    local head=char:FindFirstChild("Head")
    if not hrp or not head then return nil end
    local rS,rV=Camera:WorldToViewportPoint(hrp.Position)
    local hS,_=Camera:WorldToViewportPoint(head.Position+Vector3.new(0,0.75,0))
    local fS,_=Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3.0,0))
    if not rV or rS.Z<=0 then return nil end
    local ht=math.abs(hS.Y-fS.Y) if ht<5 then return nil end
    local wd=ht*0.55 local cx=rS.X
    return {
        headPos=Vector2.new(hS.X,hS.Y), botPos=Vector2.new(cx,fS.Y),
        TL=Vector2.new(cx-wd/2,hS.Y), TR=Vector2.new(cx+wd/2,hS.Y),
        BL=Vector2.new(cx-wd/2,fS.Y), BR=Vector2.new(cx+wd/2,fS.Y),
        width=wd, height=ht,
    }
end

local function getDist(p)
    local c=p.Character if not c then return 0 end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    local lh=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not lh then return 0 end
    return math.floor((hrp.Position-lh.Position).Magnitude)
end

local function drawCorners(cc,b,col)
    local L=math.min(b.width,b.height)*0.26
    local pts={
        {b.TL,Vector2.new(b.TL.X+L,b.TL.Y),Vector2.new(b.TL.X,b.TL.Y+L)},
        {b.TR,Vector2.new(b.TR.X-L,b.TR.Y),Vector2.new(b.TR.X,b.TR.Y+L)},
        {b.BL,Vector2.new(b.BL.X+L,b.BL.Y),Vector2.new(b.BL.X,b.BL.Y-L)},
        {b.BR,Vector2.new(b.BR.X-L,b.BR.Y),Vector2.new(b.BR.X,b.BR.Y-L)},
    }
    local i=1
    for _,pt in ipairs(pts) do
        cc[i].From=pt[1];cc[i].To=pt[2];cc[i].Color=col;cc[i].Visible=true;i=i+1
        cc[i].From=pt[1];cc[i].To=pt[3];cc[i].Color=col;cc[i].Visible=true;i=i+1
    end
end

local function getPredicted(p)
    local c=p.Character if not c then return nil end
    local hrp=c:FindFirstChild("HumanoidRootPart") if not hrp then return nil end
    local uid=p.UserId local cur=hrp.Position
    if PrevPos[uid] then
        local v=(cur-PrevPos[uid])/0.016
        PrevPos[uid]=cur return cur+v*CFG.PredFactor
    end
    PrevPos[uid]=cur return cur
end

local function getNearest()
    local cx=Camera.ViewportSize.X/2 local cy=Camera.ViewportSize.Y/2
    local best,bD=nil,CFG.FOV*CFG.FOV
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and isAlive(p) and getRelation(p)=="enemy" then
            local head=p.Character:FindFirstChild(CFG.AimPart)
            if head then
                local pos=CFG.Prediction and getPredicted(p) or head.Position
                if pos then
                    local sp,vis=Camera:WorldToViewportPoint(pos)
                    if vis and sp.Z>0 then
                        local d=(sp.X-cx)^2+(sp.Y-cy)^2
                        if d<bD then bD=d best=p end
                    end
                end
            end
        end
    end
    return best
end

local function patchAmmo(char)
    if not char then return end
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            for _,v in ipairs(tool:GetDescendants()) do
                if v:IsA("IntValue") or v:IsA("NumberValue") then
                    local n=v.Name:lower()
                    if n:find("ammo") or n:find("bullet") or n:find("clip") or n:find("mag") then
                        pcall(function()
                            v.Value=999999
                            v.Changed:Connect(function() if CFG.InfAmmo then v.Value=999999 end end)
                        end)
                    end
                end
            end
        end
    end
end

local function fireWeapon(target)
    local now=tick()
    if now-LastShot<0.016 then return end LastShot=now
    local char=LP.Character if not char then return end
    local head=target and target.Character and target.Character:FindFirstChild("Head")
    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function() tool:Activate() end)
            for _,v in ipairs(tool:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    pcall(function()
                        if head then v:FireServer(head.Position,head.Position,head,true) v:FireServer(head.Position) end
                        v:FireServer()
                    end)
                end
                if v:IsA("BindableEvent") then pcall(function() v:Fire() end) end
            end
        end
    end
end

local function hookChar(char)
    patchAmmo(char)
    char.ChildAdded:Connect(function(c) task.wait(0.05) if c:IsA("Tool") then patchAmmo(char) end end)
end
if LP.Character then hookChar(LP.Character) end
LP.CharacterAdded:Connect(hookChar)

