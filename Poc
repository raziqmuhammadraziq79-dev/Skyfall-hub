-- ══ MAIN LOOP ══
RunService.RenderStepped:Connect(function()
    local vp=Camera.ViewportSize
    local cx=vp.X/2 local cy=vp.Y/2

    if CFG.AntiDetect then
        JitterOff=Vector2.new(math.random(-1,1)*0.008,math.random(-1,1)*0.008)
    end

    fovC.Position=Vector2.new(cx,cy) fovC.Visible=CFG.FOVCircle and CFG.Aimbot
    chH.From=Vector2.new(cx-10,cy);chH.To=Vector2.new(cx+10,cy);chH.Visible=CFG.Crosshair
    chV.From=Vector2.new(cx,cy-10);chV.To=Vector2.new(cx,cy+10);chV.Visible=CFG.Crosshair
    chDot.Position=Vector2.new(cx,cy);chDot.Visible=CFG.Crosshair

    if CFG.NoRecoil then
        local c=LP.Character if c then
            local r=c:FindFirstChild("HumanoidRootPart")
            if r then pcall(function() r.RotVelocity=Vector3.zero end) end
        end
    end

    local active={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP or not isAlive(p) then goto cont end
        local rel=getRelation(p)
        local uid=p.UserId
        active[uid]=true
        if not ESPCache[uid] then buildCache(uid) end
        local e=ESPCache[uid]
        local b=getBounds(p.Character)
        local locked=(LockedTarget==p)
        local hum=p.Character:FindFirstChildOfClass("Humanoid")

        if CFG.Chams then
            if rel=="enemy" then applyChams(p,CFG.ChamsEnemy)
            elseif rel=="team" then applyChams(p,CFG.ChamsTeam) end
        else removeChams(p) end

        if not b or not CFG.ESP then hideUID(uid) goto cont end

        local showTracer=false local tracerCol=CFG.EnemyTracer
        if CFG.TracerMode=="enemy" then showTracer=(rel=="enemy") tracerCol=CFG.EnemyTracer
        elseif CFG.TracerMode=="team" then showTracer=(rel=="team") tracerCol=CFG.TeamTracer
        elseif CFG.TracerMode=="all" then showTracer=true tracerCol=rel=="enemy" and CFG.EnemyTracer or CFG.TeamTracer end

        local tFrom=CFG.SnapLine and Vector2.new(cx,cy) or Vector2.new(cx,vp.Y)
        e.tracer.From=tFrom e.tracer.To=b.botPos e.tracer.Color=tracerCol e.tracer.Visible=showTracer

        local bc=locked and CFG.LockedColor or (rel=="enemy" and CFG.EnemyBox or CFG.TeamBox)
        drawCorners(e.c,b,bc)

        e.dot.Position=b.headPos e.dot.Color=locked and CFG.LockedColor or bc
        e.dot.Radius=locked and 8 or 5 e.dot.Visible=CFG.HeadDot

        e.ring.Position=b.headPos e.ring.Visible=locked and rel=="enemy"

        local pfx=rel=="enemy" and (locked and "🔒 " or "💀 ") or "👥 "
        e.name.Text=pfx..p.DisplayName
        e.name.Position=Vector2.new(b.headPos.X,b.headPos.Y-20)
        e.name.Color=rel=="enemy" and C.white or CFG.TeamBox e.name.Visible=true

        if CFG.DistanceESP then
            e.dist.Text=getDist(p).."m"
            e.dist.Position=Vector2.new(b.headPos.X,b.botPos.Y+4) e.dist.Visible=true
        else e.dist.Visible=false end

        if CFG.HealthBar and hum then
            local ratio=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            local bx=b.BL.X-6
            e.hpBg.From=Vector2.new(bx,b.TL.Y) e.hpBg.To=Vector2.new(bx,b.BL.Y) e.hpBg.Visible=true
            local ft=b.TL.Y+(b.BL.Y-b.TL.Y)*(1-ratio)
            e.hpFill.From=Vector2.new(bx,ft) e.hpFill.To=Vector2.new(bx,b.BL.Y)
            e.hpFill.Color=Color3.fromRGB(math.floor(255*(1-ratio)),math.floor(255*ratio),0)
            e.hpFill.Visible=true
        else e.hpBg.Visible=false e.hpFill.Visible=false end

        ::cont::
    end

    for uid in pairs(ESPCache) do if not active[uid] then clearUID(uid) end end

    if CFG.Aimbot then
        local target=getNearest()
        if target then
            LockedTarget=target IsLocked=true
            local head=target.Character and target.Character:FindFirstChild(CFG.AimPart)
            if head then
                local aimPos=CFG.Prediction and getPredicted(target) or head.Position
                if aimPos then
                    local jPos=CFG.AntiDetect and (aimPos+Vector3.new(JitterOff.X,JitterOff.Y,0)) or aimPos
                    Camera.CFrame=Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,jPos),1-CFG.Smooth)
                end
            end
            if CFG.AutoShoot then fireWeapon(target) end
        else LockedTarget=nil IsLocked=false end
    end
end)

