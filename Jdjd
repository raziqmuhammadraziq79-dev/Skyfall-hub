-- Roblox Script for Delta Executor with Admin Panel and Toggle Features

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = game:GetService("Workspace").CurrentCamera

-- Toggle Variables
local espEnabled = true
local silentAimEnabled = true
local autoLockEnabled = true

-- Create Admin Panel
local function createAdminPanel()
    local screenGui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
    local toggleESP = Instance.new("TextButton", screenGui)
    toggleESP.Size = UDim2.new(0, 200, 0, 50)
    toggleESP.Position = UDim2.new(0, 10, 0, 10)
    toggleESP.Text = "Toggle ESP"
    
    local toggleSilentAim = Instance.new("TextButton", screenGui)
    toggleSilentAim.Size = UDim2.new(0, 200, 0, 50)
    toggleSilentAim.Position = UDim2.new(0, 10, 0, 70)
    toggleSilentAim.Text = "Toggle Silent Aim"

    local toggleAutoLock = Instance.new("TextButton", screenGui)
    toggleAutoLock.Size = UDim2.new(0, 200, 0, 50)
    toggleAutoLock.Position = UDim2.new(0, 10, 0, 130)
    toggleAutoLock.Text = "Toggle Auto Lock"

    -- Button Functions
    toggleESP.MouseButton1Click:Connect(function()
        espEnabled = not espEnabled
        toggleESP.Text = espEnabled and "ESP: ON" or "ESP: OFF"
    end)

    toggleSilentAim.MouseButton1Click:Connect(function()
        silentAimEnabled = not silentAimEnabled
        toggleSilentAim.Text = silentAimEnabled and "Silent Aim: ON" or "Silent Aim: OFF"
    end)

    toggleAutoLock.MouseButton1Click:Connect(function()
        autoLockEnabled = not autoLockEnabled
        toggleAutoLock.Text = autoLockEnabled and "Auto Lock: ON" or "Auto Lock: OFF"
    end)
end

-- ESP Function
function createESP(target)
    if espEnabled then
        local highlight = Instance.new("Highlight")
        highlight.Parent = target
        highlight.FillColor = Color3.new(1, 0, 0) -- Red color for enemy
        highlight.OutlineColor = Color3.new(0, 0, 0) -- Black outline
    end
end

-- Aimbot Function
function aimbot()
    if silentAimEnabled then
        local closestEnemy = nil
        local shortestDistance = math.huge

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (Camera.CFrame.Position - player.Character.HumanoidRootPart.Position).magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestEnemy = player
                end
            end
        end

        if closestEnemy then
            -- Silent Aim Logic
            local targetPosition = closestEnemy.Character.HumanoidRootPart.Position
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPosition)
            -- Add shooting logic here
        end
    end
end

-- Auto Search Lock Function
function autoSearchLock()
    while wait(0.1) do
        if autoLockEnabled then
            aimbot()
        end
    end
end

-- ESP for all enemies
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        createESP(player.Character)
    end
end

-- Start the auto search lock
createAdminPanel()
autoSearchLock()
