-- Toggle button factory
local function makeToggle(parent, label, yPos, state, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 38)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = state and Color3.fromRGB(30, 160, 60) or Color3.fromRGB(160, 30, 30)
    btn.Text = label .. (state and "  [ON]" or "  [OFF]")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = parent

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 6)
    bc.Parent = btn

    local enabled = state
    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        callback(enabled)
        btn.BackgroundColor3 = enabled and Color3.fromRGB(30, 160, 60) or Color3.fromRGB(160, 30, 30)
        btn.Text = label .. (enabled and "  [ON]" or "  [OFF]")
    end)
    return btn
end

makeToggle(MainFrame, "ESP Box + Trace", 46, Config.ESP.Enabled, function(v)
    Config.ESP.Enabled = v
    if not v then
        for _, objs in pairs(ESPObjects) do
            for _, obj in ipairs(objs) do obj.line.Visible = false end
        end
    end
end)

makeToggle(MainFrame, "Aimbot Head Lock", 96, Config.Aimbot.Enabled, function(v)
    Config.Aimbot.Enabled = v
    if not v then LockedTarget = nil end
end)

makeToggle(MainFrame, "Auto Lock Enemy", 146, Config.Aimbot.AutoLock, function(v)
    Config.Aimbot.AutoLock = v
end)

-- Hide Panel button (-)
local HideBtn = Instance.new("TextButton")
HideBtn.Size = UDim2.new(0.9, 0, 0, 38)
HideBtn.Position = UDim2.new(0.05, 0, 0, 200)
HideBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
HideBtn.Text = "(-) Toggle Panel"
HideBtn.TextColor3 = Color3.fromRGB(200, 200, 255)
HideBtn.TextSize = 13
HideBtn.Font = Enum.Font.GothamSemibold
HideBtn.Parent = MainFrame

local HideCorner = Instance.new("UICorner")
HideCorner.CornerRadius = UDim.new(0, 6)
HideCorner.Parent = HideBtn

local ContentVisible = true
local toggleParts = {MainFrame:GetChildren()}

local function togglePanel()
    ContentVisible = not ContentVisible
    for _, child in ipairs(MainFrame:GetChildren()) do
        if child ~= HideBtn and child ~= Title and child.ClassName ~= "UICorner" then
            if child:IsA("GuiObject") then
                child.Visible = ContentVisible
            end
        end
    end
    MainFrame.Size = ContentVisible and UDim2.new(0, 260, 0, 280) or UDim2.new(0, 260, 0, 80)
end

HideBtn.MouseButton1Click:Connect(togglePanel)

-- Keyboard (-) toggle
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.Minus then
        togglePanel()
    end
end)

-- ══════════════════════════════════
-- MAIN LOOP
-- ══════════════════════════════════
RunService.RenderStepped:Connect(function()
    updateESP()
    runAimbot()
end)

-- Cleanup on player leave
Players.PlayerRemoving:Connect(function(player)
    removeESPForPlayer(player)
    if LockedTarget == player then LockedTarget = nil end
end)
