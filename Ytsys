    ESP = {
        Enabled = true,
        BoxColor = Color3.fromRGB(255, 50, 50),
        TraceColor = Color3.fromRGB(255, 200, 0),
        BoxThickness = 1.5,
        TraceThickness = 1,
    },
    Aimbot = {
        Enabled = true,
        TargetPart = "Head",
        FOV = 300,
        Smoothness = 0.15,
        AutoLock = true,
    },
