-- ══════════════════════════════════
-- STATE
-- ══════════════════════════════════
local ESPObjects = {}
local LockedTarget = nil
local PanelOpen = true

-- ══════════════════════════════════
-- UTILS
-- ══════════════════════════════════
local function isEnemy(player)
    return player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0
end

local function getScreenPos(worldPos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local function getCharBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local rootPos = hrp.Position
    local top = rootPos + Vector3.new(0, 3.5, 0)
    local bot = rootPos + Vector3.new(0, -3.2, 0)
    local topScreen, onScreen = getScreenPos(top)
    local botScreen = getScreenPos(bot)
    if not onScreen then return nil end
    local height = math.abs(topScreen.Y - botScreen.Y)
    local width = height * 0.55
    return {
        topScreen = topScreen,
        botScreen = botScreen,
        height = height,
        width = width,
        center = Vector2.new(topScreen.X, (topScreen.Y + botScreen.Y) / 2)
    }
end

local function getNearestEnemy()
    local closest = nil
    local closestDist = Config.Aimbot.FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local screenPos, onScreen = getScreenPos(head.Position)
                if onScreen then
                    local dist = (screenPos - center).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

-- ══════════════════════════════════
-- ESP DRAWING
-- ══════════════════════════════════
local function createESPForPlayer(player)
    local drawings = {}

    -- Box (4 lines)
    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Thickness = Config.ESP.BoxThickness
        line.Color = Config.ESP.BoxColor
        line.Visible = false
        table.insert(drawings, {type="box", line=line})
    end

    -- Trace line
    local trace = Drawing.new("Line")
    trace.Thickness = Config.ESP.TraceThickness
    trace.Color = Config.ESP.TraceColor
    trace.Visible = false
    table.insert(drawings, {type="trace", line=trace})

    ESPObjects[player] = drawings
end

local function removeESPForPlayer(player)
    if ESPObjects[player] then
        for _, obj in ipairs(ESPObjects[player]) do
            obj.line:Remove()
        end
        ESPObjects[player] = nil
    end
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            if not ESPObjects[player] then
                createESPForPlayer(player)
            end
            local drawings = ESPObjects[player]
            local box = getCharBox(player.Character)
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

            if box and Config.ESP.Enabled then
                local x = box.topScreen.X - box.width / 2
                local y = box.topScreen.Y
                local w = box.width
                local h = box.height

                -- Top
                drawings[1].line.From = Vector2.new(x, y)
                drawings[1].line.To = Vector2.new(x + w, y)
                -- Bottom
                drawings[2].line.From = Vector2.new(x, y + h)
                drawings[2].line.To = Vector2.new(x + w, y + h)
                -- Left
                drawings[3].line.From = Vector2.new(x, y)
                drawings[3].line.To = Vector2.new(x, y + h)
                -- Right
                drawings[4].line.From = Vector2.new(x + w, y)
                drawings[4].line.To = Vector2.new(x + w, y + h)

                for i = 1, 4 do drawings[i].line.Visible = true end

                -- Trace
                drawings[5].line.From = screenCenter
                drawings[5].line.To = box.botScreen
                drawings[5].line.Visible = true
            else
                for _, obj in ipairs(drawings) do
                    obj.line.Visible = false
                end
            end
        else
            removeESPForPlayer(player)
        end
    end
end

-- ══════════════════════════════════
-- AIMBOT
-- ══════════════════════════════════
local function runAimbot()
    if not Config.Aimbot.Enabled then return end

    if Config.Aimbot.AutoLock then
        LockedTarget = getNearestEnemy()
    end

    if not LockedTarget or not isEnemy(LockedTarget) then
        LockedTarget = nil
        return
    end

    local targetPart = LockedTarget.Character:FindFirstChild(Config.Aimbot.TargetPart)
    if not targetPart then return end

    local targetPos = targetPart.Position
    local currentCF = Camera.CFrame
    local lookAt = CFrame.lookAt(currentCF.Position, targetPos)
    Camera.CFrame = currentCF:Lerp(lookAt, Config.Aimbot.Smoothness)
end

