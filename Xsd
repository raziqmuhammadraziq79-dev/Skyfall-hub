UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    
    -- H = Spawn God Helicopter
    if input.KeyCode == Enum.KeyCode.H then
        spawnGodHelicopter()
    end
    
    -- J = Spawn ALL Vehicles
    if input.KeyCode == Enum.KeyCode.J then
        spawnAllVehicles()
    end
    
    -- G = Refill everything to god
    if input.KeyCode == Enum.KeyCode.G then
        humanoid.Health = GOD_HEALTH
        for _, v in ipairs(spawnedVehicles) do
            if v and v.Parent then overrideVehicle(v) end
        end
        print("✅ All stats refilled to GOD tier")
    end
    
    -- K = Nuke all spawned vehicles + respawn fresh
    if input.KeyCode == Enum.KeyCode.K then
        for _, v in ipairs(spawnedVehicles) do
            if v and v.Parent then v:Destroy() end
        end
        spawnedVehicles = {}
        spawnGodHelicopter()
        print("✅ Vehicles nuked + fresh helicopter spawned")
    end
    
    -- L = Rescan all modules again
    if input.KeyCode == Enum.KeyCode.L then
        scannedModules = {}
        scanAndOverride(ReplicatedStorage)
        scanAndOverride(Workspace)
        print("✅ Full rescan complete")
    end
end)

