-- ========================================================
-- SECTION 2: DEEP SCAN + OVERRIDE ALL MODULES
-- ========================================================

local function overrideWeaponData(data)
    if type(data) ~= "table" then return end
    
    -- Core damage
    local damageKeys = {
        "Damage","BodyDamage","HeadDamage","LimbDamage",
        "HeadshotMultiplier","DamageMultiplier","ExplosionDamage",
        "RocketDamage","MissileDamage","GunDamage","TurretDamage",
        "VehicleDamage","SplashDamage","BurnDamage","ToxicDamage"
    }
    for _, k in ipairs(damageKeys) do
        if data[k] ~= nil then data[k] = GOD_DAMAGE end
        data[k] = GOD_DAMAGE
    end
    
    -- Infinite ammo
    local ammoKeys = {
        "MagSize","MaxAmmo","Ammo","ReserveAmmo","TotalAmmo",
        "VehicleAmmo","MaxVehicleAmmo","RocketAmmo","MissileAmmo",
        "GrenadeAmmo","TurretAmmo","BombAmmo","TankAmmo","HeliAmmo",
        "PrimaryAmmo","SecondaryAmmo","StoredAmmo","ClipSize","MaxClip"
    }
    for _, k in ipairs(ammoKeys) do
        data[k] = GOD_AMMO
    end
    
    -- Zero timers
    local zeroKeys = {
        "ReloadTime","ReloadDuration","FireRate","RateOfFire","FireDelay",
        "Cooldown","WeaponCooldown","SpawnCooldown","RespawnTime","DespawnTime",
        "RocketCooldown","MissileCooldown","GunCooldown","TurretCooldown",
        "SwapTime","DrawTime","HolsterTime","AimTime","EquipTime",
        "ChargeCooldown","AbilityCooldown","ThrowCooldown","MeleeCooldown"
    }
    for _, k in ipairs(zeroKeys) do
        data[k] = ZERO
    end
    
    -- Perfect accuracy
    local accuracyKeys = {
        "Spread","MaxSpread","SpreadPerShot","MinSpread",
        "Bloom","BloomPerShot","MaxBloom","BloomRecovery",
        "RecoilX","RecoilY","RecoilZ","KickForce",
        "ClimbPerShot","MaxClimb","ShakeMagnitude","ShakeRoughness",
        "ViewmodelRecoil","CameraRecoil","HipSpread","AimSpread",
        "MovementSpread","JumpSpread","CrouchSpread"
    }
    for _, k in ipairs(accuracyKeys) do
        data[k] = ZERO
    end
    
    -- Infinite range + instant bullet
    local rangeKeys = {
        "Range","MaxRange","BulletSpeed","MuzzleVelocity",
        "ProjectileSpeed","BulletDrop","Gravity","BulletLifetime",
        "MissileSpeed","RocketSpeed","TrajectorySpeed"
    }
    for _, k in ipairs(rangeKeys) do
        if k == "BulletDrop" or k == "Gravity" then
            data[k] = ZERO
        else
            data[k] = GOD_AMMO
        end
    end
    
    -- Vehicle stats
    local vehicleKeys = {
        "Health","MaxHealth","Armor","ShieldHealth","MaxShieldHealth",
        "Speed","MaxSpeed","Acceleration","TurningSpeed","BoostSpeed",
        "FuelCapacity","Fuel","FuelConsumption","FuelRegen",
        "RepairRate","ShieldRegen"
    }
    for _, k in ipairs(vehicleKeys) do
        if k == "FuelConsumption" then
            data[k] = ZERO
        else
            data[k] = GOD_HEALTH
        end
    end
end

-- ========================================================
-- SECTION 3: MASS MODULE SCANNER (FULL GAME SCAN)
-- ========================================================

local scannedModules = {}

local function scanAndOverride(root)
    if not root then return end
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("ModuleScript") and not scannedModules[obj] then
            local success, data = pcall(function() return require(obj) end)
            if success and type(data) == "table" then
                overrideWeaponData(data)
                scannedModules[obj] = true
            end
        end
    end
end

-- Scan all possible locations
scanAndOverride(ReplicatedStorage)
scanAndOverride(Workspace)
scanAndOverride(game:GetService("ServerStorage"))

print("✅ Deep scan complete — all modules overridden")

-- ========================================================
-- SECTION 4: VEHICLE RUNTIME OVERRIDE
-- ========================================================

local function overrideVehicle(vehicle)
    -- Humanoid
    local hum = vehicle:FindFirstChild("Humanoid")
    if hum then
        hum.MaxHealth = GOD_HEALTH
        hum.Health = GOD_HEALTH
    end
    
    -- All value types inside vehicle
    for _, obj in ipairs(vehicle:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            local name = obj.Name:lower()
            if string.find(name, "ammo") or string.find(name, "fuel") or 
               string.find(name, "health") or string.find(name, "armor") then
                obj.Value = GOD_AMMO
            elseif string.find(name, "cooldown") or string.find(name, "reload") or
                   string.find(name, "wait") or string.find(name, "delay") or
                   string.find(name, "timer") then
                obj.Value = ZERO
            end
        end
        
        -- BasePart anchored protection
        if obj:IsA("BasePart") then
            obj.CanCollide = true
        end
    end
end

-- ========================================================
-- SECTION 5: HELICOPTER GOD SPAWN
-- ========================================================

local spawnedVehicles = {}

local function spawnGodHelicopter()
    local templates = {
        ReplicatedStorage:FindFirstChild("Helicopter"),
        ReplicatedStorage:FindFirstChild("Heli"),
        Workspace:FindFirstChild("Helicopter"),
        Workspace:FindFirstChild("Heli"),
    }
    
    local template = nil
    for _, t in ipairs(templates) do
        if t then template = t break end
    end
    
    if not template then
        -- Fallback: scan for any helicopter model
        for _, obj in ipairs(ReplicatedStorage:GetChildren()) do
            if obj:IsA("Model") and (
                string.find(obj.Name:lower(), "heli") or 
                string.find(obj.Name:lower(), "chopper") or
                string.find(obj.Name:lower(), "aircraft")
            ) then
                template = obj
                break
            end
        end
    end
    
    if template then
        local heli = template:Clone()
        heli.Parent = Workspace
        
        local spawnPos = humanoidRootPart.Position + Vector3.new(0, 60, 0)
        heli:MoveTo(spawnPos)
        
        overrideVehicle(heli)
        table.insert(spawnedVehicles, heli)
        
        print("✅ God Helicopter spawned at Y+" .. tostring(spawnPos.Y))
        return heli
    else
        warn("❌ Helicopter template not found in ReplicatedStorage or Workspace")
    end
end

-- ========================================================
-- SECTION 6: ALL VEHICLE GOD SPAWN
-- ========================================================

local vehicleNames = {
    "Tank", "Jeep", "Truck", "Jet", "Plane",
    "APC", "Boat", "UAV", "Drone", "Car",
    "Motorcycle", "Humvee", "Helicopter", "Heli"
}

local function spawnAllVehicles()
    for _, name in ipairs(vehicleNames) do
        local template = ReplicatedStorage:FindFirstChild(name)
                      or Workspace:FindFirstChild(name)
        if template and template:IsA("Model") then
            local v = template:Clone()
            v.Parent = Workspace
            v:MoveTo(humanoidRootPart.Position + Vector3.new(
                math.random(-20, 20), 5, math.random(-20, 20)
            ))
            overrideVehicle(v)
            table.insert(spawnedVehicles, v)
            print("✅ Spawned: " .. name)
        end
    end
end

-- ========================================================
-- SECTION 7: CONTINUOUS GOD SYNC (HEARTBEAT)
-- ========================================================

RunService.Heartbeat:Connect(function()
    -- Player stats
    if humanoid and humanoid.Parent then
        if humanoid.Health < GOD_HEALTH then
            humanoid.Health = GOD_HEALTH
        end
    end
    
    -- All workspace vehicles sync
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") then
            local hum = obj:FindFirstChild("Humanoid")
            if hum then
                hum.Health = GOD_HEALTH
                hum.MaxHealth = GOD_HEALTH
            end
            
            for _, val in ipairs(obj:GetDescendants()) do
                if val:IsA("NumberValue") or val:IsA("IntValue") then
                    local n = val.Name:lower()
                    if string.find(n, "ammo") then val.Value = GOD_AMMO end
                    if string.find(n, "fuel") then val.Value = GOD_AMMO end
                    if string.find(n, "cooldown") then val.Value = ZERO end
                    if string.find(n, "reload") then val.Value = ZERO end
                end
            end
        end
    end
    
    -- Player equipped weapon ammo sync
    local tool = character:FindFirstChildWhichIsA("Tool")
    if tool then
        local ammo = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AmmoValue")
        if ammo then ammo.Value = GOD_AMMO end
    end
end)

