-- toggle row inside card
local function makeToggleRow(parent,icon,label,setting,yOff,callback)
    local row=Instance.new("Frame")
    row.Size=UDim2.new(1,-16,0,36)
    row.Position=UDim2.new(0,8,0,yOff or 0)
    row.BackgroundTransparency=1
    row.Parent=parent

    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,-70,1,0)
    lbl.BackgroundTransparency=1
    lbl.Text=(icon and (icon.."  ") or "")..label
    lbl.TextColor3=T.text
    lbl.Font=Enum.Font.Gotham
    lbl.TextSize=12
    lbl.TextXAlignment=Enum.TextXAlignment.Left
    lbl.Parent=row

    local tog=Instance.new("Frame")
    tog.Size=UDim2.new(0,44,0,24)
    tog.Position=UDim2.new(1,-52,0.5,-12)
    tog.BackgroundColor3=CFG[setting] and T.accent or Color3.fromRGB(50,40,70)
    tog.BorderSizePixel=0
    tog.Parent=row
    Instance.new("UICorner",tog).CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame")
    knob.Size=UDim2.new(0,18,0,18)
    knob.Position=CFG[setting] and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)
    knob.BackgroundColor3=Color3.new(1,1,1)
    knob.BorderSizePixel=0 knob.Parent=tog
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,1,0)
    btn.BackgroundTransparency=1 btn.Text=""
    btn.Parent=tog

    btn.MouseButton1Click:Connect(function()
        CFG[setting]=not CFG[setting]
        local on=CFG[setting]
        TweenService:Create(tog,TweenInfo.new(0.15),{BackgroundColor3=on and T.accent or Color3.fromRGB(50,40,70)}):Play()
        TweenService:Create(knob,TweenInfo.new(0.15),{Position=on and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)}):Play()
        if callback then callback(on) end
    end)
    return row
end

