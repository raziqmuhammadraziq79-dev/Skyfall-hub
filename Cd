-- ============================================
-- ROBLOX ESP + AIMBOT SCRIPT
-- Compatible: Delta Executor, Android, iOS
-- ============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

-- ============================================
-- CONFIGURATION
-- ============================================

local Config = {
    ESPEnabled = true,
    AimbotEnabled = true,
    TargetEnemyOnly = true,
    AimPart = "Head",
    Smoothness = 0.15,
    MaxDistance = 500,
    ToggleKey = Enum.KeyCode.E,
    HideKey = Enum.KeyCode.Minus,
    UIVisible = true
}

local ESPBoxes = {}
local CurrentTarget = nil

-- ============================================
-- ESP SYSTEM
-- ============================================

local function CreateESPBox(Player)
    if ESPBoxes[Player] then return end
    
    local Box = Instance.new("BillboardGui")
    Box.Size = UDim2.new(4, 0, 5, 0)
    Box.MaxDistance = Config.MaxDistance
    Box.Adornee = Player.Character:FindFirstChild("Head")
    Box.Parent = Player.Character:FindFirstChild("Head")
    
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 1, 0)
    Frame.BackgroundTransparency = 1
    Frame.Parent = Box
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 4)
    Corner.Parent = Frame
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(0, 255, 0)
    Stroke.Thickness = 2
    Stroke.Parent = Frame
    
    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(1, 0, 0.2, 0)
    NameLabel.BackgroundTransparency = 0.3
    NameLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    NameLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    NameLabel.TextSize = 14
    NameLabel.Font = Enum.Font.GothamBold
    NameLabel.Text = Player.Name
    NameLabel.Parent = Frame
    
    ESPBoxes[Player] = Box
end

local function RemoveESPBox(Player)
    if ESPBoxes[Player] then
        ESPBoxes[Player]:Destroy()
        ESPBoxes[Player] = nil
    end
end

local function UpdateESP()
    if not Config.ESPEnabled then return end
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= Players.LocalPlayer and Player.Character and Player.Character:FindFirstChild("Head") then
            if not ESPBoxes[Player] then
                CreateESPBox(Player)
            end
            
            local Box = ESPBoxes[Player]
            if Box and Box.Parent then
                local Distance = (Player.Character.Head.Position - Camera.Focus.Position).Magnitude
                
                if Distance > Config.MaxDistance then
                    Box.MaxDistance = 0
                else
                    Box.MaxDistance = Config.MaxDistance
                end
            end
        elseif ESPBoxes[Player] then
            RemoveESPBox(Player)
        end
    end
end

-- ============================================
-- AIMBOT SYSTEM
-- ============================================

local function GetClosestEnemy()
    local ClosestDistance = math.huge
    local ClosestPlayer = nil
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= Players.LocalPlayer and Player.Character then
            local Head = Player.Character:FindFirstChild("Head")
            if Head then
                local Distance = (Head.Position - Camera.Focus.Position).Magnitude
                
                if Distance < ClosestDistance and Distance < Config.MaxDistance then
                    ClosestDistance = Distance
                    ClosestPlayer = Player
                end
            end
        end
    end
    
    return ClosestPlayer
end

local function AimbotTick()
    if not Config.AimbotEnabled then
        CurrentTarget = nil
        return
    end
    
    CurrentTarget = GetClosestEnemy()
    
    if CurrentTarget and CurrentTarget.Character then
        local TargetPart = CurrentTarget.Character:FindFirstChild(Config.AimPart)
        
        if TargetPart then
            local TargetPosition = TargetPart.Position
            local CameraPosition = Camera.CFrame.Position
            
            local Direction = (TargetPosition - CameraPosition).Unit
            local NewCFrame = CFrame.new(CameraPosition, CameraPosition + Direction)
            
            Camera.CFrame = Camera.CFrame:Lerp(NewCFrame, Config.Smoothness)
        end
    end
end

