-- ============================================
-- INPUT HANDLING
-- ============================================

UserInputService.InputBegan:Connect(function(Input, GameProcessed)
    if GameProcessed then return end
    
    if Input.KeyCode == Config.ToggleKey then
        Config.AimbotEnabled = not Config.AimbotEnabled
        AimbotToggle.Text = "AIMBOT: " .. (Config.AimbotEnabled and "ON" or "OFF")
        AimbotToggle.BackgroundColor3 = Config.AimbotEnabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    end
    
    if Input.KeyCode == Config.HideKey then
        Config.UIVisible = not Config.UIVisible
        MainFrame.Visible = Config.UIVisible
    end
end)

-- ============================================
-- MAIN LOOP
-- ============================================

RunService.RenderStepped:Connect(function()
    UpdateESP()
    AimbotTick()
end)

Players.PlayerAdded:Connect(function(Player)
    Player.CharacterAdded:Connect(function(Character)
        if Config.ESPEnabled then
            wait(0.1)
            CreateESPBox(Player)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(Player)
    RemoveESPBox(Player)
end)

print("[YORUKA] Aimbot Script Loaded | Delta Executor Ready")
