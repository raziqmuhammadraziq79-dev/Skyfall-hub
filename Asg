-- Hanami Crystal Diamond ESP & Aimbot
-- Compatible: Delta Executor (Android/iOS)
-- Style: Clean, Diamond Shape, Auto-Lock Head

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Konfigurasi
local Settings = {
    ESPEnabled = true,
    AimbotEnabled = true,
    FOV = 300, -- Radius deteksi aimbot
    Smoothness = 0.1, -- Kecepatan lock (0.1 = instan, 0.5 = halus)
    ColorEnemy = Color3.fromRGB(255, 50, 50), -- Merah Crystal
    ColorTeam = Color3.fromRGB(50, 255, 50),  -- Hijau Crystal
}

local ESPObjects = {}
local AimTarget = nil

-- Fungsi Membuat Visual Crystal Diamond
function CreateCrystalESP(Player)
    if Player == LocalPlayer then return end
    
    local Character = Player.Character
    if not Character then return end
    
    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    -- Drawing Square (Dirotasi 45 derajat menjadi Diamond)
    local Diamond = Drawing.new("Square")
    Diamond.Thickness = 2
    Diamond.Filled = false
    Diamond.Visible = false
    
    -- Tracer Line
    local Tracer = Drawing.new("Line")
    Tracer.Thickness = 1
    Tracer.Visible = false

    ESPObjects[Player] = {
        Diamond = Diamond,
        Tracer = Tracer,
        Root = Root
    }
end

-- Update Posisi & Render
function UpdateESP()
    if not Settings.ESPEnabled then
        for _, Data in pairs(ESPObjects) do
            Data.Diamond.Visible = false
            Data.Tracer.Visible = false
        end
        return
    end

    for _, Player in pairs(Players:GetPlayers()) do
        local Data = ESPObjects[Player]
        if Data and Data.Root then
            local Pos, OnScreen = Camera:WorldToViewportPoint(Data.Root.Position)
            
            if OnScreen then
                local Dist = (Camera.CFrame.Position - Data.Root.Position).Magnitude
                local Size = 600 / Dist -- Ukuran dinamis berdasarkan jarak
                
                -- Rotasi Diamond (Simulasi dengan Square)
                -- Kita gunakan Square biasa tapi ukurannya disesuaikan agar terlihat seperti outline berlian jika digabung dengan logic lain, 
                -- tapi untuk Drawing API sederhana, kita buat Square kecil di tengah sebagai "Core" Crystal
                
                Data.Diamond.Size = Vector2.new(Size/2, Size/2)
                Data.Diamond.Position = Vector2.new(Pos.X - Size/4, Pos.Y - Size/4)
                
                -- Cek Tim
                local IsEnemy = true
                if LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team then
                    IsEnemy = false
                end
                
                local Color = IsEnemy and Settings.ColorEnemy or Settings.ColorTeam
                Data.Diamond.Color = Color
                Data.Tracer.Color = Color

                -- Tracer Logic
                if IsEnemy then
                    Data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    Data.Tracer.To = Vector2.new(Pos.X, Pos.Y)
                    Data.Tracer.Visible = true
                else
                    Data.Tracer.Visible = false
                end
                
                Data.Diamond.Visible = true
            else
                Data.Diamond.Visible = false
                Data.Tracer.Visible = false
            end
        end
    end
end

-- Logika Aimbot Head Lock
function GetClosestTarget()
    local ClosestDist = math.huge
    local Target = nil
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            local Root = Player.Character:FindFirstChild("HumanoidRootPart")
            local Head = Player.Character:FindFirstChild("Head")
            
            if Root and Head then
                local Pos, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                local Dist = (Vector2.new(Pos.X, Pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                
                -- Cek Tim
                local IsEnemy = true
                if LocalPlayer.Team and Player.Team and LocalPlayer.Team == Player.Team then
                    IsEnemy = false
                end

                if Dist < Settings.FOV and IsEnemy and OnScreen then
                    if Dist < ClosestDist then
                        ClosestDist = Dist
                        Target = Head
                    end
                end
            end
        end
    end
    return Target
end

-- Loop Aimbot
RunService.RenderStepped:Connect(function()
    if Settings.AimbotEnabled then
        local TargetHead = GetClosestTarget()
        if TargetHead then
            -- Silent Aim: Mengubah CFrame Camera ke arah kepala musuh
            local TargetPos = TargetHead.Position
            local CurrentCFrame = Camera.CFrame
            local LookAtCFrame = CFrame.new(CurrentCFrame.Position, TargetPos)
            
            -- Interpolasi halus
            Camera.CFrame = CurrentCFrame:Lerp(LookAtCFrame, Settings.Smoothness)
        end
    end
end)

-- Event Handler
Players.PlayerAdded:Connect(function(Player)
    Player.CharacterAdded:Connect(function(Char)
        task.wait(1)
        CreateCrystalESP(Player)
    end)
    if Player.Character then CreateCrystalESP(Player) end
end)

Players.PlayerRemoving:Connect(function(Player)
    if ESPObjects[Player] then
        for _, Obj in pairs(ESPObjects[Player]) do
            if Obj.Remove then Obj:Remove() end
        end
        ESPObjects[Player] = nil
    end
end)

-- Inisialisasi Awal
for _, Player in pairs(Players:GetPlayers()) do
    if Player.Character then CreateCrystalESP(Player) end
end

-- UI Toggle Sederhana (Floating Button)
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game.CoreGui

local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Size = UDim2.new(0, 80, 0, 40)
ToggleBtn.Position = UDim2.new(0, 10, 0, 10)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
ToggleBtn.BackgroundTransparency = 0.5
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.Text = "HANAMI ON"
ToggleBtn.Font = Enum.Font.Code
ToggleBtn.Parent = ScreenGui

local Status = true

ToggleBtn.MouseButton1Click:Connect(function()
    Status = not Status
    Settings.ESPEnabled = Status
    Settings.AimbotEnabled = Status
    ToggleBtn.Text = Status and "HANAMI ON" or "HANAMI OFF"
    ToggleBtn.BackgroundColor3 = Status and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(100, 0, 0)
end)

-- Main Loop ESP
RunService.RenderStepped:Connect(UpdateESP)

print("[Hanami] Crystal System Loaded. Aimbot Active.")
