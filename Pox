-- ══════════════════════════════════
-- ESP DRAWING
-- ══════════════════════════════════
local function newLine(col, thick)
    local l = Drawing.new("Line")
    l.Color = col l.Thickness = thick l.Visible = false return l
end
local function newText(sz, col)
    local t = Drawing.new("Text")
    t.Size = sz t.Color = col t.Outline = true t.Center = true t.Visible = false return t
end

local function createESP(p)
    ESPObjects[p] = {
        box    = {newLine(Config.ESP.BoxColor,1.5), newLine(Config.ESP.BoxColor,1.5),
                  newLine(Config.ESP.BoxColor,1.5), newLine(Config.ESP.BoxColor,1.5)},
        trace  = newLine(Config.ESP.TraceColor, 1),
        name   = newText(13, Config.ESP.NameColor),
        health = newLine(Color3.fromRGB(0,255,0), 3),
        dist   = newText(11, Color3.fromRGB(180,180,255)),
    }
end

local function removeESP(p)
    if not ESPObjects[p] then return end
    local d = ESPObjects[p]
    for _, l in ipairs(d.box) do l:Remove() end
    d.trace:Remove() d.name:Remove() d.health:Remove() d.dist:Remove()
    ESPObjects[p] = nil
end

local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            if not ESPObjects[p] then createESP(p) end
            local d   = ESPObjects[p]
            local box = p.Character and getCharBox(p.Character)
            local hum = p.Character and p.Character:FindFirstChild("Humanoid")
            local hp  = hum and (hum.Health/math.max(hum.MaxHealth,1)) or 0
            local sb  = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)

            if box and Config.ESP.Enabled then
                local x,y,w,h = box.topScreen.X-box.width/2, box.topScreen.Y, box.width, box.height
                d.box[1].From=Vector2.new(x,y)     d.box[1].To=Vector2.new(x+w,y)   d.box[1].Visible=true
                d.box[2].From=Vector2.new(x,y+h)   d.box[2].To=Vector2.new(x+w,y+h) d.box[2].Visible=true
                d.box[3].From=Vector2.new(x,y)     d.box[3].To=Vector2.new(x,y+h)   d.box[3].Visible=true
                d.box[4].From=Vector2.new(x+w,y)   d.box[4].To=Vector2.new(x+w,y+h) d.box[4].Visible=true
                d.trace.From=sb d.trace.To=box.botScreen d.trace.Visible=true
                if Config.ESP.ShowName then
                    d.name.Text=p.DisplayName
                    d.name.Position=Vector2.new(box.topScreen.X,y-16)
                    d.name.Visible=true
                end
                if Config.ESP.ShowHealth then
                    local bh=h*hp
                    d.health.From=Vector2.new(x-5,y+h) d.health.To=Vector2.new(x-5,y+h-bh)
                    d.health.Color=Color3.fromRGB(math.floor(255*(1-hp)),math.floor(255*hp),0)
                    d.health.Visible=true
                end
                if Config.ESP.ShowDistance then
                    d.dist.Text=getDistance(p).."m"
                    d.dist.Position=Vector2.new(box.topScreen.X,box.botScreen.Y+4)
                    d.dist.Visible=true
                end
            else
                for _, l in ipairs(d.box) do l.Visible=false end
                d.trace.Visible=false d.name.Visible=false
                d.health.Visible=false d.dist.Visible=false
            end
        else
            removeESP(p)
        end
    end
end

