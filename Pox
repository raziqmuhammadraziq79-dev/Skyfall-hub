local LastKillTime   = 0

-- ══════════════════════════════════
-- UTILS
-- ══════════════════════════════════
local function isEnemy(player)
    if player == LocalPlayer then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not char:FindFirstChild("HumanoidRootPart") then return false end
    return true
end

local function getScreenPos(worldPos)
    local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(sp.X, sp.Y), onScreen, sp.Z
end

local function getDistance(player)
    local c  = player.Character
    local lc = LocalPlayer.Character
    if not c or not lc then return 0 end
    local a = c:FindFirstChild("HumanoidRootPart")
    local b = lc:FindFirstChild("HumanoidRootPart")
    if not a or not b then return 0 end
    return math.floor((a.Position - b.Position).Magnitude)
end

local function getCharBox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local topS, onScreen = getScreenPos(hrp.Position + Vector3.new(0, 3.5, 0))
    local botS           = getScreenPos(hrp.Position + Vector3.new(0,-3.2, 0))
    if not onScreen then return nil end
    local h = math.abs(topS.Y - botS.Y)
    return { topScreen=topS, botScreen=botS, height=h, width=h*0.55 }
end

-- ══════════════════════════════════
-- FIND GAME REMOTE / KILL BRIDGE
-- Strike Warfare biasanya pake RemoteEvent
-- buat damage, kita scan otomatis
-- ══════════════════════════════════
local KillRemote   = nil
local DamageRemote = nil

local function scanRemotes()
    -- scan seluruh ReplicatedStorage + workspace buat remote damage/kill
    local RS = game:GetService("ReplicatedStorage")
    local keywords = {"damage","kill","hit","shoot","bullet","fire","projectile"}
    local function scanFolder(folder)
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local name = obj.Name:lower()
                for _, kw in ipairs(keywords) do
                    if name:find(kw) then
                        if name:find("kill") then
                            KillRemote = obj
                        else
                            DamageRemote = obj
                        end
                        break
                    end
                end
            end
        end
    end
    pcall(scanRemotes, RS)
    pcall(scanRemotes, workspace)
end

task.spawn(scanRemotes)

-- ══════════════════════════════════
-- AUTO KILL
-- Method 1: langsung set Humanoid.Health = 0
-- Method 2: fire damage remote
-- ══════════════════════════════════
local function tryKill(player)
    if not isEnemy(player) then return end
    local char = player.Character
    local hum  = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    local now = tick()
    if now - LastKillTime < Config.AutoKill.Delay then return end
    LastKillTime = now

    -- Method 1: direct (works on unprotected games)
    if Config.AutoKill.Method == "Humanoid" then
        pcall(function()
            hum.Health = 0
        end)
    end

    -- Method 2: remote event (lebih kompatibel)
    if DamageRemote then
        pcall(function()
            local head = char:FindFirstChild("Head")
            DamageRemote:FireServer(head or char.HumanoidRootPart, 99999)
        end)
    end

    if KillRemote then
        pcall(function()
            KillRemote:FireServer(player, char)
        end)
    end
end

-- ══════════════════════════════════
-- ENEMY CACHE (50ms)
-- ══════════════════════════════════
local function refreshCache()
    local now = tick()
    if now - LastCache < CacheInterval then return end
    LastCache = now
    TargetCache = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if isEnemy(p) then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local sp, onScreen, depth = getScreenPos(head.Position)
                if onScreen and depth > 0 then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    table.insert(TargetCache, {
                        player    = p,
                        screenPos = sp,
                        depth     = depth,
                        worldPos  = head.Position,
                        velocity  = hrp and hrp.Velocity or Vector3.zero,
                    })
                end
            end
        end
    end
    -- sort by screen distance dari center
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    table.sort(TargetCache, function(a, b)
        return (a.screenPos-center).Magnitude < (b.screenPos-center).Magnitude
    end)
end

local function getNearestData()
    return TargetCache[1]
end

-- ══════════════════════════════════
-- AIMBOT
-- ══════════════════════════════════
local function runAimbot()
    if not Config.Aimbot.Enabled then return end
    if Config.Aimbot.RequireHold and not IsHolding then return end

    refreshCache()

    local data = nil
    if Config.Aimbot.AutoLock then
        data = getNearestData()
    end

    if not data then LockedTarget = nil return end
    LockedTarget = data.player

    local targetPart = LockedTarget.Character:FindFirstChild(Config.Aimbot.TargetPart)
    if not targetPart then return end

    local vel      = data.velocity
    local basePos  = targetPart.Position
    local finalPos = Config.Aimbot.Prediction
        and (basePos + vel * Config.Aimbot.PredictionFactor)
        or  basePos

    local cf = Camera.CFrame
    Camera.CFrame = cf:Lerp(CFrame.lookAt(cf.Position, finalPos), Config.Aimbot.Smoothness)
end

-- ══════════════════════════════════
-- SILENT AIM
-- hook __namecall, redirect bullet ke head
-- ══════════════════════════════════
local function initSilentAim()
    if not Config.SilentAim.Enabled then return end
    local ok, mt = pcall(getrawmetatable, game)
    if not ok then return end
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            if LockedTarget and isEnemy(LockedTarget) then
                local head = LockedTarget.Character:FindFirstChild("Head")
                if head then
                    local args = {...}
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then args[i] = head.Position end
                        if typeof(v) == "Instance" and v:IsA("BasePart") then args[i] = head end
                    end
                    return old(self, table.unpack(args))
                end
            end
        end
        return old(self, ...)
    end)
    setreadonly(mt, true)
end

initSilentAim()

-- ══════════════════════════════════
-- NO RECOIL
-- zero recoil via CFrame correction tiap frame
-- ══════════════════════════════════
local LastCF = Camera.CFrame
RunService.RenderStepped:Connect(function()
    if Config.NoRecoil.Enabled then
        local cur = Camera.CFrame
        -- kalau ada vertical kick paksa → counter balik
        local pitchDelta = math.asin(cur.LookVector.Y) - math.asin(LastCF.LookVector.Y)
        if pitchDelta > 0.002 then -- threshold recoil kick
            Camera.CFrame = CFrame.new(cur.Position)
                * CFrame.fromEulerAnglesYXZ(
                    math.asin(LastCF.LookVector.Y),
                    math.atan2(-cur.LookVector.X, -cur.LookVector.Z),
                    0
                )
        end
    end
    LastCF = Camera.CFrame
end)

-- ══════════════════════════════════
-- INFINITE AMMO
-- hook reload function / ammo property
-- ══════════════════════════════════
local function initInfiniteAmmo()
    if not Config.InfiniteAmmo.Enabled then return end
    -- scan backpack + character buat tools/guns
    local function patchTool(tool)
        -- cari attribute ammo
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") then
                local n = v.Name:lower()
                if n:find("ammo") or n:find("bullet") or n:find("mag") then
                    v.Value = 999
                    v.Changed:Connect(function()
                        if v.Value < 30 then v.Value = 999 end
                    end)
                end
            end
            -- RemoteFunction reload → bypass
            if v:IsA("RemoteFunction") and v.Name:lower():find("reload") then
                pcall(function()
                    v.OnClientInvoke = function() return true end
                end)
            end
        end
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    char.ChildAdded:Connect(function(c)
        if c:IsA("Tool") then task.wait(0.1) patchTool(c) end
    end)
    LocalPlayer.Backpack.ChildAdded:Connect(function(c)
        if c:IsA("Tool") then task.wait(0.1) patchTool(c) end
    end)
    for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if t:IsA("Tool") then patchTool(t) end
    end
end

task.spawn(initInfiniteAmmo)

