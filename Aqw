-- ══════════════════════════════════════════
-- UTIL
-- ══════════════════════════════════════════
local function isEnemy(p)
    if CFG.Aimbot.TeamCheck then
        return p.Team ~= LocalPlayer.Team
    end
    return true
end

local function alive(p)
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function getPart(p, part)
    local c = p.Character
    return c and c:FindFirstChild(part)
end

local function toScreen(pos)
    local v, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), on
end

local function center()
    return Camera.ViewportSize / 2
end

local function inFOV(sp)
    return (sp - center()).Magnitude <= CFG.Aimbot.FOV
end

local function findTarget()
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isEnemy(p) and alive(p) then
            local part = getPart(p, CFG.Aimbot.Part)
            if part then
                local sp, on = toScreen(part.Position)
                if on then
                    local d = (sp - center()).Magnitude
                    if d < bestDist and inFOV(sp) then
                        bestDist = d
                        best = p
                    end
                end
            end
        end
    end
    return best
end

-- ══════════════════════════════════════════
-- INFINITE AMMO — hook FireServer
-- intercept semua remote ammo/reload
-- ══════════════════════════════════════════
local rawNamecall
rawNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args   = {...}

    -- SILENT AIM
    if CFG.Aimbot.On and CFG.Aimbot.Silent then
        if method == "FireServer" or method == "InvokeServer" then
            local target = findTarget()
            if target then
                local part = getPart(target, CFG.Aimbot.Part)
                if part then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Instance" and v:IsA("BasePart") then
                            args[i] = part
                        end
                        if typeof(v) == "Vector3" then
                            args[i] = part.Position
                        end
                    end
                end
            end
        end
    end

    -- INFINITE AMMO — block reload remote / spoof ammo arg
    if CFG.Ammo.Infinite then
        if method == "FireServer" then
            local name = self.Name or ""
            -- block semua remote yang namanya mirip reload/ammo
            if name:lower():find("reload") or name:lower():find("ammo") then
                return -- drop the call, no reload
            end
            -- spoof angka ammo di args jadi gede
            for i, v in ipairs(args) do
                if type(v) == "number" and v >= 0 and v <= 500 then
                    args[i] = 9999
                end
            end
        end
    end

    return rawNamecall(self, table.unpack(args))
end)

-- ══════════════════════════════════════════
-- INFINITE AMMO — property hook via __index/__newindex
-- force semua IntValue / NumberValue ammo di tool
-- ══════════════════════════════════════════
local function hookAmmoValues(tool)
    if not tool then return end
    for _, v in ipairs(tool:GetDescendants()) do
        local n = v.Name:lower()
        if (n:find("ammo") or n:find("bullet") or n:find("mag") or n:find("clip"))
        and (v:IsA("IntValue") or v:IsA("NumberValue")) then
            v.Changed:Connect(function(val)
                if val < 9999 then
                    v.Value = 9999
                end
            end)
            v.Value = 9999
        end
    end
end

-- hook tool saat equip
LocalPlayer.CharacterAdded:Connect(function(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            hookAmmoValues(child)
        end
    end)
end)

if LocalPlayer.Character then
    LocalPlayer.Character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            hookAmmoValues(child)
        end
    end)
    for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
        if tool:IsA("Tool") then hookAmmoValues(tool) end
    end
end

-- ══════════════════════════════════════════
-- NO RECOIL + NO SPREAD — __newindex hook Camera CFrame
-- ══════════════════════════════════════════
if CFG.Misc.NoRecoil then
    local lastCF = Camera.CFrame
    RunService.RenderStepped:Connect(function()
        -- lock vertical drift yg disebabkan recoil
        -- hanya reset pitch yang naik tiba2
        local cx, cy, cz = Camera.CFrame:ToEulerAnglesYXZ()
        local lx, ly, lz = lastCF:ToEulerAnglesYXZ()
        local diff = cx - lx
        if diff > 0.005 then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position)
                * CFrame.fromEulerAnglesYXZ(lx, cy, cz)
        end
        lastCF = Camera.CFrame
    end)
end

-- ══════════════════════════════════════════
-- AIMBOT LOOP (non-silent fallback)
-- ══════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    if not CFG.Aimbot.On or CFG.Aimbot.Silent then return end
    local target = findTarget()
    if not target then return end
    local part = getPart(target, CFG.Aimbot.Part)
    if not part then return end
    local sp, on = toScreen(part.Position)
    if not on or not inFOV(sp) then return end
    local delta = sp - center()
    local smoothed = delta * CFG.Aimbot.Smooth
    mousemoverel(smoothed.X, smoothed.Y)
end)

