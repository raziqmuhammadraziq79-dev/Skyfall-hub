-- helper: toggle
local toggleCount = 10
local function toggle(label, tbl, key)
    toggleCount += 1
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(1,0,0,32)
    btn.BackgroundColor3 = tbl[key]
        and Color3.fromRGB(0,160,90)
        or  Color3.fromRGB(45,45,45)
    btn.Text         = label..":  "..(tbl[key] and "ON" or "OFF")
    btn.TextColor3   = Color3.fromRGB(255,255,255)
    btn.Font         = Enum.Font.Gotham
    btn.TextSize     = 12
    btn.LayoutOrder  = toggleCount
    btn.Parent       = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)

    btn.MouseButton1Click:Connect(function()
        tbl[key] = not tbl[key]
        btn.BackgroundColor3 = tbl[key]
            and Color3.fromRGB(0,160,90)
            or  Color3.fromRGB(45,45,45)
        btn.Text = label..":  "..(tbl[key] and "ON" or "OFF")
    end)
end

-- helper: slider
local sliderCount = 50
local function slider(label, tbl, key, mn, mx, isFloat)
    sliderCount += 1
    local sf = Instance.new("Frame")
    sf.Size            = UDim2.new(1,0,0,46)
    sf.BackgroundColor3= Color3.fromRGB(18,18,18)
    sf.LayoutOrder     = sliderCount
    sf.Parent          = frame
    Instance.new("UICorner", sf).CornerRadius = UDim.new(0,6)

    local lbl = Instance.new("TextLabel", sf)
    lbl.Size             = UDim2.new(1,0,0,20)
    lbl.BackgroundTransparency = 1
    lbl.Text             = label..": "..tbl[key]
    lbl.TextColor3       = Color3.fromRGB(200,200,200)
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 11

    local bar = Instance.new("Frame", sf)
    bar.Size             = UDim2.new(0.9,0,0,7)
    bar.Position         = UDim2.new(0.05,0,0,30)
    bar.BackgroundColor3 = Color3.fromRGB(35,35,35)
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0,4)

    local fill = Instance.new("Frame", bar)
    local initRel = (tbl[key] - mn) / (mx - mn)
    fill.Size            = UDim2.new(initRel,0,1,0)
    fill.BackgroundColor3= Color3.fromRGB(0,160,90)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,4)

    local drag = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement
        and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local rel = math.clamp(
            (i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1
        )
        local raw = mn + (mx - mn) * rel
        local val = isFloat and math.floor(raw * 100) / 100 or math.floor(raw)
        tbl[key] = val
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text  = label..": "..val
    end)
end

-- helper: part cycler
local function partCycle(order)
    local opts = {"Head","HumanoidRootPart","UpperTorso","Torso","RightArm","LeftArm"}
    local idx  = 1
    local btn  = Instance.new("TextButton")
    btn.Size             = UDim2.new(1,0,0,32)
    btn.BackgroundColor3 = Color3.fromRGB(40,40,100)
    btn.Text             = "Part: "..CFG.Aimbot.Part
    btn.TextColor3       = Color3.fromRGB(255,255,255)
    btn.Font             = Enum.Font.Gotham
    btn.TextSize         = 12
    btn.LayoutOrder      = order
    btn.Parent           = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
    btn.MouseButton1Click:Connect(function()
        idx = idx % #opts + 1
        CFG.Aimbot.Part = opts[idx]
        btn.Text = "Part: "..CFG.Aimbot.Part
    end)
end

